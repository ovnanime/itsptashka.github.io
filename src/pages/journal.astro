---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('journal'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout
  title="Публикации и журнал — Феофилакт Птахен"
  description="Заметки и новости Феофилакта Птахена: разборы рабочих процессов, материалы о звуке и озвучивании, публикации о проектах и развитии сайта."
  pageType="CollectionPage"
>
  <div class="journal-page">
    <section class="shell journal-shell">
      <header class="journal-head">
        <p class="journal-kicker">Публикации</p>
        <h1>Журнал</h1>
        <p>
          Новости, заметки о проектах и рабочие материалы. Единая лента для
          публикаций, которые не должны теряться в социальных сетях.
        </p>
      </header>

      <div class="journal-list">
        {
          posts.map((post) => (
            <a class="journal-card" href={`/journal/${post.id}/`}>
              <div class="journal-card-poster">
                {post.data.poster ? (
                  <img
                    src={post.data.poster}
                    alt={`Обложка публикации «${post.data.title}»`}
                    width={post.data.posterWidth}
                    height={post.data.posterHeight}
                    loading="lazy"
                    decoding="async"
                    data-no-image-viewer
                  />
                ) : (
                  <span>Постер</span>
                )}
              </div>

              <div class="journal-card-body">
                <div class="journal-card-main">
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                </div>

                <div class="journal-card-meta">
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString('ru-RU')}
                  </time>
                  <b>Читать</b>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </div>

  <style>
    .journal-page {
      padding: 34px 0 52px;
    }

    .journal-page,
    .journal-page * {
      font-family: Roboto, Arial, sans-serif;
    }
.journal-head {
      width: 100%;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--line);
    }

    .journal-kicker {
      margin: 0 0 14px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .journal-head h1 {
      max-width: 720px;
      margin: 0;
      color: #fff;
      font-size: 36px;
      line-height: 1.08;
      font-weight: 900;
      letter-spacing: -0.045em;
    }

    .journal-head p {
      max-width: 650px;
      margin: 14px 0 0;
      color: var(--muted);
      font-size: 18px;
      line-height: 1.5;
      font-weight: 500;
    }

    .journal-list {
      display: grid;
      gap: 14px;
      width: 100%;
      max-width: none;
      margin-top: 26px;
    }

    .journal-card {
      display: grid;
      grid-template-columns: 430px minmax(0, 1fr);
      gap: 22px;
      align-items: stretch;
      min-height: 204px;
      width: 100%;
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 15px;
      background:
        radial-gradient(circle at 100% 0%, rgba(255,255,255,0.04), transparent 38%),
        #101010;
      color: inherit;
      text-decoration: none;
      overflow: hidden;
      transition: border-color 0.16s ease, background 0.16s ease;
    }

    .journal-card:hover {
      border-color: rgba(255, 255, 255, 0.22);
      background:
        radial-gradient(circle at 100% 0%, rgba(255,255,255,0.06), transparent 38%),
        #121212;
    }

    .journal-card-poster {
      position: relative;
      overflow: hidden;
      min-height: 176px;
      aspect-ratio: 16 / 9;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      background:
        radial-gradient(circle at 72% 24%, rgba(255,255,255,0.08), transparent 38%),
        #0d0d0d;
    }

    .journal-card-poster::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(to top, rgba(0,0,0,0.34), rgba(0,0,0,0.02) 52%),
        rgba(0, 0, 0, 0.18);
      pointer-events: none;
    }

    .journal-card-poster img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(1) brightness(0.72);
      transform: none !important;
      transition: opacity 0.18s ease;
    }

    .journal-card:hover .journal-card-poster img {
      opacity: 0.82;
      transform: none !important;
    }

    .journal-card-poster span {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      color: rgba(255,255,255,0.38);
      font-size: 18px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: -0.03em;
    }

    .journal-card-body {
      display: grid;
      grid-template-rows: 1fr auto;
      gap: 14px;
      min-width: 0;
      padding: 4px 2px 2px 0;
    }

    .journal-card-main {
      min-width: 0;
      align-self: center;
    }

    .journal-card h2 {
      max-width: 520px;
      margin: 0 0 9px;
      color: #fff;
      font-size: 24px;
      line-height: 1.14;
      font-weight: 900;
      letter-spacing: -0.035em;
    }

    .journal-card p {
      max-width: 560px;
      margin: 0;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.45;
      font-weight: 500;
    }

    .journal-card-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding-top: 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      color: var(--muted);
    }

    .journal-card-meta time {
      color: #b8c0c8;
      font-size: 13px;
      line-height: 1;
      font-weight: 850;
    }

    .journal-card-meta b {
      display: inline-flex;
      height: 32px;
      align-items: center;
      justify-content: center;
      padding: 0 13px;
      border: 1px solid rgba(255, 255, 255, 0.13);
      border-radius: 999px;
      color: #fff;
      font-size: 12px;
      line-height: 1;
      font-weight: 900;
    }

    .journal-card:hover .journal-card-meta b {
      background: #fff;
      color: #050505;
      border-color: #fff;
    }

    @media (max-width: 900px) {
      .journal-card {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .journal-card-poster {
        min-height: 0;
      }

      .journal-card-body {
        padding: 0;
      }

      .journal-card h2,
      .journal-card p {
        max-width: none;
      }
    }

    @media (max-width: 760px) {
      .journal-page {
        padding-top: 30px;
      }

      .journal-list {
        gap: 14px;
      }

      .journal-card {
        padding: 14px;
      }

      .journal-card h2 {
        font-size: 23px;
      }

      .journal-card p {
        font-size: 16px;
      }

      .journal-card-meta {
        align-items: flex-start;
        flex-direction: column;
      }
    }

    /* Journal hero only — exact shared page typography */
    .journal-page {
      padding-top: 34px !important;
    }

    .journal-head {
      width: 100% !important;
      max-width: none !important;
      padding-bottom: 24px !important;
      border-bottom: 1px solid var(--line) !important;
    }

    .journal-kicker {
      margin: 0 0 14px !important;
      color: var(--muted) !important;
      font-family: Roboto, Arial, sans-serif !important;
      font-size: 14px !important;
      line-height: 1.2 !important;
      font-weight: 800 !important;
      letter-spacing: 0.18em !important;
      text-transform: uppercase !important;
    }

    .journal-head h1 {
      margin: 0 !important;
      color: #fff !important;
      font-family: Roboto, Arial, sans-serif !important;
      font-size: 36px !important;
      line-height: 1.08 !important;
      font-weight: 900 !important;
      letter-spacing: -0.045em !important;
    }

    .journal-head > p:last-child {
      max-width: 720px !important;
      margin: 14px 0 0 !important;
      color: var(--muted) !important;
      font-family: Roboto, Arial, sans-serif !important;
      font-size: 18px !important;
      line-height: 1.5 !important;
      font-weight: 500 !important;
      letter-spacing: 0 !important;
    }

    @media (max-width: 760px) {
      .journal-page {
        padding-top: 30px !important;
      }

      .journal-head h1 {
        font-size: 34px !important;
      }
    }

  </style>
</BaseLayout>
