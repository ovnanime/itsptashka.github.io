---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const latestJournalPosts = (await getCollection('journal'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const journalPlaceholderCount = Math.max(0, 3 - latestJournalPosts.length);
const journalPlaceholders = Array.from({ length: journalPlaceholderCount });

---

<BaseLayout title="Феофилакт Птахен — актёр озвучивания и звукорежиссёр">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Актёр озвучивания · звукорежиссёр</p>

      <h1>
        От записи до финального микса.
        <br />
      </h1>
      <h1 style="font-size: clamp(28px, 3vw, 34px);">
        <em>Технические стандарты и реальный опыт.</em>
      </h1>

      <p class="lead">
        Занимаюсь озвучиванием, локализацией, саунд-дизайном и перезаписью.
        Мой подход построен на чистой практике и реальных проектах.
      </p>

      <div class="hero-visual hero-visual--mobile" aria-hidden="true">
        <div class="portrait-frame">
          <img
            src="/assets/images/avatar_ptaxen.webp"
            alt=""
            width="1308"
            height="1086"
            loading="eager"
            decoding="async"
          />
          <span class="portrait-caption">
            Илья Пушкин<br />
            псевд. Феофилакт Птахен
          </span>
        </div>

        <div class="vertical-note">Актёр озвучивания / Звукорежиссёр / Писатель</div>
      </div>

      <div class="hero-actions">
        <button class="button light" type="button" data-scroll-to="voice">Слушать голос</button>
        <a class="button ghost" href="/works">Портфолио</a>
      </div>

      <div class="hero-facts">
        <span><b>3+</b>года практики</span>
        <span><b>50+</b>проектов</span>
        <span><b>2+</b>направлений</span>
      </div>
    </div>

    <div class="hero-visual hero-visual--desktop">
      <div class="portrait-frame">
        <img
          src="/assets/images/avatar_ptaxen.webp"
          alt="Феофилакт Птахен"
          width="1308"
          height="1086"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <span class="portrait-caption">
          Илья Пушкин<br />
          псевд. Феофилакт Птахен
        </span>
      </div>

      <div class="vertical-note">Актёр озвучивания / Звукорежиссёр / Писатель</div>
    </div>
  </section>

    <section id="voice" class="voice-strip">
    <div class="shell voice-inner">
      <div>
        <p class="eyebrow">Голос</p>
        <h2>RAW / STUDIO</h2>
        <p>
          Одна запись — два состояния. Сравните исходник и обработанный
          материал без смены фрагмента.
        </p>
      </div>

      <div class="player audio-compare-player" data-active="raw">
        <button id="play" class="player-play" type="button" aria-label="Воспроизвести">
          <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5v14l11-7L8 5Z"></path>
          </svg>
          <svg class="pause-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5h3v14H8V5Z"></path>
            <path d="M13 5h3v14h-3V5Z"></path>
          </svg>
        </button>

        <div class="wave-wrap">
          <button class="wave" id="wave-seek" type="button" aria-label="Перемотать аудио">
            {
              Array.from({ length: 74 }).map((_, index) => (
                <i style={`height:${18 + ((index * 17) % 35)}%`}></i>
              ))
            }
          </button>
        </div>

        <div class="time-row" aria-live="polite">
          <span id="time-current">0:00</span>
          <span id="time-duration">0:00</span>
        </div>

        <div class="switch audio-mode-switch">
          <button type="button" data-mode="raw" class="active">RAW</button>
          <button type="button" data-mode="studio">STUDIO</button>
        </div>

        <audio id="demo-raw" preload="auto" src="/assets/audio/voice_demo_raw.flac"></audio>
        <audio id="demo-studio" preload="auto" src="/assets/audio/voice_demo_studio.flac"></audio>
      </div>
    </div>
  </section>

  <section id="journal" class="shell section">
    <div class="section-head section-head--compact">
      <div>
        <p class="eyebrow">Блог</p>
        <h2>Заметки и новости</h2>
        <a class="section-more-link" href="/journal">Просмотреть все публикации →</a>
      </div>
    </div>

    <div class="coming-grid">
      {
        latestJournalPosts.map((post) => (
          <a class="coming-card coming-card--news" href={`/journal/${post.slug}`}>
            <div class="coming-banner coming-banner--news">
              {post.data.poster && (
                <img
                  src={post.data.poster}
                  alt=""
                  loading="lazy"
                />
              )}
            </div>
            <div class="coming-meta">
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
          </a>
        ))
      }

      {
        journalPlaceholders.map(() => (
          <article class="coming-card coming-card--placeholder" aria-hidden="true">
            <div class="coming-banner">Скоро...</div>
            <div class="coming-meta">
              <h3>Скоро...</h3>
              <p>Скоро...</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="manifesto">
    <div class="shell manifesto-grid">
      <p class="eyebrow">Подход</p>

      <blockquote>
        «Лучшая озвучка та,
        которую зритель даже не заметил».
      </blockquote>

      <div>
        <p>
          Медицинская база заменяет мне актерскую игру — 
          я добиваюсь нужного звука за счет правильной работы мышц. 
          А опыт звукорежиссера позволяет свести этот исходник так, 
          чтобы голос стал абсолютно естественной частью видеоряда.
        </p>
        <a class="text-link" href="/approach">
          Как я строю персонажа ↗
        </a>
      </div>
    </div>
  </section>

  <section class="shell section split-callout">
    <div>
      <p class="eyebrow">Два ремесла</p>
      <h2>
        В кадре — актёр.<br />
        За кадром — звукорежиссёр.
      </h2>
    </div>

    <div class="discipline-list">
      <a href="/works">
        <span>01</span>
        <b>Озвучивание</b>
        <p>Дикторская начитка, закадровый перевод, рекаст, дубляж.</p>
      </a>

      <a href="/works">
        <span>02</span>
        <b>Звукорежиссура</b>
        <p>Чистка записи, саунд-дизайн, сведение дубляжа, липсинка и закадра.</p>
      </a>

      <a href="/journal">
        <span>03</span>
        <b>Авторство</b>
        <p>Песни, рассказы, статьи, блоги.</p>
      </a>
    </div>
  </section>

  <script is:inline>
    const rawAudio = document.querySelector('#demo-raw');
    const studioAudio = document.querySelector('#demo-studio');
    const playButton = document.querySelector('#play');
    const modeButtons = document.querySelectorAll('.audio-mode-switch button');
    const player = document.querySelector('.audio-compare-player');
    const waveSeek = document.querySelector('#wave-seek');
    const bars = document.querySelectorAll('#wave-seek i');
    const timeCurrent = document.querySelector('#time-current');
    const timeDuration = document.querySelector('#time-duration');

    let activeMode = 'raw';
    let activeAudio = rawAudio;

    const formatTime = (seconds) => {
      if (!Number.isFinite(seconds)) {
        return '0:00';
      }

      const minutes = Math.floor(seconds / 60);
      const rest = Math.floor(seconds % 60).toString().padStart(2, '0');

      return `${minutes}:${rest}`;
    };

    const paintBars = () => {
      if (!activeAudio || !activeAudio.duration) {
        return;
      }

      const progress = activeAudio.currentTime / activeAudio.duration;

      bars.forEach((bar, index) => {
        const barProgress = index / Math.max(1, bars.length - 1);
        bar.classList.toggle('played', barProgress <= progress);
      });

      if (timeCurrent) {
        timeCurrent.textContent = formatTime(activeAudio.currentTime);
      }

      if (timeDuration) {
        timeDuration.textContent = formatTime(activeAudio.duration);
      }
    };

    const setPlayingState = (isPlaying) => {
      playButton?.classList.toggle('is-playing', isPlaying);
    };

    const syncInactiveAudio = () => {
      const inactiveAudio = activeMode === 'raw' ? studioAudio : rawAudio;

      if (inactiveAudio && activeAudio) {
        inactiveAudio.currentTime = activeAudio.currentTime;
      }
    };

    const switchMode = async (nextMode) => {
      if (nextMode === activeMode) {
        return;
      }

      const wasPlaying = !activeAudio.paused;
      const currentTime = activeAudio.currentTime;

      activeAudio.pause();

      activeMode = nextMode;
      activeAudio = nextMode === 'raw' ? rawAudio : studioAudio;

      activeAudio.currentTime = Math.min(currentTime, activeAudio.duration || currentTime);

      player?.setAttribute('data-active', nextMode);

      modeButtons.forEach((button) => {
        button.classList.toggle('active', button.dataset.mode === nextMode);
      });

      paintBars();

      if (wasPlaying) {
        await activeAudio.play();
        setPlayingState(true);
      }
    };

    [rawAudio, studioAudio].forEach((audio) => {
      audio?.addEventListener('loadedmetadata', paintBars);

      audio?.addEventListener('timeupdate', () => {
        if (audio === activeAudio) {
          paintBars();
          syncInactiveAudio();
        }
      });

      audio?.addEventListener('ended', () => {
        if (audio === activeAudio) {
          setPlayingState(false);
          paintBars();
        }
      });
    });

    playButton?.addEventListener('click', async () => {
      if (activeAudio.paused) {
        await activeAudio.play();
        setPlayingState(true);
      } else {
        activeAudio.pause();
        setPlayingState(false);
      }
    });

    modeButtons.forEach((button) => {
      button.addEventListener('click', () => switchMode(button.dataset.mode));
    });

    waveSeek?.addEventListener('click', (event) => {
      if (!activeAudio.duration) {
        return;
      }

      const rect = waveSeek.getBoundingClientRect();
      const ratio = (event.clientX - rect.left) / rect.width;
      const nextTime = Math.min(1, Math.max(0, ratio)) * activeAudio.duration;

      rawAudio.currentTime = nextTime;
      studioAudio.currentTime = nextTime;
      paintBars();
    });
  </script>

  <style>
    .coming-card--news {
      color: inherit;
      text-decoration: none;
    }

    .coming-banner--news {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      flex-direction: column;
      gap: 18px;
      padding: 22px;
      box-sizing: border-box;
      background:
        radial-gradient(circle at 100% 0%, rgba(255,255,255,0.08), transparent 42%),
        #101010;
      transition:
        border-color 0.16s ease,
        background 0.16s ease,
        transform 0.16s ease;
    }

    .coming-banner--news span {
      display: inline-flex;
      align-items: center;
      height: 26px;
      padding: 0 9px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 8px;
      color: #dcdcdc;
      font-size: 12px;
      line-height: 1;
      font-weight: 800;
    }

    .coming-banner--news b {
      max-width: 260px;
      color: #fff;
      font-size: 30px;
      line-height: 1.02;
      font-weight: 900;
      letter-spacing: -0.045em;
    }

    .coming-card--news:hover .coming-banner--news {
      border-color: rgba(255, 255, 255, 0.24);
      background:
        radial-gradient(circle at 100% 0%, rgba(255,255,255,0.12), transparent 42%),
        #121212;
      transform: none;
    }

    .coming-card--news:hover .coming-meta h3 {
      color: #fff;
    }

    @media (max-width: 980px) {
      .coming-banner--news b {
        font-size: 28px;
      }
    }

    .coming-banner--news {
      position: relative;
      overflow: hidden;
      isolation: isolate;
    }

    .coming-banner--news img {
      position: absolute;
      inset: 0;
      z-index: -2;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(1) contrast(1.05);
      opacity: 0.48;
      transition: opacity 0.18s ease;
    }

    .coming-banner--news::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(circle at 68% 28%, rgba(255,255,255,0.10), transparent 34%),
        linear-gradient(180deg, rgba(0,0,0,0.18), rgba(0,0,0,0.78));
      pointer-events: none;
    }

    .coming-card--news:hover .coming-banner--news img {
      opacity: 0.62;
    }


    /* News preview: no zoom / no movement on hover */
    .coming-card--news,
    .coming-card--news:hover,
    .coming-card--news .coming-banner--news,
    .coming-card--news:hover .coming-banner--news,
    .coming-card--news .coming-banner--news img,
    .coming-card--news:hover .coming-banner--news img {
      transform: none !important;
    }

    .coming-banner--news img {
      transition: opacity 0.18s ease !important;
    }


    /* News preview image only: text lives below the poster */
    .coming-banner--news > span,
    .coming-banner--news > b {
      display: none !important;
    }

    .coming-banner--news,
    .coming-banner--news:hover,
    .coming-banner--news img,
    .coming-banner--news:hover img,
    .coming-card--news,
    .coming-card--news:hover {
      transform: none !important;
    }

    .coming-banner--news img {
      transition: opacity 0.18s ease !important;
    }


    /* Home journal block: automatic MDX posts */
    .section-more-link {
      display: inline-flex;
      margin-left: auto;
      color: var(--muted);
      font-family: Roboto, Arial, sans-serif;
      font-size: 14px;
      line-height: 1;
      font-weight: 800;
      text-decoration: none;
      white-space: nowrap;
    }

    .section-more-link:hover {
      color: #fff;
    }

    .coming-banner--news {
      min-height: 190px;
      background:
        radial-gradient(circle at 70% 24%, rgba(255,255,255,0.08), transparent 36%),
        #101010;
    }

    .coming-banner--news:not(:has(img))::before {
      content: "Постер";
      color: rgba(255,255,255,0.34);
      font-size: 18px;
      font-weight: 900;
      letter-spacing: -0.03em;
    }

    .coming-card--news,
    .coming-card--news:hover,
    .coming-banner--news,
    .coming-banner--news:hover,
    .coming-banner--news img,
    .coming-banner--news:hover img {
      transform: none !important;
    }

    .coming-banner--news img {
      transition: opacity 0.18s ease !important;
    }

    @media (max-width: 760px) {
      .section-more-link {
        margin-left: 0;
        margin-top: 12px;
      }
    }


    /* Home journal placeholders: keep three-card layout until MDX posts fill it */
    .coming-card--placeholder {
      pointer-events: none;
      opacity: 0.72;
    }

    .coming-card--placeholder .coming-banner {
      color: #8f8f8f;
    }


    /* Home journal posters: fixed 16:9 ratio */
    .coming-card .coming-banner,
    .coming-banner--news {
      width: 100% !important;
      aspect-ratio: 16 / 9 !important;
      min-height: 0 !important;
      height: auto !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      box-sizing: border-box !important;
    }

    .coming-banner--news img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      transform: none !important;
    }

    .coming-card--placeholder .coming-banner {
      font-size: 20px !important;
      line-height: 1 !important;
      font-weight: 700 !important;
    }

    .coming-card,
    .coming-card:hover,
    .coming-card .coming-banner,
    .coming-card:hover .coming-banner,
    .coming-card .coming-banner img,
    .coming-card:hover .coming-banner img {
      transform: none !important;
    }

  </style>


  <script is:inline>
    document.querySelector('[data-scroll-to="voice"]')?.addEventListener('click', () => {
      const target = document.getElementById('voice');
      if (!target) return;

      target.scrollIntoView({
        block: 'start',
        inline: 'nearest',
        behavior: 'auto'
      });
    });
  </script>

</BaseLayout>
