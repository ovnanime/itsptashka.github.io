  <script is:inline>
    (() => {
      const initAuthorSearch = () => {
        const authorList = document.querySelector('[data-author-list]');
        const authorRows = [...document.querySelectorAll('.author-row')];
        const authorSearch = document.querySelector('[data-author-search]');
        const authorSearchButton = document.querySelector('[data-author-search-button]');
        const authorType = document.querySelector('[data-author-type]');
        const authorSort = document.querySelector('[data-author-sort]');
        const authorEmpty = document.querySelector('[data-author-empty]');

        if (!authorList || !authorRows.length) return;

        const normalize = (value) =>
          String(value || '')
            .toLowerCase()
            .replace(/ё/g, 'е')
            .trim();

        const updateAuthorList = () => {
          const query = normalize(authorSearch?.value);
          const type = authorType?.value || 'all';
          const sort = authorSort?.value || 'new';

          const sortedRows = [...authorRows].sort((a, b) => {
            const titleA = normalize(a.dataset.title);
            const titleB = normalize(b.dataset.title);

            if (sort === 'az') return titleA.localeCompare(titleB, 'ru');
            if (sort === 'za') return titleB.localeCompare(titleA, 'ru');
            if (sort === 'old') return new Date(a.dataset.date) - new Date(b.dataset.date);

            return new Date(b.dataset.date) - new Date(a.dataset.date);
          });

          sortedRows.forEach((row) => authorList.appendChild(row));

          let visibleCount = 0;

          authorRows.forEach((row) => {
            const searchText = normalize(row.dataset.search);
            const rowType = row.dataset.type;
            const matchesQuery = !query || searchText.includes(query);
            const matchesType = type === 'all' || rowType === type;
            const visible = matchesQuery && matchesType;

            row.classList.toggle('is-hidden', !visible);

            if (visible) visibleCount += 1;
          });

          if (authorEmpty) {
            authorEmpty.hidden = visibleCount !== 0;
          }
        };

        authorSearch?.addEventListener('input', updateAuthorList);
        authorSearch?.addEventListener('search', updateAuthorList);
        authorSearchButton?.addEventListener('click', updateAuthorList);
        authorType?.addEventListener('change', updateAuthorList);
        authorSort?.addEventListener('change', updateAuthorList);

        updateAuthorList();
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAuthorSearch);
      } else {
        initAuthorSearch();
      }
    })();
  </script>


  <script is:inline>
    (() => {
      const overlay = document.querySelector('[data-demo-player]');
      if (overlay && overlay.parentElement !== document.body) {
        document.body.appendChild(overlay);
      }

      const shell = overlay?.querySelector('.demo-player-shell');
      const video = overlay?.querySelector('[data-demo-player-video]');
      const title = overlay?.querySelector('[data-demo-player-title]');
      const subtitle = overlay?.querySelector('[data-demo-player-subtitle]');
      const currentTime = overlay?.querySelector('[data-demo-current]');
      const durationTime = overlay?.querySelector('[data-demo-duration]');
      const progress = overlay?.querySelector('[data-demo-progress]');
      const volume = overlay?.querySelector('[data-demo-volume]');
      const settingsPanel = overlay?.querySelector('[data-demo-settings-panel]');
      const openButtons = document.querySelectorAll('[data-demo-video]');

      if (!overlay || !shell || !video) return;

      const formatTime = (seconds) => {
        if (!Number.isFinite(seconds)) return '0:00';

        const total = Math.max(0, Math.floor(seconds));
        const minutes = Math.floor(total / 60);
        const rest = String(total % 60).padStart(2, '0');

        return `${minutes}:${rest}`;
      };

      const updatePlayingState = () => {
        shell.classList.toggle('is-playing', !video.paused && !video.ended);
        shell.classList.toggle('is-paused', video.paused || video.ended);
      };

      const updateProgress = () => {
        if (progress && video.duration) {
          progress.value = String((video.currentTime / video.duration) * 1000);
        }

        if (currentTime) currentTime.textContent = formatTime(video.currentTime);
        if (durationTime) durationTime.textContent = formatTime(video.duration);
      };

      const openPlayer = (button) => {
        const src = button.dataset.demoVideo;
        if (!src) return;

        video.src = src;
        video.currentTime = 0;
        video.playbackRate = 1;

        if (title) title.textContent = button.dataset.demoTitle || 'Демо';
        if (subtitle) subtitle.textContent = button.dataset.demoText || 'Фрагмент работы';

        overlay.hidden = false;
        overlay.setAttribute('aria-hidden', 'false');
        document.body.classList.add('demo-player-open');
        document.documentElement.classList.add('demo-player-open-root');
        settingsPanel?.setAttribute('hidden', '');

        updatePlayingState();
        video.play().catch(() => updatePlayingState());
      };

      const closePlayer = async () => {
        video.pause();

        if (document.fullscreenElement) {
          try {
            await document.exitFullscreen();
          } catch {}
        }

        overlay.hidden = true;
        overlay.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('demo-player-open');
        document.documentElement.classList.remove('demo-player-open-root');
        settingsPanel?.setAttribute('hidden', '');
      };

      const togglePlay = () => {
        if (video.paused || video.ended) {
          video.play().catch(() => updatePlayingState());
        } else {
          video.pause();
        }
      };

      openButtons.forEach((button) => {
        button.addEventListener('click', () => openPlayer(button));
      });

      overlay.querySelectorAll('[data-demo-close]').forEach((button) => {
        button.addEventListener('click', closePlayer);
      });

      overlay.querySelectorAll('[data-demo-toggle]').forEach((button) => {
        button.addEventListener('click', togglePlay);
      });

      overlay.querySelectorAll('[data-demo-seek]').forEach((button) => {
        button.addEventListener('click', () => {
          video.currentTime = Math.min(
            Math.max(0, video.currentTime + Number(button.dataset.demoSeek || 0)),
            video.duration || video.currentTime
          );
        });
      });

      overlay.querySelector('[data-demo-mute]')?.addEventListener('click', () => {
        video.muted = !video.muted;
      });

      overlay.querySelector('[data-demo-settings]')?.addEventListener('click', () => {
        if (!settingsPanel) return;
        settingsPanel.hidden = !settingsPanel.hidden;
      });

      overlay.querySelectorAll('[data-demo-speed]').forEach((button) => {
        button.addEventListener('click', () => {
          const speed = Number(button.dataset.demoSpeed || 1);
          video.playbackRate = speed;

          overlay.querySelectorAll('[data-demo-speed]').forEach((item) => {
            item.classList.toggle('active', item === button);
          });

          settingsPanel?.setAttribute('hidden', '');
        });
      });

      overlay.querySelector('[data-demo-pip]')?.addEventListener('click', async () => {
        if (!document.pictureInPictureEnabled || !video.requestPictureInPicture) return;

        try {
          if (document.pictureInPictureElement) {
            await document.exitPictureInPicture();
          } else {
            await video.requestPictureInPicture();
          }
        } catch {}
      });

      overlay.querySelector('[data-demo-fullscreen]')?.addEventListener('click', async () => {
        try {
          if (document.fullscreenElement) {
            await document.exitFullscreen();
          } else {
            await shell.requestFullscreen();
          }
        } catch {}
      });

      document.addEventListener('fullscreenchange', () => {
        if (overlay.hidden) return;
        updatePlayingState();
      });

      progress?.addEventListener('input', () => {
        if (!video.duration) return;
        video.currentTime = (Number(progress.value) / 1000) * video.duration;
      });

      volume?.addEventListener('input', () => {
        video.volume = Number(volume.value);
        video.muted = video.volume === 0;
      });

      video.addEventListener('click', togglePlay);
      video.addEventListener('loadedmetadata', updateProgress);
      video.addEventListener('timeupdate', updateProgress);
      video.addEventListener('play', updatePlayingState);
      video.addEventListener('pause', updatePlayingState);
      video.addEventListener('ended', updatePlayingState);

      overlay.addEventListener('click', (event) => {
        if (event.target === overlay) closePlayer();
      });

      document.addEventListener('keydown', (event) => {
        if (overlay.hidden) return;

        if (event.key === 'Escape') closePlayer();
        if (event.key === ' ') {
          event.preventDefault();
          togglePlay();
        }
        if (event.key === 'ArrowLeft') video.currentTime = Math.max(0, video.currentTime - 10);
        if (event.key === 'ArrowRight') video.currentTime = Math.min(video.duration || video.currentTime, video.currentTime + 10);
      });

      updatePlayingState();
      updateProgress();
    })();
  
    (() => {
      const overlaySelectors = [
        '.video-modal',
        '.demo-modal',
        '.video-overlay',
        '.demo-video-modal',
        '.video-fullscreen',
        '[data-video-modal]',
        '[data-demo-modal]'
      ];

      const overlays = overlaySelectors
        .flatMap((selector) => Array.from(document.querySelectorAll(selector)))
        .filter(Boolean);

      if (!overlays.length) return;

      const findVideo = (overlay) => overlay.querySelector('video') || document.querySelector('video');
      const findDownload = (overlay) => overlay.querySelector('[data-video-download]') || document.querySelector('[data-video-download]');

      const syncDownload = (overlay) => {
        const video = findVideo(overlay);
        const download = findDownload(overlay);

        if (!video || !download) return;

        const src = video.currentSrc || video.src || video.querySelector('source')?.src;

        if (!src) return;

        download.setAttribute('href', src);

        try {
          const url = new URL(src, window.location.href);
          const filename = url.pathname.split('/').filter(Boolean).pop() || 'video';
          download.setAttribute('download', filename);
        } catch {
          download.setAttribute('download', 'video');
        }
      };

      overlays.forEach((overlay) => {
        let hideTimer = null;

        const showControls = () => {
          overlay.classList.remove('video-controls-hidden');
          window.clearTimeout(hideTimer);

          hideTimer = window.setTimeout(() => {
            const video = findVideo(overlay);
            const isPlaying = video && !video.paused && !video.ended;

            if (isPlaying) {
              overlay.classList.add('video-controls-hidden');
            }
          }, 2200);
        };

        ['mousemove', 'pointermove', 'touchstart', 'click'].forEach((eventName) => {
          overlay.addEventListener(eventName, showControls, { passive: true });
        });

        overlay.addEventListener('mouseenter', showControls);
        overlay.addEventListener('mouseleave', () => {
          const video = findVideo(overlay);

          if (video && !video.paused && !video.ended) {
            overlay.classList.add('video-controls-hidden');
          }
        });

        const video = findVideo(overlay);

        if (video) {
          video.addEventListener('play', showControls);
          video.addEventListener('pause', () => overlay.classList.remove('video-controls-hidden'));
          video.addEventListener('ended', () => overlay.classList.remove('video-controls-hidden'));
          video.addEventListener('loadedmetadata', () => syncDownload(overlay));
        }

        syncDownload(overlay);
        showControls();
      });
    })();

  
    (() => {
      const getVideoSource = (button) => {
        const overlay = button.closest('.video-modal, .demo-modal, .video-overlay, .demo-video-modal, .video-fullscreen, [data-video-modal], [data-demo-modal]');
        const video = overlay?.querySelector('video') || document.querySelector('video');
        const src = video?.currentSrc || video?.src || video?.querySelector('source')?.src || button.href;

        return src;
      };

      const updateDownloadButton = (button) => {
        const src = getVideoSource(button);

        if (!src || src === '#') return;

        button.href = src;

        try {
          const url = new URL(src, window.location.href);
          const filename = url.pathname.split('/').filter(Boolean).pop() || 'video';
          button.setAttribute('download', filename);
        } catch {
          button.setAttribute('download', 'video');
        }
      };

      document.addEventListener('pointerdown', (event) => {
        const button = event.target?.closest?.('[data-video-download]');

        if (!button) return;

        event.stopPropagation();
        updateDownloadButton(button);
      }, true);

      document.addEventListener('mousedown', (event) => {
        const button = event.target?.closest?.('[data-video-download]');

        if (!button) return;

        event.stopPropagation();
        updateDownloadButton(button);
      }, true);

      document.addEventListener('click', (event) => {
        const button = event.target?.closest?.('[data-video-download]');

        if (!button) return;

        event.stopPropagation();
        updateDownloadButton(button);
      }, true);
    })();

  </script>

</BaseLayout>
