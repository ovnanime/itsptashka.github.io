---
interface Props {
  partner?: 'tvoe' | 'deep';
}

const badges = {
  tvoe: {
    name: 'TVOË',
    label: 'Специально для онлайн-кинотеатра TVOË',
  },
  deep: {
    name: 'DEEP',
    label: 'Специально для DEEP',
  },
} as const;

const { partner } = Astro.props;
const badge = partner ? badges[partner] : undefined;
---

{
  badge && (
    <span
      class:list={['partner-badge', `partner-badge--${partner}`]}
      title={badge.label}
      aria-label={badge.label}
      data-partner-badge={partner}
    >
      <strong>{badge.name}</strong>
    </span>
  )
}

<style>
  .partner-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 6;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 5px 10px 6px;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 8px;
    pointer-events: none;
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.52),
      inset 0 0 0 1px rgba(255, 255, 255, 0.18);
    font-family: Roboto, Arial, sans-serif;
    line-height: 1;
    text-transform: uppercase;
  }

  .partner-badge strong {
    font-size: 16px;
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  .partner-badge--tvoe {
    color: #16210a;
    border-color: #b8cf7d;
    background: linear-gradient(135deg, #b3cd75 0%, #93b352 54%, #74933a 100%);
    box-shadow:
      0 8px 24px rgba(129, 160, 66, 0.32),
      0 0 0 1px rgba(184, 207, 125, 0.26);
  }

  .partner-badge--deep {
    color: #fff;
    border-color: #f3b5ff;
    background: linear-gradient(135deg, #151020 0%, #6f2cff 52%, #e143ff 100%);
    box-shadow:
      0 8px 24px rgba(168, 58, 255, 0.38),
      0 0 0 1px rgba(244, 181, 255, 0.25);
  }

  @media (max-width: 720px) {
    .partner-badge {
      top: 5px;
      left: 5px;
      padding: 4px 7px 5px;
      border-radius: 6px;
    }

    .partner-badge strong {
      font-size: 12px;
    }
  }
</style>
