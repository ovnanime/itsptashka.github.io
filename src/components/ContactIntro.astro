---
/**
 * Интро страницы контактов: кнопка «Связаться» спит на полке, после двух
 * толчков падает на линию над футером, встаёт, идёт по ней к левому краю и
 * утягивает за собой ширму, открывая сайт.
 *
 * Сцена — прогрессивное улучшение. Разметка ниже помечена hidden и включается
 * только скриптом, поэтому без JS, при prefers-reduced-motion и у вернувшегося
 * посетителя страница остаётся обычной страницей контактов.
 */
---

{/* Решение принимается синхронно, до первой отрисовки. */}
<script is:inline data-astro-rerun>
  (() => {
    const root = document.documentElement;
    root.removeAttribute('data-contact-intro');

    if (!window.matchMedia || matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    try {
      if (localStorage.getItem('ptahen-contact-intro-seen') === '1') return;
    } catch {
      // Приватный режим: localStorage недоступен, просто играем интро.
    }

    root.setAttribute('data-contact-intro', 'pending');
  })();
</script>

<div class="ci-stage" data-ci-stage hidden>
  <div class="ci-curtain" data-ci-curtain aria-hidden="true">
    <span class="ci-shelf"></span>
  </div>

  {/* Линия пола совпадает с верхней границей футера: по ней кнопка и ходит. */}
  <span class="ci-floorline" aria-hidden="true"></span>
  <span class="ci-shadow" aria-hidden="true"></span>

  <div class="ci-actor" data-ci-actor>
    <p class="ci-bubble" data-ci-bubble aria-hidden="true"></p>

    <button class="ci-btn" type="button" data-ci-wake>
      <span class="ci-label" data-ci-label>Связаться</span>
      <span class="ci-face" aria-hidden="true"><i></i><i></i></span>
    </button>

    <span class="ci-sleep" aria-hidden="true">z<b>z</b></span>

    <span class="ci-arm ci-arm--l" aria-hidden="true"></span>
    <span class="ci-arm ci-arm--r" aria-hidden="true"></span>
    <span class="ci-leg ci-leg--l" aria-hidden="true"></span>
    <span class="ci-leg ci-leg--r" aria-hidden="true"></span>
  </div>

  <p class="ci-hint" data-ci-hint role="status"></p>

  <button class="ci-skip" type="button" data-ci-skip>Пропустить</button>
</div>

<style>
  /* Пока висит ширма, страница не прокручивается, а main поднимается над
     шапкой: main задаёт свой контекст наложения через isolation, иначе
     шапка с z-index 30 рисовалась бы поверх сцены. */
  :global(html[data-contact-intro]) {
    overflow: hidden;
  }

  /* overflow-x: clip на body обрезает даже position: fixed, из-за чего ширма
     не доставала до краёв экрана. Прокрутку в это время держит html. */
  :global(html[data-contact-intro] body) {
    overflow-x: visible;
  }

  :global(html[data-contact-intro] main) {
    position: relative;
    z-index: 60;
  }

  /* ---------- сцена ---------- */

  .ci-stage {
    position: fixed;
    inset: 0;
    z-index: 60;
    font-family: Roboto, Arial, sans-serif;
  }

  .ci-stage[hidden] {
    display: none;
  }

  /* Напуск за края: у html зарезервирован scrollbar-gutter, из-за которого
     фиксированный слой не достаёт до физических краёв экрана. Менять сам
     гаттер нельзя — при открытии контент сместился бы на 10px. */
  .ci-curtain {
    position: absolute;
    inset: 0 -14px;
    background:
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.014) 0 44px,
        rgba(255, 255, 255, 0.038) 44px 88px
      ),
      radial-gradient(circle at 82% 8%, rgba(255, 255, 255, 0.05), transparent 34%),
      #0d0d0d;
    will-change: transform;
  }

  /* Ширму и кнопку тянет одна и та же дистанция: иначе ткань уезжает из руки. */
  .ci-stage.is-pulling .ci-curtain {
    animation: ci-pull 1.45s cubic-bezier(0.36, 0.02, 0.22, 1) forwards;
  }

  @keyframes ci-pull {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-1 * var(--ci-pull, 110vw)));
    }
  }

  /* Полка, с которой кнопка сваливается. */
  .ci-shelf {
    position: absolute;
    top: var(--ci-sleep-y, 40%);
    left: 50%;
    width: 304px;
    height: 1px;
    margin: 34px 0 0 -152px;
    background: rgba(255, 255, 255, 0.24);
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.9),
      0 12px 22px rgba(0, 0, 0, 0.55);
    transition: opacity 0.45s ease;
  }

  .ci-stage.is-awake .ci-shelf {
    opacity: 0.3;
  }

  /* Та же волосяная линия и та же ширина, что у границы футера под ширмой. */
  .ci-floorline {
    position: absolute;
    top: var(--ci-floor-y, 80%);
    right: 0;
    left: 0;
    width: min(var(--max), calc(100% - 64px));
    height: 1px;
    margin-inline: auto;
    background: var(--line);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .ci-stage.is-grounded .ci-floorline {
    opacity: 1;
  }

  .ci-shadow {
    position: absolute;
    top: var(--ci-floor-y, 80%);
    left: 50%;
    width: 300px;
    height: 18px;
    margin: -9px 0 0 -150px;
    border-radius: 50%;
    opacity: 0;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.7), transparent 68%);
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .ci-stage.is-grounded .ci-shadow {
    opacity: 1;
  }

  .ci-stage.is-walked .ci-shadow {
    opacity: 0;
  }

  /* ---------- персонаж ---------- */

  .ci-actor {
    position: absolute;
    top: var(--ci-sleep-y, 40%);
    left: 50%;
    z-index: 3;
    width: 264px;
    height: 62px;
    margin: -31px 0 0 -132px;
    will-change: transform;
  }

  .ci-btn {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 22px;
    border: 1px solid #fff;
    background: #fff;
    color: #080808;
    font: 900 17px/1 Roboto, Arial, sans-serif;
    letter-spacing: -0.03em;
    cursor: pointer;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.55);
  }

  /* Отклик на нажатие нужен только лежащей кнопке: в вертикальной позе переход
     доигрывал поворот уже после вставания и ронял персонажа обратно. */
  .ci-actor:not(.is-vertical) .ci-btn {
    transition: transform 0.16s ease;
  }

  .ci-btn:active {
    transform: scale(0.985);
  }

  .ci-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }

  .ci-label {
    white-space: nowrap;
  }

  .ci-face {
    position: absolute;
    top: 50%;
    right: 20px;
    display: flex;
    gap: 7px;
    margin-top: -3px;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .ci-face i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #080808;
  }

  .ci-actor.is-awake .ci-face {
    opacity: 1;
  }

  .ci-sleep {
    position: absolute;
    top: -16px;
    right: 10px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.1em;
    animation: ci-z 2.1s ease-in-out infinite;
  }

  .ci-sleep b {
    font-size: 16px;
  }

  @keyframes ci-z {
    0%,
    100% {
      transform: translate(0, 0);
      opacity: 0.3;
    }
    50% {
      transform: translate(6px, -9px);
      opacity: 0.85;
    }
  }

  .ci-actor.is-awake .ci-sleep {
    opacity: 0;
    animation: none;
    transition: opacity 0.2s ease;
  }

  /* ---------- реплика и подсказка ---------- */

  .ci-bubble {
    position: absolute;
    bottom: calc(100% + 20px);
    left: 50%;
    z-index: 4;
    width: max-content;
    max-width: 300px;
    margin: 0;
    padding: 11px 15px;
    border-radius: 14px;
    background: var(--text);
    color: #0d0d0d;
    font-size: 15px;
    line-height: 1.35;
    font-weight: 600;
    text-align: center;
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transform: translate(-50%, 8px) scale(0.97);
    transition:
      opacity 0.24s ease,
      transform 0.24s cubic-bezier(0.2, 0.85, 0.25, 1);
    pointer-events: none;
  }

  .ci-bubble::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 50%;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    border-radius: 2px;
    background: var(--text);
    transform: rotate(45deg);
  }

  .ci-bubble.is-shown {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
  }

  /* max-width и авто-поля обязательны: глобальный max-width для абзацев не даёт
     растянуться между left и right, и подсказка уезжает к левому краю. */
  .ci-hint {
    position: absolute;
    top: var(--ci-sleep-y, 40%);
    right: 0;
    left: 0;
    max-width: none;
    margin: 92px auto 0;
    color: var(--muted);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.24s ease;
  }

  .ci-hint.is-shown {
    opacity: 1;
  }

  .ci-skip {
    position: absolute;
    top: 26px;
    right: max(32px, calc((100% - var(--max)) / 2 + 32px));
    z-index: 6;
    padding: 8px 2px;
    border: 0;
    border-bottom: 1px solid #3a3a3a;
    background: none;
    color: var(--muted);
    font: 700 14px/1 Roboto, Arial, sans-serif;
    cursor: pointer;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .ci-skip:hover {
    color: var(--text);
    border-color: #777;
  }

  /* ---------- руки и ноги ---------- */

  .ci-arm,
  .ci-leg {
    position: absolute;
    background: #fff;
    border-radius: 999px;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .ci-actor.is-awake .ci-arm,
  .ci-actor.is-awake .ci-leg {
    opacity: 1;
  }

  .ci-arm {
    top: 66px;
    width: 40px;
    height: 7px;
  }

  .ci-arm--l {
    left: -32px;
    transform-origin: right center;
    transform: rotate(18deg);
  }

  .ci-arm--r {
    right: -32px;
    transform-origin: left center;
    transform: rotate(-18deg);
  }

  .ci-leg {
    bottom: -28px;
    width: 7px;
    height: 32px;
    transform-origin: center top;
  }

  .ci-leg--l {
    left: 12px;
    transform: rotate(7deg);
  }

  .ci-leg--r {
    right: 12px;
    transform: rotate(-7deg);
  }

  /* ---------- фазы ---------- */

  .ci-actor.is-nudged {
    animation: ci-nudge 0.6s cubic-bezier(0.2, 0.85, 0.25, 1);
  }

  @keyframes ci-nudge {
    0% {
      transform: translate(0, 0) rotate(0);
    }
    22% {
      transform: translate(0, -5px) rotate(-1.6deg);
    }
    48% {
      transform: translate(0, 3px) rotate(1.3deg);
    }
    74% {
      transform: translate(0, -2px) rotate(-0.7deg);
    }
    100% {
      transform: translate(0, 0) rotate(0);
    }
  }

  .ci-actor.is-falling {
    animation: ci-fall 0.86s cubic-bezier(0.34, 0.02, 0.32, 1) forwards;
  }

  @keyframes ci-fall {
    0% {
      transform: translate(0, 0) rotate(0);
    }
    20% {
      transform: translate(0, -8px) rotate(-3deg);
    }
    72% {
      transform: translate(0, var(--ci-fall, 200px)) rotate(11deg);
    }
    87% {
      transform: translate(0, calc(var(--ci-fall, 200px) - 16px)) rotate(7deg);
    }
    100% {
      transform: translate(0, var(--ci-fall, 200px)) rotate(9deg);
    }
  }

  .ci-actor.is-standing {
    animation: ci-stand 0.9s cubic-bezier(0.18, 0.8, 0.25, 1) forwards;
  }

  @keyframes ci-stand {
    0% {
      transform: translate(0, var(--ci-fall, 200px)) rotate(9deg);
    }
    45% {
      transform: translate(0, calc(var(--ci-fall, 200px) - 26px)) rotate(-38deg);
    }
    80% {
      transform: translate(0, calc(var(--ci-rise, 100px) + 18px)) rotate(-97deg);
    }
    100% {
      transform: translate(0, var(--ci-rise, 100px)) rotate(-90deg);
    }
  }

  /* Устойчивая вертикаль: тот же силуэт, но геометрия уже не повёрнута,
     поэтому руки и ноги живут в обычных координатах. */
  .ci-actor.is-vertical {
    width: 62px;
    height: 264px;
    margin: -132px 0 0 -31px;
    transform: translate(0, var(--ci-rise, 100px));
  }

  .ci-actor.is-vertical .ci-btn {
    top: 50%;
    right: auto;
    bottom: auto;
    left: 50%;
    width: 264px;
    height: 62px;
    margin: -31px 0 0 -132px;
    transform: rotate(-90deg);
  }

  .ci-actor.is-vertical .ci-bubble {
    bottom: calc(100% + 16px);
  }

  .ci-actor.is-walking {
    animation: ci-walk 2.6s cubic-bezier(0.4, 0, 0.6, 1) forwards;
  }

  @keyframes ci-walk {
    from {
      transform: translate(0, var(--ci-rise, 100px));
    }
    to {
      transform: translate(var(--ci-walk, -320px), var(--ci-rise, 100px));
    }
  }

  .ci-actor.is-walking .ci-leg--l {
    animation: ci-step-a 0.4s ease-in-out infinite alternate;
  }

  .ci-actor.is-walking .ci-leg--r {
    animation: ci-step-b 0.4s ease-in-out infinite alternate;
  }

  .ci-actor.is-walking .ci-arm--l {
    animation: ci-swing-a 0.4s ease-in-out infinite alternate;
  }

  .ci-actor.is-walking .ci-arm--r {
    animation: ci-swing-b 0.4s ease-in-out infinite alternate;
  }

  @keyframes ci-step-a {
    from {
      transform: rotate(20deg);
    }
    to {
      transform: rotate(-18deg);
    }
  }

  @keyframes ci-step-b {
    from {
      transform: rotate(-18deg);
    }
    to {
      transform: rotate(20deg);
    }
  }

  @keyframes ci-swing-a {
    from {
      transform: rotate(36deg);
    }
    to {
      transform: rotate(-18deg);
    }
  }

  @keyframes ci-swing-b {
    from {
      transform: rotate(-36deg);
    }
    to {
      transform: rotate(18deg);
    }
  }

  .ci-actor.is-grabbing {
    animation: ci-strain 0.62s ease-in-out infinite alternate;
  }

  @keyframes ci-strain {
    from {
      transform: translate(var(--ci-walk, -320px), var(--ci-rise, 100px));
    }
    to {
      transform: translate(calc(var(--ci-walk, -320px) - 10px), var(--ci-rise, 100px));
    }
  }

  .ci-actor.is-grabbing .ci-arm--l {
    left: -70px;
    width: 78px;
    transform: rotate(0deg);
    transition:
      width 0.34s ease,
      left 0.34s ease,
      transform 0.34s ease;
  }

  .ci-actor.is-grabbing .ci-arm--r {
    transform: rotate(-46deg);
  }

  /* Ровно то же расстояние и та же кривая, что у ширмы: кнопка держит ткань
     и уходит за край экрана вместе с ней, а не растворяется. */
  .ci-stage.is-pulling .ci-actor {
    animation: ci-drag 1.45s cubic-bezier(0.36, 0.02, 0.22, 1) forwards;
  }

  @keyframes ci-drag {
    from {
      transform: translate(var(--ci-walk, -320px), var(--ci-rise, 100px));
    }
    to {
      transform: translate(
        calc(var(--ci-walk, -320px) - var(--ci-pull, 110vw)),
        var(--ci-rise, 100px)
      );
    }
  }

  /* ---------- ссылка «показать заново» ---------- */

  :global(.ci-replay-row) {
    padding-top: 22px;
    padding-bottom: 4px;
  }

  :global(.ci-replay) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0 0 3px;
    border: 0;
    border-bottom: 1px solid #2a2a2a;
    background: none;
    color: var(--muted);
    font: 700 14px/1 Roboto, Arial, sans-serif;
    cursor: pointer;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }

  :global(.ci-replay:hover) {
    color: var(--text);
    border-color: #777;
  }

  /* ---------- узкие экраны ---------- */

  @media (max-width: 900px) {
    .ci-floorline {
      width: calc(100% - 36px);
    }

    .ci-skip {
      right: 30px;
    }
  }

  @media (max-width: 640px) {
    .ci-actor {
      width: 208px;
      height: 56px;
      margin: -28px 0 0 -104px;
    }

    .ci-actor.is-vertical {
      width: 56px;
      height: 208px;
      margin: -104px 0 0 -28px;
    }

    .ci-actor.is-vertical .ci-btn {
      width: 208px;
      height: 56px;
      margin: -28px 0 0 -104px;
    }

    .ci-btn {
      font-size: 15px;
    }

    .ci-arm {
      top: 54px;
    }

    .ci-leg--l {
      left: 10px;
    }

    .ci-leg--r {
      right: 10px;
    }

    .ci-shelf {
      width: 240px;
      margin-left: -120px;
    }

    .ci-shadow {
      width: 232px;
      margin-left: -116px;
    }

    .ci-bubble {
      max-width: min(280px, calc(100vw - 56px));
      font-size: 14px;
    }

    .ci-hint {
      margin-top: 84px;
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ci-stage {
      display: none;
    }
  }
</style>

<script is:inline data-astro-rerun>
  (() => {
    window.__ptahenContactIntro?.abort();

    const stage = document.querySelector('[data-ci-stage]');
    const page = document.querySelector('[data-contact-page]');
    if (!stage || !page) return;

    const controller = new AbortController();
    const { signal } = controller;
    window.__ptahenContactIntro = controller;

    const root = document.documentElement;
    const actor = stage.querySelector('[data-ci-actor]');
    const wake = stage.querySelector('[data-ci-wake]');
    const label = stage.querySelector('[data-ci-label]');
    const bubble = stage.querySelector('[data-ci-bubble]');
    const hint = stage.querySelector('[data-ci-hint]');
    const skip = stage.querySelector('[data-ci-skip]');

    /** Ноги торчат ниже корпуса — на столько же поднимаем стоящую фигуру. */
    const FEET = 28;

    const timers = new Set();
    const later = (ms, fn) => {
      const id = setTimeout(() => {
        timers.delete(id);
        fn();
      }, ms);
      timers.add(id);
    };
    const stopTimers = () => {
      timers.forEach(clearTimeout);
      timers.clear();
    };

    signal.addEventListener('abort', stopTimers);

    const say = (text) => {
      bubble.textContent = text;
      bubble.classList.add('is-shown');
    };
    const hush = () => bubble.classList.remove('is-shown');
    const showHint = (text) => {
      hint.textContent = text;
      hint.classList.toggle('is-shown', Boolean(text));
    };

    /**
     * Ширма закрывает сайт целиком, поэтому фокус не должен уходить под неё.
     * Помечаем именно закрытые куски, а не main: сцена лежит внутри main, и
     * inert на нём выключил бы её собственные кнопки.
     */
    const setContentInert = (on) => {
      document
        .querySelectorAll('header.site-header, footer.site-footer, .contact-hero, .contact-grid, .ci-replay-row')
        .forEach((el) => {
          if (on) el.setAttribute('inert', '');
          else el.removeAttribute('inert');
        });
    };

    const remember = () => {
      try {
        localStorage.setItem('ptahen-contact-intro-seen', '1');
      } catch {
        // Приватный режим: просто не запоминаем.
      }
    };

    /**
     * Пол сцены совпадает с верхней границей футера, чтобы кнопка ходила
     * ровно по той линии, которая останется на странице после интро.
     */
    const measure = () => {
      const footer = document.querySelector('footer.site-footer');
      const viewport = window.innerHeight;

      const footerTop = footer ? footer.getBoundingClientRect().top : viewport - 150;
      const floorY = Math.min(Math.max(footerTop, 320), viewport - 40);

      const lyingWidth = actor.offsetWidth || 264;
      const lyingHeight = actor.offsetHeight || 62;

      // Полка висит на фиксированной высоте над полом: падение читается
      // одинаково и на ноутбуке, и на большом мониторе.
      const drop = Math.min(230, Math.max(150, floorY * 0.32));
      const sleepY = floorY - drop;

      const set = (name, value) => stage.style.setProperty(name, Math.round(value) + 'px');

      set('--ci-sleep-y', sleepY);
      set('--ci-floor-y', floorY);
      set('--ci-fall', floorY - sleepY - lyingHeight / 2);
      set('--ci-rise', floorY - sleepY - (lyingWidth / 2 + FEET));
      set('--ci-walk', -(window.innerWidth / 2 - 96));
      set('--ci-pull', window.innerWidth + 140);
    };

    const finish = () => {
      stopTimers();
      stage.hidden = true;
      stage.className = 'ci-stage';
      setContentInert(false);
      root.removeAttribute('data-contact-intro');
      remember();
      showReplay();
    };

    let phase = 0;
    let busy = false;

    const start = () => {
      stopTimers();
      phase = 0;
      busy = false;
      stage.className = 'ci-stage';
      stage.hidden = false;
      actor.className = 'ci-actor';
      label.textContent = 'Связаться';
      hush();
      showHint('');
      root.setAttribute('data-contact-intro', 'pending');
      setContentInert(true);
      measure();
    };

    const run = () => {
      if (busy || stage.hidden) return;

      if (phase === 0) {
        phase = 1;
        say('М-м… ещё пять минут.');
        showHint('Толкните ещё раз');
        actor.classList.add('is-nudged');
        later(620, () => actor.classList.remove('is-nudged'));
        return;
      }

      if (phase !== 1) return;

      phase = 2;
      busy = true;
      hush();
      showHint('');
      measure();
      stage.classList.add('is-awake');
      actor.classList.remove('is-nudged');
      actor.classList.add('is-falling');
      label.textContent = 'Ай!';

      later(800, () => stage.classList.add('is-grounded'));

      later(880, () => {
        actor.classList.remove('is-falling');
        actor.classList.add('is-standing');
      });

      later(1780, () => {
        actor.classList.remove('is-standing');
        actor.classList.add('is-vertical', 'is-awake');
        say('Ай. Ну ладно, встаю.');
        label.textContent = 'Ну вот…';
      });

      later(3150, () => {
        hush();
        label.textContent = 'Иду…';
        stage.classList.add('is-walked');
        actor.classList.add('is-walking');
      });

      later(5750, () => {
        actor.classList.remove('is-walking');
        actor.classList.add('is-grabbing');
        say('Сейчас открою.');
        label.textContent = 'Тяну…';
      });

      later(6800, () => {
        hush();
        stage.classList.add('is-pulling');
      });

      later(8250, finish);
    };

    let replay = page.querySelector('.ci-replay');

    function showReplay() {
      const grid = page.querySelector('.contact-grid');
      if (!grid || replay) return;

      const row = document.createElement('div');
      row.className = 'shell ci-replay-row';

      replay = document.createElement('button');
      replay.type = 'button';
      replay.className = 'ci-replay';
      replay.textContent = '↻ Показать анимацию заново';
      replay.addEventListener(
        'click',
        () => {
          try {
            localStorage.removeItem('ptahen-contact-intro-seen');
          } catch {
            // Нечего убирать.
          }
          start();
          wake.focus();
        },
        { signal },
      );

      row.appendChild(replay);
      grid.insertAdjacentElement('afterend', row);
    }

    wake.addEventListener('click', run, { signal });
    skip.addEventListener('click', finish, { signal });

    window.addEventListener(
      'resize',
      () => {
        if (!stage.hidden && !busy) measure();
      },
      { signal },
    );

    // Уход со страницы посреди анимации не должен доигрывать таймеры и
    // помечать интро просмотренным.
    document.addEventListener('astro:before-swap', () => controller.abort(), { signal });

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && !stage.hidden) finish();
      },
      { signal },
    );

    const ready = (fn) => {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', fn, { once: true, signal });
      } else {
        fn();
      }
    };

    if (root.getAttribute('data-contact-intro') === 'pending') {
      stage.hidden = false;
      ready(start);
    } else {
      ready(showReplay);
    }
  })();
</script>
