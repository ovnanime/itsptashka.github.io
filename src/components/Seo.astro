---
import { SITE } from '../data/site';
import {
  DEFAULT_OG_IMAGE,
  PERSON_ID,
  VERIFICATION,
  WEBSITE_ID,
  absoluteUrl,
  canonicalUrl,
  personSchema,
  websiteSchema,
} from '../data/seo';

export interface Props {
  title: string;
  description: string;
  robots?: string;
  /** Путь к изображению превью. По умолчанию — общее изображение сайта. */
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
  /** Тип основной сущности страницы в JSON-LD. */
  pageType?: 'WebPage' | 'ProfilePage' | 'CollectionPage';
  /** Дополнительные узлы @graph: BlogPosting, CreativeWork и т. п. */
  schema?: Record<string, unknown>[];
  /** Даты для публикаций. dateModified выводится только если реально известна. */
  publishedTime?: string;
  modifiedTime?: string;
  /** Исключить страницу из JSON-LD (служебные страницы под noindex). */
  noSchema?: boolean;
}

const {
  title,
  description,
  robots = 'index, follow',
  image = DEFAULT_OG_IMAGE.url,
  imageWidth = DEFAULT_OG_IMAGE.width,
  imageHeight = DEFAULT_OG_IMAGE.height,
  imageAlt = DEFAULT_OG_IMAGE.alt,
  ogType = 'website',
  pageType = 'WebPage',
  schema = [],
  publishedTime,
  modifiedTime,
  noSchema = false,
} = Astro.props;

const url = canonicalUrl(Astro.url.pathname);
const isIndexable = !robots.includes('noindex');
const imageUrl = absoluteUrl(image);
const imageType = image.endsWith('.webp')
  ? 'image/webp'
  : image.endsWith('.png')
    ? 'image/png'
    : 'image/jpeg';

const pageNode: Record<string, unknown> = {
  '@type': pageType,
  '@id': `${url}#webpage`,
  url,
  name: title,
  description,
  inLanguage: 'ru-RU',
  isPartOf: { '@id': WEBSITE_ID },
  primaryImageOfPage: { '@id': `${url}#primaryimage` },
  about: { '@id': PERSON_ID },
};

if (pageType === 'ProfilePage') {
  pageNode.mainEntity = { '@id': PERSON_ID };
}

const imageNode = {
  '@type': 'ImageObject',
  '@id': `${url}#primaryimage`,
  url: imageUrl,
  contentUrl: imageUrl,
  width: imageWidth,
  height: imageHeight,
  caption: imageAlt,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [websiteSchema, personSchema, imageNode, pageNode, ...schema],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
{isIndexable && <link rel="canonical" href={url} />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="ru_RU" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content={imageType} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:alt" content={imageAlt} />

{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{ogType === 'article' && <meta property="article:author" content={personSchema.name} />}

{VERIFICATION.google && <meta name="google-site-verification" content={VERIFICATION.google} />}
{VERIFICATION.yandex && <meta name="yandex-verification" content={VERIFICATION.yandex} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{
  !noSchema && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
  )
}
