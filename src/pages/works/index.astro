  <script is:inline data-astro-rerun>
    (() => {
    const tabButtons = document.querySelectorAll('[data-tab]');
    const panels = document.querySelectorAll('[data-panel]');

    const availableTabs = ['demo', 'releases', 'author', 'programs'];
    const WORKS_TAB_KEY = 'ptahen-works-active-tab';
    const WORKS_HISTORY_TAB_KEY = 'ptahenWorksActiveTab';

    const getInitialTab = () => {
      const historyTab = history.state?.[WORKS_HISTORY_TAB_KEY];
      const stored = sessionStorage.getItem(WORKS_TAB_KEY);
      sessionStorage.removeItem(WORKS_TAB_KEY);

      const hashTab = location.hash.replace('#', '');
      if (availableTabs.includes(hashTab)) return hashTab;
      if (availableTabs.includes(historyTab)) return historyTab;
      return availableTabs.includes(stored) ? stored : 'demo';
    };

    const rememberActiveTab = (target) => {
      const currentState = history.state && typeof history.state === 'object' ? history.state : {};
      history.replaceState(
        { ...currentState, [WORKS_HISTORY_TAB_KEY]: target },
        '',
        location.href,
      );
    };

    const resetReleaseRoleFilter = () => {
      const filterButtons = document.querySelectorAll('[data-role-filter]');
      const releaseCards = document.querySelectorAll('[data-release-card]');
      const studioSections = document.querySelectorAll('[data-studio-section]');

      filterButtons.forEach((button) => {
        button.classList.remove('active', 'is-excluding');
        button.dataset.filterMode = '';
        button.setAttribute('aria-pressed', 'false');
      });

      releaseCards.forEach((card) => {
        card.hidden = false;
      });

      studioSections.forEach((section) => {
        section.hidden = false;
      });

    };

    const setActiveTab = (target) => {
      tabButtons.forEach((button) => {
        button.classList.toggle('active', button.dataset.tab === target);
      });

      panels.forEach((panel) => {
        panel.classList.toggle('active', panel.dataset.panel === target);
      });

      resetReleaseRoleFilter();
      rememberActiveTab(target);
    };

    setActiveTab(getInitialTab());

    tabButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.dataset.tab;
        if (!availableTabs.includes(target)) return;

        setActiveTab(target);
      });
    });

    const roleFilterButtons = document.querySelectorAll('[data-role-filter]');
    const studioSections = document.querySelectorAll('[data-studio-section]');

    const applyReleaseRoleFilter = (activeRole, mode = 'include') => {
      roleFilterButtons.forEach((button) => {
        const isCurrent = button.dataset.roleFilter === activeRole;

        button.classList.toggle('active', isCurrent && mode === 'include');
        button.classList.toggle('is-excluding', isCurrent && mode === 'exclude');
        button.dataset.filterMode = isCurrent ? mode : '';
        button.setAttribute('aria-pressed', String(isCurrent));
      });

      studioSections.forEach((section) => {
        const cards = Array.from(section.querySelectorAll('[data-release-card]'));

        if (!cards.length) {
          section.hidden = Boolean(activeRole);
          return;
        }

        let hasVisibleCards = false;

        cards.forEach((card) => {
          const roles = String(card.dataset.roles || '').split(' ');
          const hasRole = activeRole ? roles.includes(activeRole) : true;
          const shouldShow = !activeRole
            ? true
            : mode === 'exclude'
              ? !hasRole
              : hasRole;

          card.hidden = !shouldShow;

          if (shouldShow) {
            hasVisibleCards = true;
          }
        });

        section.hidden = Boolean(activeRole) && !hasVisibleCards;
      });
    };

    roleFilterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const scrollBeforeFilter = window.scrollY;
        const role = button.dataset.roleFilter;
        const currentMode = button.dataset.filterMode || '';
        const nextMode = currentMode === 'include'
          ? 'exclude'
          : currentMode === 'exclude'
            ? ''
            : 'include';

        applyReleaseRoleFilter(nextMode ? role : '', nextMode || 'include');

        requestAnimationFrame(() => {
          window.scrollTo({
            top: scrollBeforeFilter,
            left: 0,
            behavior: 'auto',
          });
        });
      });
    });
    })();
  </script>

  <script is:inline data-astro-rerun>
    (() => {
      const overlay = document.querySelector('[data-program-confirm]');
      if (!overlay) return;

      document.body.appendChild(overlay);

      const title = overlay.querySelector('[data-program-confirm-title]');
      const text = overlay.querySelector('[data-program-confirm-text]');
      const cancelButton = overlay.querySelector('[data-program-confirm-cancel]');
      const acceptButton = overlay.querySelector('[data-program-confirm-accept]');
      const actionButtons = document.querySelectorAll('[data-program-action]');
      let pendingUrl = '';
      let pendingAction = '';

      const closeConfirm = () => {
        overlay.hidden = true;
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.removeProperty('overflow');
        pendingUrl = '';
        pendingAction = '';
      };

      const openConfirm = (button) => {
        const programTitle = button.dataset.programTitle || 'программу';
        pendingUrl = button.dataset.programUrl || '';
        pendingAction = button.dataset.programAction || '';

        if (pendingAction === 'download') {
          title.textContent = `Скачать ${programTitle}?`;
          text.textContent = 'Загрузка начнётся с внешнего сервиса Dropbox.';
          acceptButton.textContent = 'Скачать';
        } else {
          title.textContent = `Перейти к ${programTitle}?`;
          text.textContent = 'Репозиторий откроется на внешнем сайте GitHub.';
          acceptButton.textContent = 'Перейти';
        }

        overlay.hidden = false;
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        acceptButton.focus();
      };

      actionButtons.forEach((button) => {
        button.addEventListener('click', () => openConfirm(button));
      });

      cancelButton?.addEventListener('click', closeConfirm);

      acceptButton?.addEventListener('click', () => {
        if (!pendingUrl) return closeConfirm();
        window.open(pendingUrl, '_blank', 'noopener,noreferrer');
        closeConfirm();
      });

      overlay.addEventListener('click', (event) => {
        if (event.target === overlay) closeConfirm();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !overlay.hidden) closeConfirm();
      });
    })();
  </script>

