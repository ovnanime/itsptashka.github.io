---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { CONTACTS, NAV_ITEMS, SITE } from '../data/site';

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  robots = 'index, follow',
} = Astro.props;

const path = Astro.url.pathname;
const canonicalUrl = new URL(path, Astro.site);
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <ClientRouter fallback="animate" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;800;900&display=optional"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="На главную">
        {SITE.name}
      </a>

      <button
        class="menu-toggle"
        type="button"
        aria-label="Открыть меню"
        aria-controls="site-navigation"
        aria-expanded="false"
      >
        Меню
      </button>

      <nav id="site-navigation" aria-label="Основная навигация">
        {
          NAV_ITEMS.map(({ href, label }) => (
            <a
              class={
                path === href || (href !== '/' && path.startsWith(href))
                  ? 'active'
                  : ''
              }
              href={href}
            >
              {label}
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <a class="footer-brand" href="/">{SITE.name}</a>

      <div class="footer-right">
        <nav class="footer-links" aria-label="Контакты">
          {CONTACTS.map((contact) => <a href={contact.href}>{contact.footerLabel}</a>)}
        </nav>

        <span class="footer-copy">© {SITE.copyrightStartYear}–{currentYear}</span>
      </div>
    </footer>

    <script is:inline data-astro-rerun>
      (() => {
      window.__ptahenMenuController?.abort();
      const controller = new AbortController();
      const { signal } = controller;
      window.__ptahenMenuController = controller;

      const menuButton = document.querySelector('.menu-toggle');
      const navigation = document.querySelector('#site-navigation');

      const setMenuState = (isOpen) => {
        navigation?.classList.toggle('open', isOpen);
        menuButton?.setAttribute('aria-expanded', String(isOpen));
        menuButton?.setAttribute('aria-label', isOpen ? 'Закрыть меню' : 'Открыть меню');
      };

      menuButton?.addEventListener('click', () => {
        setMenuState(!navigation?.classList.contains('open'));
      }, { signal });

      navigation?.addEventListener('click', (event) => {
        if (event.target.closest('a')) setMenuState(false);
      }, { signal });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenuState(false);
      }, { signal });

      document.addEventListener('astro:before-preparation', (event) => {
        const from = event.from;
        if (!from || from.origin !== window.location.origin) return;

        const to = event.to;
        sessionStorage.setItem('ptahen-router-navigation', JSON.stringify({
          from: `${from.pathname}${from.search}${from.hash}`,
          to: to ? `${to.pathname}${to.search}${to.hash}` : '',
        }));
      }, { signal });
      })();
    </script>

    <div
      class="image-viewer-overlay"
      data-image-viewer-overlay
      role="dialog"
      aria-modal="true"
      aria-label="Просмотр изображения"
      hidden
      aria-hidden="true"
    >
      <div class="image-viewer-topbar">
        <button class="image-viewer-button" type="button" data-image-viewer-close>
          ← Назад
        </button>

        <div class="image-viewer-actions">
          <a
            class="image-viewer-button image-viewer-download"
            href="#"
            download
            data-image-viewer-download
          >
            Скачать
          </a>
        </div>
      </div>

      <div class="image-viewer-frame" data-image-viewer-frame>
        <img src="" alt="" data-image-viewer-image />
      </div>
    </div>

    <script is:inline data-astro-rerun>
      (() => {
        window.__ptahenImageViewerController?.abort();
        const controller = new AbortController();
        const { signal } = controller;
        window.__ptahenImageViewerController = controller;

        const overlay = document.querySelector('[data-image-viewer-overlay]');
        const frame = document.querySelector('[data-image-viewer-frame]');
        const viewerImage = document.querySelector('[data-image-viewer-image]');
        const closeButton = document.querySelector('[data-image-viewer-close]');
        const downloadButton = document.querySelector('[data-image-viewer-download]');

        if (!overlay || !frame || !viewerImage || !closeButton || !downloadButton) return;

        const ignored = [
          'a',
          'button',
          '[role="button"]',
          '[data-no-image-viewer]',
          '.coming-card',
          '.coming-banner',
          '.movie-poster-link',
          '.project-card',
          '.project-image',
          '.release-card-redesign',
          '.demo-card',
          '.demo-thumb',
          '.demo-video-card'
        ].join(',');

        const images = Array.from(document.querySelectorAll('img:not([data-image-viewer-image])'));

        images.forEach((image) => {
          if (image.closest(ignored)) return;

          const src = image.currentSrc || image.src;
          if (!src || src.startsWith('data:')) return;

          const target =
            image.closest(
              'figure, .journal-shot, .journal-image-placeholder, .portrait-frame, ' +
              '.abv4-photo, .abv4-image-slot, .abv4-timeline-photo'
            ) || image.parentElement;

          if (!target || target.closest(ignored)) return;

          target.setAttribute('data-image-viewer-target', '');
          target.setAttribute('role', 'button');
          target.setAttribute('tabindex', '0');
          target.setAttribute('aria-label', `Открыть изображение: ${image.alt || 'без подписи'}`);
          target.__viewerImage = image;
        });

        const filenameFromSource = (src) => {
          try {
            const url = new URL(src, window.location.href);
            return url.pathname.split('/').filter(Boolean).pop() || 'image';
          } catch {
            return 'image';
          }
        };

        let previouslyFocused = null;

        const openViewer = (image) => {
          const src = image.currentSrc || image.src;
          if (!src) return;

          viewerImage.src = src;
          viewerImage.alt = image.alt || '';
          downloadButton.href = src;
          downloadButton.setAttribute('download', filenameFromSource(src));

          overlay.hidden = false;
          overlay.setAttribute('aria-hidden', 'false');
          document.body.classList.add('image-viewer-open');
          previouslyFocused = document.activeElement;
          closeButton.focus();
        };

        const closeViewer = () => {
          overlay.hidden = true;
          overlay.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('image-viewer-open');
          viewerImage.removeAttribute('src');
          viewerImage.alt = '';
          downloadButton.href = '#';
          previouslyFocused?.focus?.();
          previouslyFocused = null;
        };

        document.addEventListener('click', (event) => {
          const target = event.target?.closest?.('[data-image-viewer-target]');
          if (!target) return;

          const image = target.__viewerImage || target.querySelector('img');
          if (!image) return;

          event.preventDefault();
          event.stopPropagation();
          openViewer(image);
        }, { signal });

        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;

          const target = event.target?.closest?.('[data-image-viewer-target]');
          if (!target) return;

          const image = target.__viewerImage || target.querySelector('img');
          if (!image) return;

          event.preventDefault();
          openViewer(image);
        }, { signal });

        closeButton.addEventListener('click', closeViewer, { signal });

        overlay.addEventListener('click', (event) => {
          if (event.target === overlay || event.target === frame) {
            closeViewer();
          }
        }, { signal });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && !overlay.hidden) {
            closeViewer();
          }
        }, { signal });
      })();
    </script>

</body>
</html>
