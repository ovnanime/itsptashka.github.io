      }

      .release-dialog-info h2 {
        font-size: 22px;
      }
    }

    /* Деморил: две группы — озвучивание и звук. Разделены воздухом, без линий. */
    /* Подписи групп деморила: читаемые, но спокойнее заголовков студий */
