---
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
  {
    number: '01',
    label: 'Разбор персонажа',
    title: 'От текста к образу',
    text:
      'Сначала оцениваю сцену: состояние персонажа, контекст, визуал и скрытое намерение. Не ищу шаблон — собираю живую версию голоса под конкретный момент.',
  },
  {
    number: '02',
    label: 'Запись',
    title: 'Поиск звука',
    text:
      'У микрофона не выдавливаю эмоцию искусственно. Ищу подачу, которая ложится на картинку: дыхание, темп, напряжение, паузы и характер персонажа.',
  },
  {
    number: '03',
    label: 'Сборка',
    title: 'Сведение и контроль',
    text:
      'После записи идёт чистка, монтаж и посадка голоса в микс. Финальная проверка — не только в наушниках, но и на мониторах, чтобы звук оставался рабочим вне студии.',
  },
];
---

<BaseLayout title="Подход — Феофилакт Птахен">
  <main class="approach-page">
    <section class="shell approach-hero">
      <div class="approach-hero-copy">
        <p class="approach-label">Метод работы</p>
        <h1>Голос начинается раньше звука.</h1>
        <p>
          Для меня озвучка начинается не с красивой интонации, а с причины:
          что персонаж хочет, что скрывает и почему говорит именно так.
        </p>
      </div>
    </section>

    <section class="shell approach-steps" aria-label="Этапы работы">
      {steps.map((step) => (
        <article class="approach-card">
          <div class="approach-card-index">
            <span>{step.number}</span>
            <b>{step.label}</b>
          </div>

          <div class="approach-card-body">
            <h2>{step.title}</h2>
            <p>{step.text}</p>
          </div>
        </article>
      ))}
    </section>
  </main>

  <style>

    :global(html),
    :global(body) {
      min-height: 100%;
    }

    :global(body) {
      display: flex;
      min-height: 100dvh;
      flex-direction: column;
    }

    :global(body > header.site-header) {
      flex-shrink: 0;
    }

    :global(body > main) {
      flex: 1 0 auto;
    }

    :global(body > footer.site-footer) {
      flex-shrink: 0;
      margin-top: auto !important;
    }

    .approach-page {
      padding: 34px 0 0;
    }

    .approach-hero {
      display: block;
      padding-bottom: 18px;
      border-bottom: 1px solid var(--line);
    }

    .approach-hero-copy {
      max-width: 760px;
    }

    .approach-label,
    .approach-card-index b {
      display: block;
      margin: 0 0 14px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .approach-hero h1 {
      max-width: 760px;
      margin: 0 0 14px;
      color: var(--text);
      font-size: clamp(34px, 4vw, 36px);
      line-height: 1.04;
      font-weight: 900;
      letter-spacing: -0.055em;
    }

    .approach-hero-copy > p:last-child {
      max-width: 680px;
      margin: 0;
      color: var(--muted);
      font-size: 18px;
      line-height: 1.48;
    }

    .approach-steps {
      display: grid;
      gap: 14px;
      padding-top: 18px;
    }

    .approach-card {
      display: grid;
      grid-template-columns: 178px minmax(0, 1fr);
      gap: 24px;
      align-items: stretch;
      padding: 20px 22px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: #101010;
    }

    .approach-card-index {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 136px;
      padding-right: 20px;
      border-right: 1px solid var(--line);
    }

    .approach-card-index span {
      color: #fff;
      font-size: 42px;
      line-height: 0.9;
      font-weight: 900;
      letter-spacing: -0.07em;
      opacity: 0.92;
    }

    .approach-card-index b {
      max-width: 130px;
      margin: 0;
      line-height: 1.35;
    }

    .approach-card-body {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 136px;
    }

    .approach-card-body h2 {
      margin: 0 0 12px;
      color: var(--text);
      font-size: clamp(26px, 2.7vw, 34px);
      line-height: 1.08;
      font-weight: 900;
      letter-spacing: -0.045em;
    }

    .approach-card-body p {
      max-width: 900px;
      margin: 0;
      color: var(--muted);
      font-size: 18px;
      line-height: 1.55;
    }

    @media (max-width: 900px) {
      .approach-card {
        grid-template-columns: 130px minmax(0, 1fr);
      }

      .approach-card-index {
        min-height: 120px;
      }
    }

    @media (max-width: 640px) {
      .approach-page {
        padding: 28px 0 0;
      }

      .approach-hero h1 {
        font-size: 34px;
      }

      .approach-hero-copy > p:last-child,
      .approach-card-body p {
        font-size: 16px;
      }

      .approach-card {
        grid-template-columns: 1fr;
        gap: 14px;
      }

      .approach-card-index {
        min-height: auto;
        padding-right: 0;
        padding-bottom: 14px;
        border-right: 0;
        border-bottom: 1px solid var(--line);
      }

      .approach-card-index span {
        font-size: 34px;
      }

      .approach-card-body {
        min-height: auto;
      }
    }

    /* Unified top typography override */
    .approach-page {
      padding-top: 34px !important;
    }

    .approach-label {
      margin: 0 0 14px !important;
      color: var(--muted) !important;
      font-size: 14px !important;
      line-height: 1.2 !important;
      font-weight: 800 !important;
      letter-spacing: 0.18em !important;
      text-transform: uppercase !important;
      font-family: Roboto, Arial, sans-serif !important;
    }

    .approach-hero h1 {
      font-family: Roboto, Arial, sans-serif !important;
      font-size: 36px !important;
      line-height: 1.08 !important;
      font-weight: 900 !important;
      letter-spacing: -0.045em !important;
      margin: 0 0 14px !important;
    }


    /* More air for approach cards after Roboto unification */
    .approach-steps {
      gap: 14px !important;
      padding-top: 18px !important;
    }

    .approach-card {
      grid-template-columns: 178px minmax(0, 1fr) !important;
      gap: 24px !important;
      padding: 20px 22px !important;
    }

    .approach-card-index,
    .approach-card-body {
      min-height: 136px !important;
    }

    .approach-card-index {
      padding-right: 20px !important;
    }

    .approach-card-body h2 {
      margin-bottom: 12px !important;
    }

    .approach-card-body p {
      line-height: 1.55 !important;
    }

  </style>
</BaseLayout>
