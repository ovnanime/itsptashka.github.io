---
import '../styles/global.css';

const {
  title = 'Феофилакт Птахен',
  description = 'Актёр озвучивания и звукорежиссёр',
} = Astro.props;

const path = Astro.url.pathname;

const nav = [
  ['/', 'Главная'],
  ['/works', 'Работы'],
  ['/approach', 'Подход'],
  ['/about', 'Обо мне'],
  ['/journal', 'Публикации'],
  ['/contact', 'Контакты'],
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
<title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;800;900&display=optional"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
</head>

  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="На главную">
        Феофилакт Птахен
      </a>

      <button class="menu-toggle" type="button" aria-label="Открыть меню">
        Меню
      </button>

      <nav aria-label="Основная навигация">
        {
          nav.map(([href, label]) => (
            <a
              class={
                path === href || (href !== '/' && path.startsWith(href))
                  ? 'active'
                  : ''
              }
              href={href}
            >
              {label}
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <a class="footer-brand" href="/"> 
      </a>

      <div class="footer-right">
        <nav class="footer-links" aria-label="Контакты">
          <a href="https://t.me/itsptashka">Telegram</a>
          <a href="https://vk.com/itsptashka">VK</a>
          <a href="mailto:itsptashka@gmail.com">Email</a>
        </nav>

        <span class="footer-copy">© 2023–2026</span>
      </div>
    </footer>

    <script is:inline>
      const menuButton = document.querySelector('.menu-toggle');
      const navigation = document.querySelector('header nav');

      menuButton?.addEventListener('click', () => {
        navigation?.classList.toggle('open');
      });
    </script>

    <div class="image-viewer-overlay" data-image-viewer-overlay hidden aria-hidden="true">
      <div class="image-viewer-topbar">
        <button class="image-viewer-button" type="button" data-image-viewer-close>
          ← Назад
        </button>

        <div class="image-viewer-actions">
          <a
            class="image-viewer-button image-viewer-download"
            href="#"
            download
            data-image-viewer-download
          >
            Скачать
          </a>
        </div>
      </div>

      <div class="image-viewer-frame" data-image-viewer-frame>
        <img src="" alt="" data-image-viewer-image />
      </div>
    </div>

    <script is:inline>
      (() => {
        const overlay = document.querySelector('[data-image-viewer-overlay]');
        const frame = document.querySelector('[data-image-viewer-frame]');
        const viewerImage = document.querySelector('[data-image-viewer-image]');
        const closeButton = document.querySelector('[data-image-viewer-close]');
        const downloadButton = document.querySelector('[data-image-viewer-download]');

        if (!overlay || !frame || !viewerImage || !closeButton || !downloadButton) return;

        const ignored = [
          'a',
          'button',
          '[role="button"]',
          '[data-no-image-viewer]',
          '.coming-card',
          '.coming-banner',
          '.movie-poster-link',
          '.project-card',
          '.project-image',
          '.demo-card',
          '.demo-thumb',
          '.demo-video-card'
        ].join(',');

        const images = Array.from(document.querySelectorAll('img:not([data-image-viewer-image])'));

        images.forEach((image) => {
          if (image.closest(ignored)) return;

          const src = image.currentSrc || image.src;
          if (!src || src.startsWith('data:')) return;

          const target =
            image.closest(
              'figure, .journal-shot, .journal-image-placeholder, .portrait-frame, ' +
              '.abv4-photo, .abv4-image-slot, .abv4-timeline-photo'
            ) || image.parentElement;

          if (!target || target.closest(ignored)) return;

          target.setAttribute('data-image-viewer-target', '');
          target.__viewerImage = image;
        });

        const filenameFromSource = (src) => {
          try {
            const url = new URL(src, window.location.href);
            return url.pathname.split('/').filter(Boolean).pop() || 'image';
          } catch {
            return 'image';
          }
        };

        const openViewer = (image) => {
          const src = image.currentSrc || image.src;
          if (!src) return;

          viewerImage.src = src;
          viewerImage.alt = image.alt || '';
          downloadButton.href = src;
          downloadButton.setAttribute('download', filenameFromSource(src));

          overlay.hidden = false;
          overlay.setAttribute('aria-hidden', 'false');
          document.body.classList.add('image-viewer-open');
        };

        const closeViewer = () => {
          overlay.hidden = true;
          overlay.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('image-viewer-open');
          viewerImage.removeAttribute('src');
          viewerImage.alt = '';
          downloadButton.href = '#';
        };

        document.addEventListener('click', (event) => {
          const target = event.target?.closest?.('[data-image-viewer-target]');
          if (!target) return;

          const image = target.__viewerImage || target.querySelector('img');
          if (!image) return;

          event.preventDefault();
          event.stopPropagation();
          openViewer(image);
        });

        closeButton.addEventListener('click', closeViewer);

        overlay.addEventListener('click', (event) => {
          if (event.target === overlay || event.target === frame) {
            closeViewer();
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && !overlay.hidden) {
            closeViewer();
          }
        });
      })();
    </script>

  </body>
</html>
