---
import BaseLayout from '../layouts/BaseLayout.astro';

const gear = [
  {
    label: 'Микрофон',
    value: 'Warm Audio WA-87R2B',
    text: 'Запись всех чистовых исходников голоса.',
    image: '/assets/images/wa87.png',
  },
  {
    label: 'Контроль записи',
    value: 'Sony MDR-7506',
    text: 'Контроль голоса прямо во время записи у микрофона.',
    image: '/assets/images/sony7506.png',
  },
  {
    label: 'Сведение и пост-продакшн',
    value: 'Sennheiser HD 490 PRO',
    text: 'Основной инструмент для чистки дорожек, монтажа и сведения.',
    image: '/assets/images/s490pro.png',
  },
  {
    label: 'Финальный контроль',
    value: 'PreSonus Eris 3.5 2nd gen',
    text: 'Проверка готового звука без наушников перед сдачей проекта.',
    image: '/assets/images/eris.png',
  },
  {
    label: 'Аудиоинтерфейс',
    value: 'Arturia MiniFuse I',
    text: 'Внешняя звуковая карта для вывода звука без задержек.',
    image: '/assets/images/minifuse.png',
  },
  {
    label: 'Кабель',
    value: 'Zzcable G44-XLR-M-F-0300-Z',
    text: 'Микрофонный XLR-кабель (на базе Mogami 2582).',
    image: '/assets/images/cable.png',
  },
];
---

<BaseLayout title="Обо мне — Феофилакт Птахен">
  <main class="abv4-page">
    <section class="shell abv4-hero">
      <div class="abv4-hero-copy">
        <p class="page-kicker">Обо мне</p>
        <h1>Давайте знакомиться</h1>
        <p>
          Пу‌шкин Илья‌ Серге‌евич (псевд.: Феофила‌кт Птахе‌н,
          Камергер Пу‌шкин; род. 3 июня 2004 года, г. Гагарин,
          Смоленская область) — актёр озвучивания, звукорежиссёр и
          основатель неформального творческого объединения «ОВН»
          (Объект всеобщей ненависти). Более 3 лет непрерывной практики.
          Занимаюсь озвучиванием, локализацией, саунд-дизайном и перезаписью.
          Мой подход построен на чистой практике и реальных проектах.
        </p>

        <div class="abv4-hero-facts" aria-label="Кратко">
          <div>
            <span>Роль</span>
            <b>Актёр / Звукорежиссёр</b>
          </div>
          <div>
            <span>Практика</span>
            <b>3+ года</b>
          </div>
          <div>
            <span>Руководитель</span>
            <b>ОВН</b>
          </div>
        </div>
      </div>

      <figure class="abv4-photo abv4-main-photo">
        <img
          src="/assets/images/avatar_ptaxen_2.png"
          alt="Феофилакт Птахен"
          width="1440"
          height="1079"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    </section>

    <section class="shell abv4-project-row">
      <article class="abv4-project-text">
        <p class="abv4-label">Подход</p>
        <h2>Методология работы</h2>
        <p>
          Анализ исходника: разбор физического состояния персонажа 
          для подбора корректной механики звукоизвлечения. Запись: 
          работа у микрофона с упором на анатомический контроль 
          дыхания и связок. Техническая сборка: Вся основная работа 
          с исходниками — чистка, монтаж, усадка голоса в микс
        </p>
      </article>

      <figure
        class="abv4-photo abv4-logo-slot"
        tabindex="0"
        aria-label="Логотип ОВН — Объект всеобщей ненависти, мой проект"
        data-tooltip="«Объект всеобщей ненависти», мой проект."
      >
        <img
          src="/assets/images/ovnlogo.png"
          alt="ОВН — Объект всеобщей ненависти"
          width="640"
          height="640"
          loading="lazy"
          decoding="async"
          onerror="this.closest('.abv4-photo').classList.add('is-empty'); this.remove();"
        />
        <span>Логотип ОВН / фото проекта</span>
      </figure>
    </section>

    <section class="shell abv4-timeline">
      <div class="abv4-section-head">
        <p class="abv4-label">Хронология / опыт</p>
        <h2>Путь от первой записи к полному циклу.</h2>
      </div>

      <div class="abv4-timeline-layout">
        <figure class="abv4-timeline-photo">
          <img
            src="/assets/images/avatar_ptaxen_3.png"
            alt="Фото для хронологии"
            width="1086"
            height="1448"
            loading="lazy"
            decoding="async"
            onerror="this.closest('.abv4-timeline-photo').classList.add('is-empty'); this.remove();"
          />
          <span>Вертикальное фото / хронология</span>
        </figure>

        <div class="abv4-story-list">
          <article class="abv4-story-card">
            <aside>2023</aside>
            <div>
              <h3>Начало и первый проект</h3>
              <p>
                Начал свой путь в начале 2023 года. Отправной точкой стал
                отрывок из аниме «Монстр». Уже 9 февраля того же года основал
                и возглавил проект независимой озвучки «Объект Всеобщей
                Ненависти» — ОВН.
              </p>
            </div>
          </article>

          <article class="abv4-story-card">
            <aside>2024</aside>
            <div>
              <h3>Масштабирование</h3>
              <p>
                Расширил профиль и начал активнее продвигаться как актёр
                озвучивания и звукорежиссёр в фандаб-проектах. Параллельно
                начал работать над релизами в рамках сообщества «Мир Дунхуа
                Аниме» (первоначально в рамках проекта AniDoulo, с 2025 года
                как участник MDA). В этот период произошёл переход от работы 
                исключительно у микрофона к комплексному ведению проектов: звук, монтаж,
                оформление видеоряда и подготовка релиза.
              </p>
            </div>
          </article>

          <article class="abv4-story-card">
            <aside>2025 — <br /> наст. вр.</aside>
            <div>
              <h3>Полный цикл</h3>
              <p>
                Работа со звуком под ключ: дикторская запись, рекаст, дубляж,
                саунд-дизайн и калибровка финальных миксов. На выходе — не
                просто записанный голос, а чистый рабочий материал, который
                становится частью сцены.
              </p>
            </div>
          </article>
        </div>

      </div>
    </section>

    <section class="shell abv4-gear">
      <div class="abv4-section-head">
        <p class="abv4-label">Сетап / инструменты</p>
        <h2>Аппаратное обеспечение. <br /> Студийный сетап и мониторинг.</h2>
      </div>

      <div class="abv4-gear-layout">
        <div class="abv4-gear-grid">
          {gear.map((item) => (
            <article class="abv4-gear-card">
              <figure class="abv4-image-slot">
                <img
                  src={item.image}
                  alt={item.value}
                  width="900"
                  height="900"
                  loading="lazy"
                  decoding="async"
                  onerror="this.closest('.abv4-image-slot').classList.add('is-empty'); this.remove();"
                />
                <span>Фото</span>
              </figure>
              <div class="abv4-gear-info">
                <span>{item.label}</span>
                <h3>{item.value}</h3>
                <p>{item.text}</p>
              </div>
            </article>
          ))}
        </div>

        <article class="abv4-gear-note">
          <p class="abv4-label">Техническая база</p>
          <h3>Рабочий стандарт</h3>
          <p>
            Аппаратное обеспечение напрямую влияет на предсказуемость 
            результата.
          </p>
          <p>
            Здесь собран мой основной рабочий сетап. 
            Никакой витрины брендов — только инструменты, проверенные 
            на реальных задачах, которые обеспечивают чистый исходник 
            и честный мониторинг.
          </p>
        </article>
      </div>
    </section>
  </main>

  <style>
    .abv4-page {
      padding: 34px 0 52px;
    }

    .abv4-hero,
    .abv4-project-row,
    .abv4-timeline,
    .abv4-gear {
      border-bottom: 1px solid var(--line);
    }

    .abv4-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 430px;
      gap: 28px;
      align-items: stretch;
      padding-bottom: 28px;
    }

    .abv4-hero-copy {
      display: flex;
      flex-direction: column;
      min-height: 330px;
    }

    .abv4-hero h1 {
      margin: 0 0 16px;
      font-size: clamp(32px, 3.2vw, 36px);
      line-height: 1.08;
      font-weight: 900;
      letter-spacing: -0.04em;
    }

    .abv4-hero p,
    .abv4-project-text p:not(.abv4-label),
    .abv4-story-card p {
      margin: 0;
      color: var(--muted);
      font-size: 18px;
      line-height: 1.5;
    }

    .abv4-hero-facts {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
      margin-top: auto;
      padding-top: 22px;
    }

    .abv4-hero-facts div,
    .abv4-project-text,
    .abv4-story-card,
    .abv4-gear-card {
      border: 1px solid var(--line);
      border-radius: 16px;
      background: #101010;
    }

    .abv4-hero-facts div {
      min-height: 82px;
      padding: 16px;
    }

    .abv4-hero-facts span,
    .abv4-label,
    .abv4-gear-info span {
      display: block;
      margin: 0 0 8px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .abv4-hero-facts b {
      display: block;
      color: var(--text);
      font-size: 18px;
      line-height: 1.18;
      font-weight: 900;
      letter-spacing: -0.02em;
    }

    .abv4-photo,
    .abv4-image-slot,
    .abv4-timeline-photo {
      position: relative;
      display: grid;
      place-items: center;
      overflow: hidden;
      margin: 0;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: #101010;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.3;
      font-weight: 800;
      text-align: center;
    }

    .abv4-main-photo {
      min-height: 330px;
      aspect-ratio: 1440 / 1079;
    }

    .abv4-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .abv4-logo-slot img {
      width: 78%;
      height: 78%;
      object-fit: contain;
    }

    .abv4-logo-slot {
      cursor: help;
      outline: none;
    }

    .abv4-logo-slot::after {
      content: attr(data-tooltip);
      position: absolute;
      left: 50%;
      bottom: 18px;
      z-index: 5;
      width: min(300px, calc(100% - 28px));
      padding: 10px 12px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 10px;
      background: rgba(8, 8, 8, 0.94);
      color: #fff;
      font-size: 13px;
      line-height: 1.35;
      font-weight: 700;
      text-align: left;
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.35);
      opacity: 0;
      pointer-events: none;
      transform: translate(-50%, 8px);
      transition: opacity 0.16s ease, transform 0.16s ease;
    }

    .abv4-logo-slot:hover::after,
    .abv4-logo-slot:focus-visible::after {
      opacity: 1;
      transform: translate(-50%, 0);
    }

    .abv4-photo span,
    .abv4-image-slot span,
    .abv4-timeline-photo span {
      display: none;
      padding: 18px;
    }

    .abv4-photo.is-empty span,
    .abv4-image-slot.is-empty span,
    .abv4-timeline-photo.is-empty span {
      display: block;
    }

    .abv4-project-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 310px;
      gap: 14px;
      padding: 24px 0;
    }

    .abv4-project-text {
      padding: 22px;
    }

    .abv4-project-text h2,
    .abv4-section-head h2 {
      max-width: 780px;
      margin: 0 0 12px;
      font-size: clamp(28px, 3vw, 30px);
      line-height: 1.12;
      font-weight: 900;
      letter-spacing: -0.04em;
    }

    .abv4-logo-slot {
      min-height: 230px;
      aspect-ratio: 310 / 230;
    }

    .abv4-timeline {
      padding: 30px 0 28px;
    }

    .abv4-section-head {
      margin-bottom: 18px;
    }

    .abv4-timeline-layout {
      display: grid;
      grid-template-columns: 360px minmax(0, 1fr);
      gap: 14px;
      align-items: stretch;
    }

    .abv4-story-list {
      display: grid;
      gap: 12px;
    }

    .abv4-story-card {
      display: grid;
      grid-template-columns: 132px minmax(0, 1fr);
      gap: 0px;
      align-items: start;
      padding: 18px 20px;
    }

    .abv4-story-card aside {
      color: var(--muted);
      font-size: 18px;
      line-height: 1.35;
      font-weight: 900;
    }

    .abv4-story-card h3 {
      margin: 0 0 8px;
      font-size: 24px;
      line-height: 1.12;
      font-weight: 900;
      letter-spacing: -0.03em;
    }

    .abv4-timeline-photo {
      min-height: 100%;
      height: 100%;
      border-radius: 16px;
      background: #151515;
    }

    .abv4-timeline-photo img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .abv4-gear {
      padding: 30px 0 0;
      border-bottom: none;
    }

    .abv4-gear-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 16px;
      align-items: stretch;
    }

    .abv4-gear-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(3, minmax(0, 1fr));
      gap: 10px;
      align-items: stretch;
      height: 100%;
    }

    .abv4-gear-card {
      display: grid;
      grid-template-columns: 112px minmax(0, 1fr);
      gap: 15px;
      align-items: center;
      min-height: 0;
      padding: 12px 16px;
      border-radius: 16px;
      background: #101010;
      align-self: stretch;
    }

    .abv4-image-slot {
      width: 112px;
      aspect-ratio: 1 / 1;
      min-height: 0;
      border-radius: 12px;
      background: #f4f4f4;
    }

    .abv4-image-slot img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
      padding: 8px;
    }

    .abv4-image-slot.is-empty {
      background: #151515;
    }

    .abv4-gear-info {
      min-width: 0;
      transform: translateY(1px);
    }

    .abv4-gear-info span {
      margin-bottom: 4px;
      font-size: 13px;
      letter-spacing: 0.16em;
    }

    .abv4-gear-info h3 {
      margin: 0 0 4px;
      font-size: 19px;
      line-height: 1.16;
      font-weight: 900;
      letter-spacing: -0.025em;
    }

    .abv4-gear-info p {
      margin: 0;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.32;
    }

    .abv4-gear-note {
      min-height: 0;
      padding: 18px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: #101010;
      align-self: stretch;
    }

    .abv4-gear-note h3 {
      margin: 0 0 12px;
      color: var(--text);
      font-size: 28px;
      line-height: 1.08;
      font-weight: 900;
      letter-spacing: -0.04em;
    }

    .abv4-gear-note p:not(.abv4-label) {
      margin: 0;
      color: var(--muted);
      font-size: 18px;
      line-height: 1.45;
    }

    .abv4-gear-note p + p {
      margin-top: 10px;
    }

    @media (max-width: 1000px) {
      .abv4-hero,
      .abv4-project-row {
        grid-template-columns: 1fr;
      }

      .abv4-hero-copy {
        min-height: 0;
      }

      .abv4-hero-facts {
        margin-top: 22px;
      }

      .abv4-main-photo {
        min-height: 360px;
      }

      .abv4-timeline-layout {
        grid-template-columns: 1fr;
      }

      .abv4-story-card {
        grid-template-columns: 120px minmax(0, 1fr);
      }

      .abv4-timeline-photo {
        min-height: 320px;
      }

      .abv4-gear-layout {
        grid-template-columns: 1fr;
      }

      .abv4-gear-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .abv4-gear-note {
        min-height: auto;
      }

      .abv4-gear-grid {
        height: auto;
        grid-template-rows: none;
      }
    }

    @media (max-width: 700px) {
      .abv4-page {
        padding: 30px 0 42px;
      }

      .abv4-hero-facts,
      .abv4-gear-grid {
        grid-template-columns: 1fr;
      }

      .abv4-story-card {
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .abv4-timeline-photo {
        min-height: 260px;
      }

      .abv4-image-slot {
        aspect-ratio: 1 / 1;
      }
    }

    /* Unified top typography override */
    .abv4-page {
      padding-top: 34px !important;
    }

    .abv4-hero .page-kicker {
      margin: 0 0 14px !important;
      color: var(--muted) !important;
      font-size: 14px !important;
      line-height: 1.2 !important;
      font-weight: 800 !important;
      letter-spacing: 0.18em !important;
      text-transform: uppercase !important;
      font-family: Roboto, Arial, sans-serif !important;
    }

    .abv4-hero h1 {
      font-family: Roboto, Arial, sans-serif !important;
      font-size: 36px !important;
      line-height: 1.08 !important;
      font-weight: 900 !important;
      letter-spacing: -0.045em !important;
      margin: 0 0 14px !important;
    }

  </style>
</BaseLayout>
