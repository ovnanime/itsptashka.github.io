- /public/assets/images/posters/ed/Суперчудаки.png
-->
<BaseLayout title="Портфолио — Феофилакт Птахен">
  <section class="shell portfolio-redesign">
    <header class="portfolio-head">
      <p class="portfolio-kicker">Работы</p>
      <h1>Портфолио</h1>
      <p>
        Деморил по направлениям, релизы по студиям и авторский уголок. <br />
        Всё компактно: без лишней витрины, дублей и перегруженных кейсов.
      </p>
    </header>

    <nav class="portfolio-tabs" aria-label="Разделы портфолио">
      <button class="active" type="button" data-tab="demo">Деморил</button>
      <button type="button" data-tab="releases">Релизы</button>
      <button type="button" data-tab="author">Авторский уголок</button>
    </nav>

    <div class="portfolio-panel active" data-panel="demo">
      <div class="demo-grid">
        {
          demoCards.map((card) => (
            <article class={`demo-card ${card.video ? 'has-video' : ''}`}>
              {
                card.video ? (
                  <button
                    class="demo-video-launch"
                    type="button"
                    data-demo-video={card.video}
                    data-demo-title={card.title}
                    data-demo-text={card.text}
                    aria-label={`Открыть демо: ${card.title}`}
                  >
                    <span class="demo-video-preview">
                      <video
                        src={card.video}
                        preload="metadata"
                        muted
                        playsinline
                      ></video>
                      <span class="demo-video-shade"></span>
                      <span class="demo-video-play" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                          <path d="M9 7.5v9l7-4.5-7-4.5Z"></path>
                        </svg>
                      </span>
                    </span>
                    <span class="demo-video-open">Смотреть демо</span>
                  </button>
                ) : (
                  <div class="demo-placeholder">
                    <span>Скоро...</span>
                  </div>
                )
              }
              <div class="demo-card-meta">
                <h3>{card.title}</h3>
                <p>{card.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <div class="portfolio-panel" data-panel="releases">
      <div class="roles-filter-redesign" aria-label="Фильтр релизов по роли">
        <span class="roles-filter-label">Фильтр</span>

        <button
          class="role-legend-item"
          type="button"
          data-role-filter="voice"
          aria-pressed="false"
          data-tooltip="Показать релизы, где была актёрская работа: персонажи, дикторский текст, закадр."
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={renderIcon('voice')}></svg>
          Озвучивание
        </button>

        <button
          class="role-legend-item"
          type="button"
          data-role-filter="sound"
          aria-pressed="false"
          data-tooltip="Показать релизы, где была работа со звуком: монтаж, чистка, сведение и подготовка материала."
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={renderIcon('sound')}></svg>
          Звукорежиссура
        </button>

        <button
          class="legend-dub role-legend-item"
          type="button"
          data-role-filter="dub"
          aria-pressed="false"
          data-tooltip="Показать релизы, где был полноценный дубляж."
        >
          Дубляж
        </button>
      </div>

      <section class="studio-section-redesign" data-studio-section>
        <h2>MDA</h2>
        <div class="release-grid-redesign">
          {
            mdaProjects.map((project) => (
              <article class="release-card-redesign" data-release-card data-roles={project.roles.join(' ')}>
                <div class="release-badges-redesign">
                  {
                    project.roles.includes('voice') && (
                      <span title="Озвучивание">
                        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={renderIcon('voice')}></svg>
                      </span>
                    )
                  }
                  {
                    project.roles.includes('sound') && (
                      <span title="Звукорежиссура">
                        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={renderIcon('sound')}></svg>
                      </span>
                    )
                  }
                </div>

                {
                  project.roles.includes('dub') && (
                    <span class="dub-label">Дубляж</span>
                  )
                }

                <a href={project.link} target="_blank" rel="noreferrer">
                  <img src={project.img} alt={project.title} loading="lazy" />
                  <span class="release-hover">
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={renderIcon('link')}></svg>
                  </span>
                </a>

                <h3>{project.title}</h3>
              </article>
            ))
          }
        </div>
      </section>



      <section class="studio-section-redesign" data-studio-section>
        <h2>Ушастая озвучка</h2>
        <div class="release-grid-redesign">
          {
            edProjects.map((project) => (
              <article class="release-card-redesign" data-release-card data-roles={project.roles.join(' ')}>
