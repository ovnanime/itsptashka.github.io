<script type="module">
  import WaveSurfer from 'https://unpkg.com/wavesurfer.js@7/dist/wavesurfer.esm.js';
  document.addEventListener('DOMContentLoaded', () => {
    const waveformEl = document.getElementById('waveform-portfolio');
    
    if (waveformEl && waveformEl.dataset.initialized !== 'true') {
      const playBtn = document.getElementById('wave-play-btn');
      const playIcon = document.getElementById('wave-play-icon');
      const audioSwitch = document.getElementById('audio-switch');
      const volumeSlider = document.getElementById('volume-slider');
      const labelRaw = document.getElementById('label-raw');
      const labelProcessed = document.getElementById('label-processed');
      
      const wavesurfer = WaveSurfer.create({
        container: '#waveform-portfolio',
        waveColor: '#4b5563',
        progressColor: '#ffffff',
        height: 45,
        barWidth: 2,
        normalize: true,
      });

      wavesurfer.load('/assets/audio/voice_demo.flac');
      waveformEl.dataset.initialized = 'true';

      playBtn.addEventListener('click', () => wavesurfer.playPause());
      wavesurfer.on('play', () => playIcon.setAttribute('name', 'pause'));
      wavesurfer.on('pause', () => playIcon.setAttribute('name', 'play'));
      volumeSlider.addEventListener('input', (e) => {
        wavesurfer.setVolume(parseFloat(e.target.value));
      });
      audioSwitch.addEventListener('change', (e) => {
        const isProcessed = e.target.checked;
        const time = wavesurfer.getCurrentTime();
        const playing = wavesurfer.isPlaying();
        
        if (isProcessed) {
          labelProcessed.classList.add('active');
          labelRaw.classList.remove('active');
        } else {
          labelRaw.classList.add('active');
          labelProcessed.classList.remove('active');
        }

        wavesurfer.load(isProcessed ? '/assets/audio/voice_demo.flac' : '/assets/audio/voice_demo_raw.flac');
        
        wavesurfer.once('ready', () => {
          wavesurfer.setTime(time);
          if (playing) wavesurfer.play();
        });
      });
    }
  });
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    
    const checkActiveFilter = () => {
      const activeBtn = document.querySelector('.filter-list [data-filter-btn].active');
      if (!activeBtn) {
        const firstBtn = document.querySelector('.filter-list [data-filter-btn]');
        if (firstBtn) firstBtn.classList.add('active');
      }
    };
    checkActiveFilter();
    document.querySelectorAll('.navbar-link').forEach(link => {
      link.addEventListener('click', () => setTimeout(checkActiveFilter, 50));
    });

    const video = document.getElementById('main-showreel-video');
    const sourceEl = document.getElementById('main-video-source');
    const playlistItems = document.querySelectorAll('.playlist-item');

    if (video && playlistItems.length > 0) {
      playlistItems.forEach(item => {
        item.addEventListener('click', () => {
          playlistItems.forEach(btn => btn.classList.remove('active'));
          item.classList.add('active');

          const newVideo = item.getAttribute('data-video');
          const newPoster = item.getAttribute('data-poster');

          video.pause();
          sourceEl.setAttribute('src', newVideo);
          video.setAttribute('poster', newPoster);
          video.load();
        });
      });
    }

    const grids = document.querySelectorAll('.paginated-grid-wrapper');
    grids.forEach(wrapper => {
      const grid = wrapper.querySelector('.projects-grid');
      const cards = Array.from(grid.querySelectorAll('.movie-card'));
      const paginationContainer = wrapper.querySelector('.pagination-controls');
      let currentPage = 1;

      function getItemsPerPage() {
        const width = window.innerWidth;
        if (width >= 1024) return 10; 
        if (width >= 768) return 8;   
        return 4;                      
      }

      function updatePagination() {
        const itemsPerPage = getItemsPerPage();
        const totalPages = Math.ceil(cards.length / itemsPerPage);

        wrapper.querySelectorAll('.ghost-card').forEach(el => el.remove());

        if (totalPages <= 1) {
          paginationContainer.style.display = 'none';
          wrapper.style.marginBottom = '50px';
          cards.forEach(card => card.style.display = 'block');
          return;
        }

        paginationContainer.style.display = 'flex';
        wrapper.style.marginBottom = '0';
        if (currentPage > totalPages) currentPage = totalPages;

        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        let visibleCount = 0;
        cards.forEach((card, index) => {
          if (index >= start && index < end) {
            card.style.display = 'block';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        const emptySlots = itemsPerPage - visibleCount;
        for (let i = 0; i < emptySlots; i++) {
          const ghost = document.createElement('div');
          ghost.className = 'movie-card ghost-card';
          ghost.innerHTML = `
            <div class="movie-poster-link ghost-poster"></div>
            <h4 class="movie-title" style="visibility: hidden;">&nbsp;<br>&nbsp;</h4>
          `;
          grid.appendChild(ghost);
        }

        paginationContainer.innerHTML = '';
        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement('button');
          btn.className = `page-num-btn ${i === currentPage ? 'active' : ''}`;
          btn.textContent = i;
          btn.addEventListener('click', () => {
            currentPage = i;
            updatePagination(); 
          });
          paginationContainer.appendChild(btn);
        }
      }

      updatePagination();
      
      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(updatePagination, 150);
      });
    });
  });
</script>