        font-size: 19px;
      }

      .author-book-go {
        grid-column: 2;
        justify-self: start;
        height: 36px;
      }
    }
  </style>

  <script is:inline data-astro-rerun>
    (() => {
      const initAuthorSearch = () => {
        const authorList = document.querySelector('[data-author-list]');
        const authorRows = [...document.querySelectorAll('.author-row')];
        const authorSearch = document.querySelector('[data-author-search]');
        const authorSearchButton = document.querySelector('[data-author-search-button]');
        const authorType = document.querySelector('[data-author-type]');
        const authorSort = document.querySelector('[data-author-sort]');
        const authorEmpty = document.querySelector('[data-author-empty]');

        if (!authorList || !authorRows.length) return;

        const normalize = (value) =>
          String(value || '')
            .toLowerCase()
            .replace(/ё/g, 'е')
            .trim();

        const updateAuthorList = () => {
          const query = normalize(authorSearch?.value);
          const type = authorType?.value || 'all';
          const sort = authorSort?.value || 'new';

          const sortedRows = [...authorRows].sort((a, b) => {
            const titleA = normalize(a.dataset.title);
            const titleB = normalize(b.dataset.title);

            if (sort === 'az') return titleA.localeCompare(titleB, 'ru');
            if (sort === 'za') return titleB.localeCompare(titleA, 'ru');
            if (sort === 'old') return new Date(a.dataset.date) - new Date(b.dataset.date);

            return new Date(b.dataset.date) - new Date(a.dataset.date);
          });

          sortedRows.forEach((row) => authorList.appendChild(row));

          let visibleCount = 0;

          authorRows.forEach((row) => {
            const searchText = normalize(row.dataset.search);
            const rowType = row.dataset.type;
            const matchesQuery = !query || searchText.includes(query);
            const matchesType = type === 'all' || rowType === type;
            const visible = matchesQuery && matchesType;

            row.classList.toggle('is-hidden', !visible);

            if (visible) visibleCount += 1;
          });

          if (authorEmpty) {
            authorEmpty.hidden = visibleCount !== 0;
          }
        };

        authorSearch?.addEventListener('input', updateAuthorList);
        authorSearch?.addEventListener('search', updateAuthorList);
        authorSearchButton?.addEventListener('click', updateAuthorList);
        authorType?.addEventListener('change', updateAuthorList);
        authorSort?.addEventListener('change', updateAuthorList);

        updateAuthorList();
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAuthorSearch);
      } else {
        initAuthorSearch();
      }
    })();
  </script>


  <script is:inline data-astro-rerun>
    (() => {
      const dialog = document.querySelector('[data-release-dialog]');
      if (!dialog) return;

      const ROLE_NAMES = { voice: 'Актёр озвучивания', sound: 'Звукорежиссёр' };
      const poster = dialog.querySelector('[data-release-poster]');
      const studio = dialog.querySelector('[data-release-studio]');
      const title = dialog.querySelector('[data-release-title]');
      const roles = dialog.querySelector('[data-release-roles]');
      const watch = dialog.querySelector('[data-release-watch]');
      const watchLabel = dialog.querySelector('[data-release-watch-label]');
      const dubBadge = dialog.querySelector('[data-release-dub]');
      let opener = null;

      document.querySelectorAll('[data-release-open]').forEach((button) => {
        button.addEventListener('click', () => {
          const card = button.closest('[data-release-card]');
          const href = button.dataset.href || '';
          const partner = button.dataset.partner === 'tvoe' ? ' · для TVOË' : '';

          poster.src = button.dataset.img || '';
          poster.alt = button.dataset.title || '';
          title.textContent = button.dataset.title || '';
          const roleList = (card?.dataset.roles || '').split(' ').filter(Boolean);
          studio.textContent = (button.closest('[data-studio-section]')?.querySelector('h2')?.textContent || '') + partner;
          // Дубляж — формат сведения релиза, а не должность: бейдж под названием.
          dubBadge.hidden = !roleList.includes('dub');
          roles.replaceChildren(...roleList.filter((role) => ROLE_NAMES[role]).map((role) => {
            const item = document.createElement('li');
            item.textContent = ROLE_NAMES[role];
            return item;
          }));

          watch.hidden = !href;
          if (href) {
            watch.href = href;
            watchLabel.textContent = href.includes('tvoe.live') ? 'Смотреть в TVOË' : 'Смотреть на Rutube';
          }

          opener = button;
          dialog.showModal();
        });
      });

      dialog.querySelector('[data-release-close]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener('close', () => {
        opener?.focus();
        opener = null;
      });
    })();
  </script>


</BaseLayout>
