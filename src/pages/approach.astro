---
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
  {
    number: '01',
    label: 'Разбор персонажа',
    title: 'От текста к образу',
    text:
      'Сначала оцениваю сцену: состояние персонажа, контекст, визуал и скрытое намерение. Не ищу шаблон — собираю живую версию голоса под конкретный момент.',
  },
  {
    number: '02',
    label: 'Запись',
    title: 'Поиск звука',
    text:
      'У микрофона не выдавливаю эмоцию искусственно. Ищу подачу, которая ложится на картинку: дыхание, темп, напряжение, паузы и характер персонажа.',
  },
  {
    number: '03',
    label: 'Сборка',
    title: 'Сведение и контроль',
    text:
      'После записи идёт чистка, монтаж и посадка голоса в микс. Финальная проверка — не только в наушниках, но и на мониторах, чтобы звук оставался рабочим вне студии.',
  },
];
---

<BaseLayout
  title="Подход — Феофилакт Птахен"
  description="Процесс работы с голосом и звуком: запись, монтаж, чистка, сведение и подготовка материала к релизу."
>
  <div class="approach-page">
    <section class="shell approach-hero">
      <div class="approach-hero-copy">
        <p class="approach-label">Метод работы</p>
        <h1>Голос начинается раньше звука.</h1>
        <p>
          Для меня озвучка начинается не с красивой интонации, а с причины:
          что персонаж хочет, что скрывает и почему говорит именно так.
        </p>
      </div>
    </section>

    <section class="shell approach-steps" aria-label="Этапы работы">
      {steps.map((step) => (
        <article class="approach-card">
          <div class="approach-card-index">
            <span>{step.number}</span>
            <b>{step.label}</b>
          </div>

          <div class="approach-card-body">
            <h2>{step.title}</h2>
            <p>{step.text}</p>
          </div>
        </article>
      ))}
    </section>
  </div>

  <style>

    :global(html),
    :global(body) {
      min-height: 100%;
    }

    :global(body) {
      display: flex;
      min-height: 100dvh;
      flex-direction: column;
    }

    :global(body > header.site-header) {
      flex-shrink: 0;
    }

    :global(body > main) {
      flex: 1 0 auto;
    }

    :global(body > footer.site-footer) {
      flex-shrink: 0;
      margin-top: auto !important;
    }

    .approach-page {
      padding: 34px 0 0;
    }

    .approach-hero {
      display: block;
      padding-bottom: 18px;
      border-bottom: 1px solid var(--line);
    }

    .approach-hero-copy {
      max-width: 760px;
    }

    .approach-label,
    .approach-card-index b {
      display: block;
      margin: 0 0 14px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .approach-hero h1 {
      max-width: 760px;
      margin: 0 0 14px;
      color: var(--text);
      font-size: clamp(34px, 4vw, 36px);
      line-height: 1.04;
      font-weight: 900;
      letter-spacing: -0.055em;
    }

    .approach-hero-copy > p:last-child {
      max-width: 680px;
      margin: 0;
      color: var(--muted);
      font-size: 18px;
      line-height: 1.48;
    }

    .approach-steps {
      display: grid;
      gap: 14px;
      padding-top: 18px;
    }

    .approach-card {
      display: grid;
      grid-template-columns: 178px minmax(0, 1fr);
      gap: 24px;
      align-items: stretch;
      padding: 20px 22px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: #101010;
    }

    .approach-card-index {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 136px;
      padding-right: 20px;
      border-right: 1px solid var(--line);
    }

    .approach-card-index span {
      color: #fff;
      font-size: 42px;
      line-height: 0.9;
      font-weight: 900;
      letter-spacing: -0.07em;
      opacity: 0.92;
    }

    .approach-card-index b {
      max-width: 130px;
      margin: 0;
      line-height: 1.35;
    }

    .approach-card-body {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 136px;
    }

    .approach-card-body h2 {
      margin: 0 0 12px;
      color: var(--text);
      font-size: clamp(26px, 2.7vw, 34px);
      line-height: 1.08;
      font-weight: 900;
      letter-spacing: -0.045em;
    }

    .approach-card-body p {
      max-width: 900px;
      margin: 0;
      color: var(--muted);
      font-size: 18px;
      line-height: 1.55;
    }

    @media (max-width: 900px) {
      .approach-card {
        grid-template-columns: 130px minmax(0, 1fr);
      }

      .approach-card-index {
        min-height: 120px;
      }
    }

    @media (max-width: 640px) {
      .approach-page {
        padding: 28px 0 0;
      }

      .approach-hero h1 {
        font-size: 34px;
      }

      .approach-hero-copy > p:last-child,
      .approach-card-body p {
        font-size: 16px;
      }

      .approach-card {
        grid-template-columns: 1fr;
        gap: 14px;
      }

      .approach-card-index {
        min-height: auto;
        padding-right: 0;
        padding-bottom: 14px;
        border-right: 0;
        border-bottom: 1px solid var(--line);
      }

      .approach-card-index span {
        font-size: 34px;
      }

      .approach-card-body {
        min-height: auto;
      }
    }

    /* Unified top typography override */
    .approach-page {
      padding-top: 34px !important;
    }

    .approach-label {
      margin: 0 0 14px !important;
      color: var(--muted) !important;
      font-size: 14px !important;
      line-height: 1.2 !important;
      font-weight: 800 !important;
      letter-spacing: 0.18em !important;
      text-transform: uppercase !important;
      font-family: Roboto, Arial, sans-serif !important;
    }

    .approach-hero h1 {
      font-family: Roboto, Arial, sans-serif !important;
      font-size: 36px !important;
      line-height: 1.08 !important;
      font-weight: 900 !important;
      letter-spacing: -0.045em !important;
      margin: 0 0 14px !important;
    }


    /* More air for approach cards after Roboto unification */
    .approach-steps {
      gap: 14px !important;
      padding-top: 18px !important;
    }

    .approach-card {
      grid-template-columns: 178px minmax(0, 1fr) !important;
      gap: 24px !important;
      padding: 20px 22px !important;
    }

    .approach-card-index,
    .approach-card-body {
      min-height: 136px !important;
    }

    .approach-card-index {
      padding-right: 20px !important;
    }

    .approach-card-body h2 {
      margin-bottom: 12px !important;
    }

    .approach-card-body p {
      line-height: 1.55 !important;
    }

  
    /* ======================================================================
       APPROACH MOBILE — stack card content instead of squeezing the text
       ====================================================================== */

    @media (max-width: 720px) {
      .approach-card,
      .method-card,
      .process-card {
        display: grid !important;
        grid-template-columns: 1fr !important;
        grid-template-areas:
          "number"
          "content"
          "label" !important;
        gap: 18px !important;
        min-height: 0 !important;
        padding: 24px 22px !important;
      }

      .approach-card-number,
      .method-card-number,
      .process-card-number,
      .approach-step,
      .method-step {
        grid-area: number !important;
        position: static !important;
        width: auto !important;
        margin: 0 !important;
        font-size: 42px !important;
        line-height: 1 !important;
      }

      .approach-card-content,
      .method-card-content,
      .process-card-content,
      .approach-card-main,
      .method-card-main {
        grid-area: content !important;
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .approach-card-content h2,
      .approach-card-content h3,
      .method-card-content h2,
      .method-card-content h3,
      .process-card-content h2,
      .process-card-content h3,
      .approach-card-main h2,
      .approach-card-main h3,
      .method-card-main h2,
      .method-card-main h3 {
        width: 100% !important;
        max-width: none !important;
        margin: 0 0 12px !important;
        font-size: 27px !important;
        line-height: 1.08 !important;
      }

      .approach-card-content p,
      .method-card-content p,
      .process-card-content p,
      .approach-card-main p,
      .method-card-main p {
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        font-size: 16px !important;
        line-height: 1.5 !important;
      }

      .approach-card-label,
      .method-card-label,
      .process-card-label,
      .approach-card-tag,
      .method-card-tag {
        grid-area: label !important;
        position: static !important;
        width: 100% !important;
        margin: 4px 0 0 !important;
        padding-top: 16px !important;
        border-top: 1px solid rgba(255,255,255,0.1) !important;
      }
    }

  
    /* ======================================================================
       APPROACH MOBILE V2 — compact top row and full-width content
       ====================================================================== */

    @media (max-width: 720px) {
      .approach-card,
      .method-card,
      .process-card {
        display: grid !important;
        grid-template-columns: auto minmax(0, 1fr) !important;
        grid-template-areas:
          "number label"
          "content content" !important;
        gap: 18px 20px !important;
        min-height: 0 !important;
        padding: 22px 20px 24px !important;
        align-items: start !important;
      }

      .approach-card-number,
      .method-card-number,
      .process-card-number,
      .approach-step,
      .method-step {
        grid-area: number !important;
        position: static !important;
        margin: 0 !important;
        align-self: center !important;
        font-size: 38px !important;
        line-height: 1 !important;
      }

      .approach-card-label,
      .method-card-label,
      .process-card-label,
      .approach-card-tag,
      .method-card-tag {
        grid-area: label !important;
        position: static !important;
        width: auto !important;
        margin: 0 !important;
        padding: 0 !important;
        border: 0 !important;
        align-self: center !important;
        justify-self: end !important;
        text-align: right !important;
      }

      .approach-card-content,
      .method-card-content,
      .process-card-content,
      .approach-card-main,
      .method-card-main {
        grid-area: content !important;
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 18px 0 0 !important;
        border-top: 1px solid rgba(255,255,255,0.1) !important;
      }

      .approach-card-content h2,
      .approach-card-content h3,
      .method-card-content h2,
      .method-card-content h3,
      .process-card-content h2,
      .process-card-content h3,
      .approach-card-main h2,
      .approach-card-main h3,
      .method-card-main h2,
      .method-card-main h3 {
        margin: 0 0 10px !important;
        font-size: 25px !important;
        line-height: 1.1 !important;
      }

      .approach-card-content p,
      .method-card-content p,
      .process-card-content p,
      .approach-card-main p,
      .method-card-main p {
        margin: 0 !important;
        font-size: 15px !important;
        line-height: 1.52 !important;
      }
    }

    @media (max-width: 390px) {
      .approach-card,
      .method-card,
      .process-card {
        gap: 16px !important;
        padding: 20px 18px 22px !important;
      }

      .approach-card-number,
      .method-card-number,
      .process-card-number,
      .approach-step,
      .method-step {
        font-size: 34px !important;
      }

      .approach-card-content h2,
      .approach-card-content h3,
      .method-card-content h2,
      .method-card-content h3,
      .process-card-content h2,
      .process-card-content h3,
      .approach-card-main h2,
      .approach-card-main h3,
      .method-card-main h2,
      .method-card-main h3 {
        font-size: 23px !important;
      }
    }

  
    /* ======================================================================
       APPROACH MOBILE — balance only the first card
       ====================================================================== */

    @media (max-width: 720px) {
      .approach-card:first-child {
        grid-template-columns: 132px minmax(0, 1fr) !important;
        gap: 16px !important;
      }

      .approach-card:first-child .approach-card-index {
        padding-right: 14px !important;
      }
    }

    @media (max-width: 390px) {
      .approach-card:first-child {
        grid-template-columns: 118px minmax(0, 1fr) !important;
        gap: 14px !important;
      }

      .approach-card:first-child .approach-card-index {
        padding-right: 12px !important;
      }
    }

  
    /* ======================================================================
       APPROACH MOBILE — smaller left labels/numbers and footer breathing room
       ====================================================================== */

    @media (max-width: 720px) {
      .approach-card-number,
      .method-card-number,
      .process-card-number,
      .approach-step,
      .method-step {
        font-size: 32px !important;
        line-height: 1 !important;
      }

      .approach-card-label,
      .method-card-label,
      .process-card-label,
      .approach-card-tag,
      .method-card-tag {
        font-size: 11px !important;
        line-height: 1.35 !important;
        letter-spacing: 0.13em !important;
      }

      .approach-card:first-child {
        grid-template-columns: 112px minmax(0, 1fr) !important;
        gap: 14px !important;
      }

      .approach-page,
      .approach-main,
      main:has(.approach-card) {
        padding-bottom: 54px !important;
      }
    }

    @media (max-width: 390px) {
      .approach-card-number,
      .method-card-number,
      .process-card-number,
      .approach-step,
      .method-step {
        font-size: 29px !important;
      }

      .approach-card-label,
      .method-card-label,
      .process-card-label,
      .approach-card-tag,
      .method-card-tag {
        font-size: 10px !important;
      }

      .approach-card:first-child {
        grid-template-columns: 102px minmax(0, 1fr) !important;
        gap: 12px !important;
      }

      .approach-page,
      .approach-main,
      main:has(.approach-card) {
        padding-bottom: 46px !important;
      }
    }

  
    /* ======================================================================
       APPROACH MOBILE — slightly smaller left label in first card only
       ====================================================================== */

    @media (max-width: 720px) {
      .approach-card:first-child .approach-card-label,
      .approach-card:first-child .approach-card-tag,
      .approach-card:first-child .method-card-label,
      .approach-card:first-child .method-card-tag {
        font-size: 9.5px !important;
        letter-spacing: 0.11em !important;
        line-height: 1.3 !important;
      }
    }

    @media (max-width: 390px) {
      .approach-card:first-child .approach-card-label,
      .approach-card:first-child .approach-card-tag,
      .approach-card:first-child .method-card-label,
      .approach-card:first-child .method-card-tag {
        font-size: 9px !important;
      }
    }

  
    /* ======================================================================
       APPROACH MOBILE — reduce the actual left text in the first card
       ====================================================================== */

    @media (max-width: 720px) {
      .approach-card:first-child .approach-card-index b {
        font-size: 11px !important;
        line-height: 1.28 !important;
        letter-spacing: 0.13em !important;
      }
    }

    @media (max-width: 390px) {
      .approach-card:first-child .approach-card-index b {
        font-size: 10px !important;
      }
    }

  
    /* ======================================================================
       APPROACH MOBILE — unify all left labels
       ====================================================================== */

    @media (max-width: 720px) {
      .approach-card .approach-card-index b {
        font-size: 11px !important;
        line-height: 1.28 !important;
        letter-spacing: 0.13em !important;
      }
    }

    @media (max-width: 390px) {
      .approach-card .approach-card-index b {
        font-size: 10px !important;
      }
    }

  
    /* ======================================================================
       APPROACH MOBILE — slightly smaller numbers, slightly larger left labels
       ====================================================================== */

    @media (max-width: 720px) {
      .approach-card .approach-card-index span {
        font-size: 30px !important;
        line-height: 1 !important;
      }

      .approach-card .approach-card-index b {
        font-size: 12px !important;
        line-height: 1.3 !important;
        letter-spacing: 0.13em !important;
      }
    }

    @media (max-width: 390px) {
      .approach-card .approach-card-index span {
        font-size: 27px !important;
      }

      .approach-card .approach-card-index b {
        font-size: 11px !important;
      }
    }

  
    /* ======================================================================
       APPROACH MOBILE — slightly larger text under the numbers
       ====================================================================== */

    @media (max-width: 720px) {
      .approach-card .approach-card-index b {
        font-size: 13px !important;
      }
    }

    @media (max-width: 390px) {
      .approach-card .approach-card-index b {
        font-size: 12px !important;
      }
    }

  
    /* ======================================================================
       APPROACH MOBILE — clearly larger text under the numbers
       ====================================================================== */

    @media (max-width: 720px) {
      .approach-card .approach-card-index b {
        font-size: 15px !important;
        line-height: 1.32 !important;
      }
    }

    @media (max-width: 390px) {
      .approach-card .approach-card-index b {
        font-size: 14px !important;
      }
    }

  

    /* ======================================================================
       APPROACH MOBILE — shift cards 2 and 3 text to the right to match card 1
       ====================================================================== */

    @media (max-width: 720px) {
      .approach-card:nth-child(2),
      .approach-card:nth-child(3) {
        grid-template-columns: 112px minmax(0, 1fr) !important;
        gap: 14px !important;
      }

      .approach-card:nth-child(2) .approach-card-index,
      .approach-card:nth-child(3) .approach-card-index {
        padding-right: 14px !important;
      }
    }

    @media (max-width: 390px) {
      .approach-card:nth-child(2),
      .approach-card:nth-child(3) {
        grid-template-columns: 102px minmax(0, 1fr) !important;
        gap: 12px !important;
      }

      .approach-card:nth-child(2) .approach-card-index,
      .approach-card:nth-child(3) .approach-card-index {
        padding-right: 12px !important;
      }
    }

  
    /* ======================================================================
       APPROACH MOBILE — first label exactly matches labels 2 and 3
       ====================================================================== */

    @media (max-width: 720px) {
      .approach-card:first-child .approach-card-index b,
      .approach-card:nth-child(2) .approach-card-index b,
      .approach-card:nth-child(3) .approach-card-index b {
        font-size: 15px !important;
        line-height: 1.32 !important;
        letter-spacing: 0.13em !important;
      }
    }

    @media (max-width: 390px) {
      .approach-card:first-child .approach-card-index b,
      .approach-card:nth-child(2) .approach-card-index b,
      .approach-card:nth-child(3) .approach-card-index b {
        font-size: 14px !important;
      }
    }

  
    /* ======================================================================
       APPROACH MOBILE — medium label size under all numbers
       ====================================================================== */

    @media (max-width: 720px) {
      .approach-card:first-child .approach-card-index b,
      .approach-card:nth-child(2) .approach-card-index b,
      .approach-card:nth-child(3) .approach-card-index b {
        font-size: 14px !important;
        line-height: 1.32 !important;
        letter-spacing: 0.13em !important;
      }
    }

    @media (max-width: 390px) {
      .approach-card:first-child .approach-card-index b,
      .approach-card:nth-child(2) .approach-card-index b,
      .approach-card:nth-child(3) .approach-card-index b {
        font-size: 13px !important;
      }
    }

  
    /* ======================================================================
       APPROACH MOBILE — final equal visual size for all labels under numbers
       ====================================================================== */

    @media (max-width: 720px) {
      .approach-card .approach-card-index b,
      .approach-card:first-child .approach-card-index b,
      .approach-card:nth-child(2) .approach-card-index b,
      .approach-card:nth-child(3) .approach-card-index b {
        font-size: 14px !important;
        line-height: 1.3 !important;
        letter-spacing: 0.12em !important;
      }

      .approach-card:first-child .approach-card-index b {
        letter-spacing: 0.105em !important;
      }
    }

    @media (max-width: 390px) {
      .approach-card .approach-card-index b,
      .approach-card:first-child .approach-card-index b,
      .approach-card:nth-child(2) .approach-card-index b,
      .approach-card:nth-child(3) .approach-card-index b {
        font-size: 13px !important;
      }

      .approach-card:first-child .approach-card-index b {
        letter-spacing: 0.095em !important;
      }
    }

  </style>
</BaseLayout>
