const renderIcon = (name: 'voice' | 'sound' | 'lock') => {
  const icons = {
    voice: '<path d="M12 3a3 3 0 0 0-3 3v5a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3Z"/><path d="M5 10v1a7 7 0 0 0 14 0v-1"/><path d="M12 18v3"/><path d="M8 21h8"/>',
    sound: '<path d="M4 9v6h4l5 4V5L8 9H4Z"/><path d="M16 8a5 5 0 0 1 0 8"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/>',
    lock: '<rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
  };

  return icons[name];
};

const poetryEntries = (await getCollection('poetry'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const poetryCount = poetryEntries.length;

// Закреплённая карточка книги в «Авторском уголке» — из тех же данных, что и /book/.
const bookChapterList = (await getCollection('bookChapters')).filter((entry) => entry.data.kind === 'chapter');
const bookReadyCount = bookChapterList.filter((entry) => entry.data.status === 'ready').length;

const releaseCount = [mdaProjects, edProjects, goltfilmProjects, animauntProjects].reduce((sum, list) => sum + list.length, 0);
const demoCount = demoCards.filter((card) => card.video).length + soundCards.length;

---

<BaseLayout
  title="Работы и портфолио — Феофилакт Птахен"
  description="Работы Феофилакта Птахена: голосовые демо, релизы озвучивания и дубляжа, звукорежиссура, авторский уголок со стихами и песнями, а также собственные программы."
  pageType="CollectionPage"
>
  <section class="shell portfolio-redesign">
    <div class="portfolio-top">
    <header class="portfolio-head">
      <p class="portfolio-kicker">Работы</p>
      <h1>Портфолио</h1>
      <p>
        Голос и звук в реальных проектах: демо по жанрам и саунд-дизайн,
        релизы для студий озвучки, авторские тексты и собственные программы.
      </p>
    </header>

    <nav class="portfolio-tabs" aria-label="Разделы портфолио">
      <button class="active" type="button" data-tab="demo">Деморил <span>{demoCount}</span></button>
      <button type="button" data-tab="releases">Релизы <span>{releaseCount}</span></button>
      <button type="button" data-tab="author">Авторский уголок <span>{poetryCount}</span></button>
      <button type="button" data-tab="programs">Программы <span>{programProjects.length}</span></button>
    </nav>
    </div>

    <div class="portfolio-panel active" data-panel="demo">
      <h2 class="demo-group-label">Озвучивание <span>{demoCards.filter((card) => card.video).length}</span></h2>
      <div class="demo-grid">
        {
          demoCards.map((card) => (
            <article class={`demo-card ${card.video ? 'has-video' : ''}`}>
              {
                card.video ? (
                  <button
                    class="demo-video-launch"
                    type="button"
                    data-demo-video={card.video}
                    data-demo-title={card.title}
                    data-demo-text={card.text}
                    aria-label={`Открыть демо: ${card.title}`}
                  >
                    <span class="demo-video-preview">
                      <img
                        src={card.poster}
                        alt=""
                        width="640"
                        height="360"
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="demo-video-shade"></span>
                      <span class="demo-video-play" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                          <path d="M9 7.5v9l7-4.5-7-4.5Z"></path>
                        </svg>
                      </span>
                    </span>
                    <span class="demo-video-open">Смотреть демо</span>
                  </button>
                ) : (
                  <div class="demo-placeholder">
                    <span>Скоро...</span>
                  </div>
                )
              }
              <div class="demo-card-meta">
                <h3>{card.title}</h3>
                <p>{card.text}</p>
              </div>
            </article>
