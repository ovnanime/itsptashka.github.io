                }

                <a href={project.link} target="_blank" rel="noreferrer">
                  <img src={project.img} alt={project.title} loading="lazy" />
                  <span class="release-hover">
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={renderIcon('link')}></svg>
                  </span>
                </a>

                <h3>{project.title}</h3>
              </article>
            ))
          }
        </div>
      </section>

      
      <section class="studio-section-redesign" data-studio-section>
        <h2>MK Studio</h2>
        <div class="nda-card-redesign">
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={renderIcon('lock')}></svg>
          <div>
            <h3>Коммерческие проекты под NDA</h3>
            <p>
              Коммерческие релизы защищены соглашением о неразглашении.
              Портфолио для данной студии находится в процессе подготовки.
            </p>
          </div>
        </div>
      </section><section class="studio-section-redesign" data-studio-section>
        <h2>GoLTFilm</h2>
        <div class="release-grid-redesign">
          {
            goltfilmProjects.map((project) => (
              <article class="release-card-redesign" data-release-card data-roles={project.roles.join(' ')}>
                <div class="release-badges-redesign">
                  <span title="Озвучивание">
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={renderIcon('voice')}></svg>
                  </span>
                </div>

                {
                  project.roles.includes('dub') && (
                    <span class="dub-label">Дубляж</span>
                  )
                }

                <a href={project.link} target="_blank" rel="noreferrer">
                  <img src={project.img} alt={project.title} loading="lazy" />
                  <span class="release-hover">
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={renderIcon('link')}></svg>
                  </span>
                </a>

                <h3>{project.title}</h3>
              </article>
            ))
          }
        </div>
      </section>

      <section class="studio-section-redesign" data-studio-section>
