// ==========================================
// АВТОРСКИЙ УГОЛОК (АВТОМАТИЧЕСКИЙ ПАРСИНГ .txt)
// ==========================================

const poetryFiles = import.meta.glob('/src/data/poetry/*.txt', { as: 'raw', eager: true });

const poetryList = Object.entries(poetryFiles).map(([path, rawContent]) => {
  const fileName = path.split('/').pop();
  const title = fileName.substring(0, fileName.lastIndexOf('.'));

  const lines = rawContent.split(/\r?\n/);
  let badge = "Стихотворение";
  let dateStr = "";
  let timestamp = 0;
  
  const cleanLines = lines.filter(line => {
    const trimmed = line.trim();
    if (trimmed.startsWith('#')) {
      if (trimmed.toLowerCase().includes('песня')) {
        badge = "Текст песни";
      }
      
      // Ищем регулярным выражением дату в формате #DD.MM.YYYY
      const dateMatch = trimmed.match(/#(\d{2})\.(\d{2})\.(\d{4})/);
      if (dateMatch) {
        dateStr = `${dateMatch[1]}.${dateMatch[2]}.${dateMatch[3]}`;
        // Создаем timestamp (месяцы в JS идут с 0, поэтому вычитаем 1)
        timestamp = new Date(Number(dateMatch[3]), Number(dateMatch[2]) - 1, Number(dateMatch[1])).getTime();
      }
      return false; // Убираем коммент из текста
    }
    return true; // Оставляем куплеты
  });

  return {
    title,
    badge,
    dateStr,
    timestamp,
    text: cleanLines.join('\n').trim()
  };
});

// Умная сортировка от свежих к старым
poetryList.sort((a, b) => b.timestamp - a.timestamp);
