---
import BaseLayout from '../layouts/BaseLayout.astro';
import DemoPlayer from '../components/DemoPlayer.astro';
import '../styles/demo-card.css';

const soundScenes = [
  {
    title: 'Сцена 1',
    duration: '0:30',
    src: '/assets/video/sound-design-01.mp4',
    poster: '/assets/images/demo/sound-design-01.webp',
  },
  {
    title: 'Сцена 2',
    duration: '0:23',
    src: '/assets/video/sound-design-02.mp4',
    poster: '/assets/images/demo/sound-design-02.webp',
  },
];

---

<BaseLayout
  title="Феофилакт Птахен — актёр озвучивания и звукорежиссёр"
  description="Официальный сайт Ильи Сергеевича Пушкина, работающего под псевдонимом Феофилакт Птахен: озвучивание, дубляж, закадр, локализация, саунд-дизайн и сведение. Голосовые демо, релизы и авторские работы."
>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Актёр озвучивания · звукорежиссёр</p>

      <h1>
        От записи до финального микса.
        <br />
        <em class="hero-title-detail">Технические стандарты и реальный опыт.</em>
      </h1>

      <p class="lead">
        Занимаюсь озвучиванием, локализацией, саунд-дизайном и перезаписью.
        Мой подход построен на чистой практике и реальных проектах.
      </p>

      <div class="hero-visual hero-visual--mobile" aria-hidden="true">
        <div class="portrait-frame">
          <img
            src="/assets/images/avatar_ptaxen.webp"
            alt=""
            width="1308"
            height="1086"
            loading="eager"
            decoding="async"
          />
          <span class="portrait-caption">
            Илья Пушкин<br />
            псевд. Феофилакт Птахен
          </span>
        </div>

        <div class="vertical-note">Актёр озвучивания / Звукорежиссёр / Писатель</div>
      </div>

      <div class="hero-actions">
        <button class="button light" type="button" data-scroll-to="voice">Слушать голос</button>
        <a class="button ghost" href="/works/">Портфолио</a>
      </div>

      <div class="hero-facts">
        <span><b>3+</b>года практики</span>
        <span><b>50+</b>проектов</span>
        <span><b>5+</b>направлений</span>
      </div>
    </div>

    <div class="hero-visual hero-visual--desktop">
      <div class="portrait-frame">
        <img
          src="/assets/images/avatar_ptaxen.webp"
          alt="Феофилакт Птахен"
          width="1308"
          height="1086"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <span class="portrait-caption">
          Илья Пушкин<br />
          псевд. Феофилакт Птахен
        </span>
      </div>

      <div class="vertical-note">Актёр озвучивания / Звукорежиссёр / Писатель</div>
    </div>
  </section>

    <section id="voice" class="voice-strip">
    <div class="shell voice-inner">
      <div>
        <p class="eyebrow">Голос</p>
        <h2>RAW / STUDIO</h2>
        <p>
          Одна запись — два состояния. Сравните исходник и обработанный
          материал без смены фрагмента.
        </p>
      </div>

      <div class="player audio-compare-player" data-active="raw">
        <button id="play" class="player-play" type="button" aria-label="Воспроизвести">
          <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5v14l11-7L8 5Z"></path>
          </svg>
          <svg class="pause-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5h3v14H8V5Z"></path>
            <path d="M13 5h3v14h-3V5Z"></path>
          </svg>
        </button>

        <div class="wave-wrap">
          <button class="wave" id="wave-seek" type="button" aria-label="Перемотать аудио">
            {
              Array.from({ length: 74 }).map((_, index) => (
                <i style={`height:${18 + ((index * 17) % 35)}%`}></i>
              ))
            }
          </button>
        </div>

        <div class="time-row" aria-live="polite">
          <span id="time-current">0:00</span>
          <span id="time-duration">0:00</span>
        </div>

        <div class="switch audio-mode-switch">
          <button type="button" data-mode="raw" class="active">RAW</button>
          <button type="button" data-mode="studio">STUDIO</button>
        </div>

        <div class="voice-volume">
          <button class="voice-volume-mute" type="button" data-voice-mute aria-label="Выключить звук" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path class="speaker" d="M4 9v6h4l5 4V5L8 9H4Z"></path>
              <path class="wave-on" d="M16 8.5a4.5 4.5 0 0 1 0 7"></path>
              <path class="wave-on" d="M18.5 6a8 8 0 0 1 0 12"></path>
              <path class="wave-off" d="M16.5 9.5l5 5M21.5 9.5l-5 5"></path>
            </svg>
          </button>
          <input
            class="voice-volume-range"
            type="range"
            min="0"
            max="1"
            step="0.01"
            value="1"
            data-voice-volume
            aria-label="Громкость голоса"
          />
        </div>

        <audio id="demo-raw" preload="none" src="/assets/audio/voice_demo_raw.mp3"></audio>
        <audio id="demo-studio" preload="none" src="/assets/audio/voice_demo_studio.mp3"></audio>
      </div>
    </div>
  </section>

  <section id="sound" class="voice-strip sound-strip">
    <div class="shell voice-inner">
      <div>
        <p class="eyebrow">Звук</p>
        <h2>SOUND DESIGN</h2>
        <p>
          Звук с нуля: шумы, эффекты, атмосфера и сведение. Работа
          звукорежиссёра — от пустой сцены до готового микса.
        </p>
      </div>

      <div class="sound-player">
        <button
          class="demo-video-launch sound-launch"
          type="button"
          data-demo-video={soundScenes[0].src}
          data-demo-title={soundScenes[0].title}
          data-demo-text="Саунд-дизайн"
          aria-label={`Открыть демо: ${soundScenes[0].title}`}
        >
          <span class="demo-video-preview">
            <img src={soundScenes[0].poster} alt="" width="640" height="360" loading="lazy" decoding="async" />
            <span class="demo-video-shade"></span>
            <span class="demo-video-play" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M9 7.5v9l7-4.5-7-4.5Z"></path>
              </svg>
            </span>
          </span>
          <span class="demo-video-open">Смотреть демо</span>
        </button>

        <div class="sound-scenes" role="group" aria-label="Выбор сцены">
          {
            soundScenes.map((scene, index) => (
              <button
                type="button"
                class:list={['sound-scene', { active: index === 0 }]}
                aria-pressed={index === 0 ? 'true' : 'false'}
                data-sound-src={scene.src}
                data-sound-poster={scene.poster}
                data-sound-title={scene.title}
              >
                <span class="sound-scene-num">{String(index + 1).padStart(2, '0')}</span>
                <span class="sound-scene-name">{scene.title}</span>
                <span class="sound-scene-time">{scene.duration}</span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="shell section turnkey-release" aria-labelledby="turnkey-release-title">
    <div class="turnkey-release-intro">
      <div>
        <p class="eyebrow">Полный цикл</p>
        <h2 id="turnkey-release-title">Релизы<br />под ключ</h2>
      </div>

      <div class="turnkey-release-summary">
        <p>
          Могу полностью взять релиз на себя — от подбора материала и команды
          до готовой мастер-версии, которую остаётся только принять и выпустить.
        </p>
        <div class="turnkey-release-actions">
          <a class="button light" href="/contact/">Обсудить релиз</a>
          <a class="text-link" href="/works/">Смотреть релизы ↗</a>
        </div>
      </div>
    </div>

    <ol class="turnkey-release-steps">
      <li>
        <span>01</span>
        <h3>Материал</h3>
        <p>Подберу исходный материал под задачу и согласую формат будущего релиза.</p>
      </li>
      <li>
        <span>02</span>
        <h3>Команда</h3>
        <p>Найду подходящих актёров, распределю роли и организую процесс записи.</p>
      </li>
      <li>
        <span>03</span>
        <h3>Озвучивание</h3>
        <p>Запишем актёров и проконтролируем цельность актёрской подачи.</p>
      </li>
      <li>
        <span>04</span>
        <h3>Постпродакшн</h3>
        <p>Очищу фонограммы от артефактов, выполню перезапись и при необходимости локализую надписи.</p>
      </li>
      <li>
        <span>05</span>
        <h3>Сдача</h3>
        <p>Подготовлю мастер-файл в нужном формате и передам готовый материал.</p>
      </li>
    </ol>
  </section>

  <section class="manifesto">
    <div class="shell manifesto-grid">
      <p class="eyebrow">Подход</p>

      <blockquote>
        «Лучшая озвучка та,
        которую зритель даже не заметил».
      </blockquote>

      <div>
        <p>
          Медицинская база дополняет актерскую игру — понимая 
          физиологию дыхания и голосового аппарата, я добиваюсь 
          нужного звука за счет правильной работы мышц. 
          А опыт звукорежиссера позволяет свести этот исходник так, 
          чтобы голос стал абсолютно естественной частью видеоряда.
        </p>
      </div>
    </div>
  </section>

  <section class="shell section split-callout">
    <div>
      <p class="eyebrow">Два ремесла</p>
      <h2>
        В кадре — актёр.<br />
        За кадром — звукорежиссёр.
      </h2>
    </div>

    <div class="discipline-list">
      <a href="/works/">
        <span>01</span>
        <b>Озвучивание</b>
        <p>Дикторская начитка, закадровый перевод, рекаст, дубляж.</p>
      </a>

      <a href="/works/">
        <span>02</span>
        <b>Звукорежиссура</b>
        <p>Чистка записи, саунд-дизайн, сведение дубляжа, липсинка и закадра.</p>
      </a>

      <a href="/works/#author">
        <span>03</span>
        <b>Авторство</b>
        <p>Песни, рассказы, статьи, блоги.</p>
      </a>
    </div>
  </section>

  <script is:inline data-astro-rerun>
    (() => {
    const rawAudio = document.querySelector('#demo-raw');
    const studioAudio = document.querySelector('#demo-studio');
    const playButton = document.querySelector('#play');
    const modeButtons = document.querySelectorAll('.audio-mode-switch button');
    const player = document.querySelector('.audio-compare-player');
    const waveSeek = document.querySelector('#wave-seek');
    const bars = document.querySelectorAll('#wave-seek i');
    const timeCurrent = document.querySelector('#time-current');
    const timeDuration = document.querySelector('#time-duration');

    let activeMode = 'raw';
    let activeAudio = rawAudio;

    document.addEventListener('astro:before-swap', () => {
      rawAudio?.pause();
      studioAudio?.pause();
    }, { once: true });

    const formatTime = (seconds) => {
      if (!Number.isFinite(seconds)) {
        return '0:00';
      }

      const minutes = Math.floor(seconds / 60);
      const rest = Math.floor(seconds % 60).toString().padStart(2, '0');

      return `${minutes}:${rest}`;
    };

    const paintBars = () => {
      if (!activeAudio || !activeAudio.duration) {
        return;
      }

      const progress = activeAudio.currentTime / activeAudio.duration;

      bars.forEach((bar, index) => {
        const barProgress = index / Math.max(1, bars.length - 1);
        bar.classList.toggle('played', barProgress <= progress);
      });

      if (timeCurrent) {
        timeCurrent.textContent = formatTime(activeAudio.currentTime);
      }

      if (timeDuration) {
        timeDuration.textContent = formatTime(activeAudio.duration);
      }
    };

    const setPlayingState = (isPlaying) => {
      playButton?.classList.toggle('is-playing', isPlaying);
    };

    const syncInactiveAudio = () => {
      const inactiveAudio = activeMode === 'raw' ? studioAudio : rawAudio;

      if (inactiveAudio && activeAudio) {
        inactiveAudio.currentTime = activeAudio.currentTime;
      }
    };

    const switchMode = async (nextMode) => {
      if (nextMode === activeMode) {
        return;
      }

      const wasPlaying = !activeAudio.paused;
      const currentTime = activeAudio.currentTime;

      activeAudio.pause();

      activeMode = nextMode;
      activeAudio = nextMode === 'raw' ? rawAudio : studioAudio;

      activeAudio.currentTime = Math.min(currentTime, activeAudio.duration || currentTime);

      player?.setAttribute('data-active', nextMode);

      modeButtons.forEach((button) => {
        button.classList.toggle('active', button.dataset.mode === nextMode);
      });

      paintBars();

      if (wasPlaying) {
        try {
          await activeAudio.play();
          setPlayingState(true);
        } catch {
          setPlayingState(false);
        }
      }
    };

    [rawAudio, studioAudio].forEach((audio) => {
      audio?.addEventListener('loadedmetadata', paintBars);

      audio?.addEventListener('timeupdate', () => {
        if (audio === activeAudio) {
          paintBars();
          syncInactiveAudio();
        }
      });

      audio?.addEventListener('ended', () => {
        if (audio === activeAudio) {
          setPlayingState(false);
          paintBars();
        }
      });
    });

    playButton?.addEventListener('click', async () => {
      if (activeAudio.paused) {
        try {
          await activeAudio.play();
          setPlayingState(true);
        } catch {
          setPlayingState(false);
        }
      } else {
        activeAudio.pause();
        setPlayingState(false);
      }
    });

    modeButtons.forEach((button) => {
      button.addEventListener('click', () => switchMode(button.dataset.mode));
    });

    // Громкость: одна на обе дорожки, запоминается между визитами.
    const volumeRange = document.querySelector('[data-voice-volume]');
    const muteButton = document.querySelector('[data-voice-mute]');
    const applyVolume = (value, muted) => {
      [rawAudio, studioAudio].forEach((audio) => {
        if (!audio) return;
        audio.volume = value;
        audio.muted = muted;
      });
      if (volumeRange) volumeRange.value = String(muted ? 0 : value);
      volumeRange?.style.setProperty('--fill', `${(muted ? 0 : value) * 100}%`);
      muteButton?.classList.toggle('is-muted', muted || value === 0);
      muteButton?.setAttribute('aria-pressed', String(muted || value === 0));
      muteButton?.setAttribute('aria-label', muted || value === 0 ? 'Включить звук' : 'Выключить звук');
    };
    let lastVolume = 1;
    try {
      const saved = Number(localStorage.getItem('ptahen-voice-volume'));
      if (saved > 0 && saved <= 1) lastVolume = saved;
    } catch {}
    applyVolume(lastVolume, false);

    volumeRange?.addEventListener('input', () => {
      const value = Number(volumeRange.value);
      if (value > 0) lastVolume = value;
      applyVolume(value, value === 0);
      try { localStorage.setItem('ptahen-voice-volume', String(value || lastVolume)); } catch {}
    });

    muteButton?.addEventListener('click', () => {
      const muted = !(rawAudio?.muted);
      applyVolume(lastVolume, muted);
    });

    waveSeek?.addEventListener('click', (event) => {
      if (!activeAudio.duration) {
        return;
      }

      const rect = waveSeek.getBoundingClientRect();
      const ratio = (event.clientX - rect.left) / rect.width;
      const nextTime = Math.min(1, Math.max(0, ratio)) * activeAudio.duration;

      rawAudio.currentTime = nextTime;
      studioAudio.currentTime = nextTime;
      paintBars();
    });
    })();
  </script>

  <style>
    .voice-inner > div:first-child > p:last-child {
      font-size: 17px !important;
      line-height: 1.55 !important;
    }

    .manifesto-grid > div {
      width: calc(100% + 54px);
      transform: translateX(-70px);
    }

    .manifesto-grid > div p {
      font-size: 16px !important;
      line-height: 1.55 !important;
      hyphens: none !important;
      overflow-wrap: normal !important;
      text-align: left !important;
    }

    .manifesto-grid blockquote {
      align-self: center;
      text-align: center;
      transform: translateX(-72px);
    }

    @media (min-width: 761px) {
      .discipline-list {
        width: calc(100% + 80px);
        transform: translateX(-80px);
      }

      .discipline-list a span {
        font-size: 13px !important;
      }

      .discipline-list a b {
        font-size: 17px !important;
        line-height: 1.25 !important;
      }

      .discipline-list a p {
        font-size: 14px !important;
        line-height: 1.5 !important;
      }
    }

    /* Громкость в плеере RAW / STUDIO */
    .audio-compare-player .audio-mode-switch {
      grid-row: 3;
    }

    .voice-volume {
      grid-column: 2;
      grid-row: 3;
      justify-self: end;
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 2px;
    }

    .voice-volume-mute {
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      padding: 0;
      border: 0;
      border-radius: 8px;
      background: transparent;
      color: #bdbdbd;
      cursor: pointer;
      transition: color 0.2s ease, background 0.2s ease;
    }

    .voice-volume-mute:hover {
      background: #1a1a1a;
      color: #fff;
    }

    .voice-volume-mute svg {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .voice-volume-mute .speaker {
      fill: currentColor;
      stroke: none;
    }

    .voice-volume-mute .wave-off,
    .voice-volume-mute.is-muted .wave-on {
      display: none;
    }

    .voice-volume-mute.is-muted .wave-off {
      display: inline;
    }

    .voice-volume-range {
      --fill: 100%;
      width: 110px;
      height: 4px;
      margin: 0;
      border-radius: 999px;
      background: linear-gradient(90deg, #fff var(--fill), #3a3a3a var(--fill));
      cursor: pointer;
      appearance: none;
      -webkit-appearance: none;
    }

    .voice-volume-range::-webkit-slider-thumb {
      width: 14px;
      height: 14px;
      border: 0;
      border-radius: 50%;
      background: #fff;
      -webkit-appearance: none;
    }

    .voice-volume-range::-moz-range-thumb {
      width: 14px;
      height: 14px;
      border: 0;
      border-radius: 50%;
      background: #fff;
    }

    @media (max-width: 420px) {
      .voice-volume-range {
        width: 80px;
      }
    }

    /* SOUND DESIGN — пара к блоку RAW / STUDIO. Линию между ними рисует
       нижняя граница RAW / STUDIO, верхнюю у этого блока убираем, чтобы не было двойной. */
    .sound-strip::before {
      content: none;
    }

    .sound-strip .voice-inner {
      grid-template-columns: minmax(300px, 390px) minmax(0, 820px);
    }

    .sound-player {
      display: grid;
      grid-template-columns: minmax(0, 580px) minmax(180px, 220px);
      gap: 20px;
      align-items: start;
    }

    .sound-launch {
      min-height: 0;
      aspect-ratio: 16 / 9;
      border-radius: 14px;
    }

    .sound-scenes {
      display: grid;
      gap: 10px;
    }

    .sound-scene {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 12px;
      min-height: 56px;
      padding: 12px 16px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: #101010;
      color: var(--muted);
      font: inherit;
      text-align: left;
      cursor: pointer;
      transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
    }

    .sound-scene:hover {
      border-color: rgba(255, 255, 255, 0.28);
      color: #fff;
    }

    .sound-scene.active {
      border-color: rgba(255, 255, 255, 0.45);
      background: #1a1a1a;
      color: #fff;
    }

    .sound-scene-num {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.12em;
      opacity: 0.6;
    }

    .sound-scene-name {
      font-size: 16px;
      font-weight: 800;
      line-height: 1.2;
    }

    .sound-scene-time {
      font-size: 13px;
      font-weight: 700;
      opacity: 0.6;
    }

    @media (max-width: 1240px) {
      .sound-player {
        grid-template-columns: minmax(0, 1fr);
      }

      .sound-scenes {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 980px) {
      .sound-strip .voice-inner {
        grid-template-columns: 1fr;
      }
    }

    /* Больше воздуха между блоками на компьютере (было 36 и 64 px) */
    @media (min-width: 981px) {
      .voice-strip .voice-inner {
        padding-top: 72px !important;
        padding-bottom: 72px !important;
      }

      .section {
        padding-top: 96px !important;
        padding-bottom: 96px !important;
      }

      /* Последний блок: дальше подвал со своим отступом — лишний воздух не нужен */
      .split-callout {
        padding-bottom: 40px !important;
      }
    }

    /* «Подход» — карточка между секциями: внешних отступов не нужно, их дают
