---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('poetry');

  return entries
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const label = entry.data.type === 'song' ? 'Песня' : 'Стихотворение';
---

<BaseLayout title={`${entry.data.title} — Авторский уголок`}>
  <main class="poetry-page">
    <article class="shell poetry-shell">
      <a class="back-link" href="/works" data-return-works-tab="author">← Авторский уголок</a>

      <header class="poetry-header">
        <div>
          <p class="eyebrow">АВТОРСКИЙ УГОЛОК</p>
          <h1>{entry.data.title}</h1>
        </div>

        <div class="poetry-meta">
          <span>{label}</span>
          <time datetime={entry.data.date.toISOString()}>
            {entry.data.date.toLocaleDateString('ru-RU')}
          </time>
        </div>
      </header>

      <section class="poetry-content">
        <Content />
      </section>
    </article>
  </main>

  <style>
    .poetry-page {
      padding: 34px 0 58px;
    }

    .poetry-shell {
      max-width: 880px;
    }

    .back-link {
      display: inline-flex;
      margin-bottom: 24px;
      color: var(--muted);
      font-family: Roboto, Arial, sans-serif;
      font-size: 14px;
      line-height: 1;
      font-weight: 800;
      text-decoration: none;
    }

    .back-link:hover {
      color: var(--text);
    }

    .poetry-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 28px;
      align-items: end;
      padding-bottom: 22px;
      border-bottom: 1px solid var(--line);
    }

    .poetry-header .eyebrow {
      margin: 0 0 12px;
      color: var(--muted);
      font-family: Roboto, Arial, sans-serif;
      font-size: 12px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .poetry-header h1 {
      max-width: 680px;
      margin: 0;
      color: #fff;
      font-family: Roboto, Arial, sans-serif;
      font-size: 36px;
      line-height: 1.08;
      font-weight: 900;
      letter-spacing: -0.045em;
    }

    .poetry-meta {
      display: grid;
      justify-items: end;
      gap: 9px;
      color: var(--muted);
      font-family: Roboto, Arial, sans-serif;
      white-space: nowrap;
    }

    .poetry-meta span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 92px;
      height: 30px;
      padding: 0 12px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 9px;
      background: rgba(255, 255, 255, 0.045);
      color: #f1f1f1;
      font-size: 13px;
      line-height: 1;
      font-weight: 850;
    }

    .poetry-meta time {
      color: #aeb5bc;
      font-size: 13px;
      line-height: 1;
      font-weight: 800;
    }

    .poetry-content {
      max-width: 680px;
      margin-top: 28px;
      color: var(--text);
      font-family: Roboto, Arial, sans-serif;
      font-size: 18px;
      line-height: 1.68;
      font-weight: 500;
      letter-spacing: -0.006em;
      white-space: pre-wrap;
    }

    .poetry-content :global(p) {
      margin: 0 0 1em;
    }

    .poetry-content :global(p:last-child) {
      margin-bottom: 0;
    }

    .poetry-content :global(hr) {
      width: 96px;
      margin: 24px 0;
      border: none;
      border-top: 1px solid var(--line);
    }

    .poetry-content :global(sup) {
      font-size: 0.7em;
    }

    @media (max-width: 720px) {
      .poetry-page {
        padding-top: 30px;
      }

      .poetry-header {
        grid-template-columns: 1fr;
        gap: 18px;
        align-items: start;
      }

      .poetry-meta {
        justify-items: start;
      }

      .poetry-header h1 {
        font-size: 34px;
      }

      .poetry-content {
        max-width: none;
        margin-top: 24px;
        font-size: 18px;
        line-height: 1.62;
      }
    }

    /* Poetry meta compact card alignment */
    .poetry-meta {
      min-width: 132px !important;
      gap: 8px !important;
      justify-items: center !important;
      align-self: end !important;
      padding: 10px 12px !important;
      border: 1px solid rgba(255, 255, 255, 0.09) !important;
      border-radius: 12px !important;
      background: rgba(255, 255, 255, 0.025) !important;
    }

    .poetry-meta span {
      min-width: 0 !important;
      height: 26px !important;
      padding: 0 10px !important;
      border-radius: 8px !important;
      font-size: 12px !important;
      font-weight: 850 !important;
    }

    .poetry-meta time {
      color: #b8c0c8 !important;
      font-size: 13px !important;
      font-weight: 850 !important;
      text-align: center !important;
    }

    @media (max-width: 720px) {
      .poetry-meta {
        justify-items: start !important;
        min-width: 0 !important;
      }
    }


    /* Poetry meta: no outer frame */
    .poetry-meta {
      min-width: 112px !important;
      gap: 8px !important;
      justify-items: center !important;
      align-self: end !important;
      padding: 0 !important;
      border: 0 !important;
      border-radius: 0 !important;
      background: transparent !important;
    }

    .poetry-meta span {
      min-width: 0 !important;
      height: 28px !important;
      padding: 0 12px !important;
      border-radius: 8px !important;
      border: 1px solid rgba(255, 255, 255, 0.16) !important;
      background: rgba(255, 255, 255, 0.045) !important;
      color: #f1f1f1 !important;
      font-size: 12px !important;
      font-weight: 850 !important;
    }

    .poetry-meta time {
      color: #b8c0c8 !important;
      font-size: 13px !important;
      font-weight: 850 !important;
      text-align: center !important;
    }


    /* Poetry meta: bigger badge and date */
    .poetry-meta {
      min-width: 128px !important;
      gap: 10px !important;
    }

    .poetry-meta span {
      height: 32px !important;
      padding: 0 14px !important;
      border-radius: 9px !important;
      font-size: 14px !important;
      font-weight: 900 !important;
    }

    .poetry-meta time {
      font-size: 15px !important;
      font-weight: 900 !important;
    }

  
    /* ======================================================================
       POETRY / SONG — MOBILE HEADER POLISH
       ====================================================================== */

    @media (max-width: 720px) {
      .poetry-page {
        padding-bottom: 72px !important;
      }

      .poetry-header {
        display: grid !important;
        grid-template-columns: minmax(0, 1fr) auto !important;
        grid-template-areas:
          "corner badge"
          "title  date" !important;
        gap: 10px 16px !important;
        align-items: center !important;
        padding-bottom: 18px !important;
      }

      .poetry-header > div:first-child,
      .poetry-meta {
        display: contents !important;
      }

      .poetry-header .eyebrow {
        grid-area: corner !important;
        margin: 0 !important;
        font-size: 10px !important;
        line-height: 1.2 !important;
        letter-spacing: 0.14em !important;
      }

      .poetry-header h1 {
        grid-area: title !important;
        max-width: none !important;
        font-size: clamp(25px, 7vw, 31px) !important;
        line-height: 1.08 !important;
      }

      .poetry-meta span {
        grid-area: badge !important;
        justify-self: end !important;
        height: 27px !important;
        padding: 0 10px !important;
        font-size: 12px !important;
      }

      .poetry-meta time {
        grid-area: date !important;
        justify-self: end !important;
        align-self: center !important;
        font-size: 13px !important;
        white-space: nowrap !important;
      }

      .poetry-content {
        margin-top: 24px !important;
      }
    }

    @media (max-width: 390px) {
      .poetry-header {
        gap: 9px 10px !important;
      }

      .poetry-header h1 {
        font-size: clamp(23px, 6.8vw, 28px) !important;
      }

      .poetry-meta span,
      .poetry-meta time {
        font-size: 11px !important;
      }
    }

  
    /* ======================================================================
       POETRY / SONG MOBILE V2 — restore independent right meta column
       ====================================================================== */

    @media (max-width: 720px) {
      .poetry-header {
        display: grid !important;
        grid-template-columns: minmax(0, 1fr) auto !important;
        grid-template-areas: none !important;
        gap: 18px !important;
        align-items: end !important;
        padding-bottom: 18px !important;
      }

      .poetry-header > div:first-child,
      .poetry-meta {
        display: block !important;
      }

      .poetry-header > div:first-child {
        min-width: 0 !important;
      }

      .poetry-header .eyebrow {
        margin: 0 0 10px !important;
        font-size: 10px !important;
        line-height: 1.2 !important;
        letter-spacing: 0.14em !important;
      }

      .poetry-header h1 {
        max-width: none !important;
        margin: 0 !important;
        font-size: clamp(25px, 6.8vw, 30px) !important;
        line-height: 1.08 !important;
      }

      .poetry-meta {
        min-width: 112px !important;
        justify-self: end !important;
        align-self: end !important;
        padding: 8px 10px !important;
        text-align: right !important;
      }

      .poetry-meta span {
        display: inline-flex !important;
        margin: 0 0 8px auto !important;
        min-width: 0 !important;
        height: 25px !important;
        padding: 0 9px !important;
        font-size: 11px !important;
      }

      .poetry-meta time {
        display: block !important;
        font-size: 12px !important;
        line-height: 1.1 !important;
        text-align: right !important;
      }

      .poetry-content {
        max-width: none !important;
        margin-top: 18px !important;
        font-size: 16px !important;
        line-height: 1.5 !important;
      }

      .poetry-content :global(p) {
        margin-bottom: 0.72em !important;
      }

      .poetry-content :global(hr) {
        margin: 18px 0 !important;
      }
    }

    @media (max-width: 390px) {
      .poetry-header {
        gap: 12px !important;
      }

      .poetry-header h1 {
        font-size: clamp(23px, 6.4vw, 27px) !important;
      }

      .poetry-meta {
        min-width: 100px !important;
        padding: 7px 8px !important;
      }

      .poetry-content {
        font-size: 15px !important;
        line-height: 1.48 !important;
      }
    }

  
    /* ======================================================================
       POETRY / SONG MOBILE — pin badge and date to the right edge
       ====================================================================== */

    @media (max-width: 720px) {
      .poetry-header {
        position: relative !important;
        display: block !important;
        width: 100% !important;
        min-height: 92px !important;
        padding-right: 142px !important;
        box-sizing: border-box !important;
      }

      .poetry-header > div:first-child {
        width: 100% !important;
        min-width: 0 !important;
      }

      .poetry-header h1 {
        width: 100% !important;
        max-width: none !important;
      }

      .poetry-meta {
        position: absolute !important;
        top: 0 !important;
        right: 0 !important;
        width: auto !important;
        min-width: 118px !important;
        margin: 0 !important;
        padding: 0 !important;
        display: grid !important;
        justify-items: end !important;
        gap: 10px !important;
        text-align: right !important;
      }

      .poetry-meta span {
        margin: 0 !important;
      }

      .poetry-meta time {
        margin: 0 !important;
        text-align: right !important;
      }
    }

    @media (max-width: 390px) {
      .poetry-header {
        min-height: 86px !important;
        padding-right: 124px !important;
      }

      .poetry-meta {
        min-width: 108px !important;
      }
    }

  
    /* ======================================================================
       POETRY / SONG MOBILE V3 — badge above date, no overlap
       ====================================================================== */

    @media (max-width: 720px) {
      .poetry-header {
        min-height: 104px !important;
        padding-right: 142px !important;
      }

      .poetry-meta {
        position: absolute !important;
        top: 0 !important;
        right: 0 !important;
        width: 126px !important;
        min-width: 126px !important;
        height: auto !important;
        margin: 0 !important;
        padding: 0 !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: flex-end !important;
        justify-content: flex-start !important;
        gap: 12px !important;
      }

      .poetry-meta span {
        position: static !important;
        display: inline-flex !important;
        flex: 0 0 auto !important;
        width: auto !important;
        height: 27px !important;
        margin: 0 !important;
        padding: 0 10px !important;
      }

      .poetry-meta time {
        position: static !important;
        display: block !important;
        flex: 0 0 auto !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        line-height: 1.2 !important;
        text-align: right !important;
        white-space: nowrap !important;
      }
    }

    @media (max-width: 390px) {
      .poetry-header {
        min-height: 98px !important;
        padding-right: 124px !important;
      }

      .poetry-meta {
        width: 112px !important;
        min-width: 112px !important;
        gap: 10px !important;
      }
    }

  
    /* ======================================================================
       POETRY / SONG MOBILE V4 — comfortable side padding
       ====================================================================== */

    @media (max-width: 720px) {
      .poetry-page {
        width: 100% !important;
        padding-left: 18px !important;
        padding-right: 18px !important;
        box-sizing: border-box !important;
      }
    }

    @media (max-width: 390px) {
      .poetry-page {
        padding-left: 16px !important;
        padding-right: 16px !important;
      }
    }

  </style>

  <script is:inline>
    document.querySelector('[data-return-works-tab="author"]')?.addEventListener('click', () => {
      sessionStorage.setItem('ptahen-works-active-tab', 'author');
    });
  </script>

</BaseLayout>
