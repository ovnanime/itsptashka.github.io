  <script is:inline>
    const tabButtons = document.querySelectorAll('[data-tab]');
    const panels = document.querySelectorAll('[data-panel]');

    const availableTabs = ['demo', 'releases', 'author'];

    const getTabFromHash = () => {
      const hash = window.location.hash.replace('#', '');

      return availableTabs.includes(hash) ? hash : 'demo';
    };

    const resetReleaseRoleFilter = () => {
      const filterButtons = document.querySelectorAll('[data-role-filter]');
      const releaseCards = document.querySelectorAll('[data-release-card]');
      const studioSections = document.querySelectorAll('[data-studio-section]');

      filterButtons.forEach((button) => {
        button.classList.remove('active', 'is-excluding');
        button.dataset.filterMode = '';
        button.setAttribute('aria-pressed', 'false');
      });

      releaseCards.forEach((card) => {
        card.hidden = false;
      });

      studioSections.forEach((section) => {
        section.hidden = false;
      });
    };

    const setActiveTab = (target) => {
      tabButtons.forEach((button) => {
        button.classList.toggle('active', button.dataset.tab === target);
      });

      panels.forEach((panel) => {
        panel.classList.toggle('active', panel.dataset.panel === target);
      });

      resetReleaseRoleFilter();
    };

    setActiveTab(getTabFromHash());

    tabButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.dataset.tab;

        setActiveTab(target);

        const nextHash = target === 'demo' ? '#demo' : `#${target}`;

        if (window.location.hash !== nextHash) {
          history.pushState(null, '', nextHash);
        }
      });
    });

    window.addEventListener('popstate', () => {
      setActiveTab(getTabFromHash());
    });

    window.addEventListener('hashchange', () => {
      setActiveTab(getTabFromHash());
    });

    const roleFilterButtons = document.querySelectorAll('[data-role-filter]');
    const studioSections = document.querySelectorAll('[data-studio-section]');

    const applyReleaseRoleFilter = (activeRole, mode = 'include') => {
      roleFilterButtons.forEach((button) => {
        const isCurrent = button.dataset.roleFilter === activeRole;

        button.classList.toggle('active', isCurrent && mode === 'include');
        button.classList.toggle('is-excluding', isCurrent && mode === 'exclude');
        button.dataset.filterMode = isCurrent ? mode : '';
        button.setAttribute('aria-pressed', String(isCurrent));
      });

      studioSections.forEach((section) => {
        const cards = Array.from(section.querySelectorAll('[data-release-card]'));

        if (!cards.length) {
          section.hidden = Boolean(activeRole);
          return;
        }

        let hasVisibleCards = false;

        cards.forEach((card) => {
          const roles = String(card.dataset.roles || '').split(' ');
          const hasRole = activeRole ? roles.includes(activeRole) : true;
          const shouldShow = !activeRole
            ? true
            : mode === 'exclude'
              ? !hasRole
              : hasRole;

          card.hidden = !shouldShow;

          if (shouldShow) {
            hasVisibleCards = true;
          }
        });

        section.hidden = Boolean(activeRole) && !hasVisibleCards;
      });
    };

    roleFilterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const scrollBeforeFilter = window.scrollY;
        const role = button.dataset.roleFilter;
        const currentMode = button.dataset.filterMode || '';
        const nextMode = currentMode === 'include'
          ? 'exclude'
          : currentMode === 'exclude'
            ? ''
            : 'include';

        applyReleaseRoleFilter(nextMode ? role : '', nextMode || 'include');

        requestAnimationFrame(() => {
          window.scrollTo({
            top: scrollBeforeFilter,
            left: 0,
            behavior: 'auto',
          });
        });
      });
    });
  </script>

