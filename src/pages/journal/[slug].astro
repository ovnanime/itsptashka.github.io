---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('journal');

  return entries
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} — Журнал`}>
  <main class="journal-post-page">
    <article class="shell journal-post-shell">
      <a class="back-link" href="/" data-smart-back>← Назад</a>

      <header class="journal-post-header">
        <div class="journal-post-heading">
          <h1>{entry.data.title}</h1>
          <p class="journal-post-description">{entry.data.description}</p>
        </div>

        <div class="journal-post-meta">
          <time datetime={entry.data.date.toISOString()}>
            {entry.data.date.toLocaleDateString('ru-RU')}
          </time>
        </div>
      </header>

      <section class="journal-post-content">
        <Content />
      </section>
    </article>
  </main>

  <script is:inline>
    (() => {
      const smartBackLink = document.querySelector('[data-smart-back]');
      if (!smartBackLink) return;

      const fallbackHref = '/';
      let canRestorePreviousPage = false;

      try {
        const referrerUrl = document.referrer ? new URL(document.referrer) : null;
        const isSameOrigin =
          referrerUrl && referrerUrl.origin === window.location.origin;

        const referrerPath = isSameOrigin ? referrerUrl.pathname : '';

        canRestorePreviousPage =
          referrerPath === '/' ||
          referrerPath === '/journal' ||
          referrerPath === '/journal/';

        if (referrerPath === '/journal' || referrerPath === '/journal/') {
          smartBackLink.setAttribute('href', '/journal');
        } else if (referrerPath === '/') {
          smartBackLink.setAttribute('href', '/#journal');
        } else {
          smartBackLink.setAttribute('href', fallbackHref);
        }
      } catch {
        smartBackLink.setAttribute('href', fallbackHref);
      }

      smartBackLink.addEventListener('click', (event) => {
        if (!canRestorePreviousPage || window.history.length <= 1) return;

        event.preventDefault();
        window.history.back();
      });
    })();
  </script>

  <style>
    .journal-post-page {
      padding: 34px 0 64px;
    }

    .journal-post-page,
    .journal-post-page * {
      font-family: Roboto, Arial, sans-serif;
    }

    .journal-post-shell {
      max-width: 1100px;
    }

    .back-link {
      display: inline-flex;
      margin-bottom: 24px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1;
      font-weight: 800;
      text-decoration: none;
    }

    .back-link:hover {
      color: #fff;
    }

    .journal-post-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 24px;
      align-items: end;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--line);
    }

    .journal-post-heading {
      min-width: 0;
    }

    .journal-post-header h1 {
      max-width: 900px;
      margin: 0;
      color: #fff;
      font-size: 36px;
      line-height: 1.08;
      font-weight: 900;
      letter-spacing: -0.045em;
    }

    .journal-post-description {
      max-width: 820px;
      margin: 14px 0 0;
      color: var(--muted);
      font-size: 20px;
      line-height: 1.5;
      font-weight: 500;
    }

    .journal-post-meta {
      display: grid;
      justify-items: end;
      align-self: start;
      white-space: nowrap;
      padding-top: 6px;
    }

    .journal-post-meta time {
      color: #b8c0c8;
      font-size: 14px;
      line-height: 1;
      font-weight: 850;
    }

    .journal-post-content {
      width: 100%;
      margin-top: 30px;
      color: var(--text);
      font-size: 18px;
      line-height: 1.62;
      font-weight: 500;
    }

    .journal-post-content :global(.journal-block) {
      margin: 0 0 30px;
    }

    .journal-post-content :global(.journal-block > :last-child) {
      margin-bottom: 0;
    }

    .journal-post-content :global(p) {
      margin: 0 0 18px;
      max-width: 940px;
    }

    .journal-post-content :global(h2) {
      margin: 0 0 16px;
      color: #fff;
      font-size: 30px;
      line-height: 1.12;
      font-weight: 900;
      letter-spacing: -0.04em;
    }

    .journal-post-content :global(h3) {
      margin: 0 0 10px;
      color: #fff;
      font-size: 20px;
      line-height: 1.2;
      font-weight: 900;
      letter-spacing: -0.025em;
    }

    .journal-post-content :global(.journal-lead) {
      max-width: 920px;
      margin: 0 0 26px;
      color: #e0e0e0;
      font-size: 18px;
      line-height: 1.62;
      font-weight: 500;
    }

    .journal-post-content :global(.journal-media-row) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      margin: 22px 0 30px;
    }


    /* Remove default figure margins so screenshots use full row width */
    .journal-post-content :global(figure) {
      margin: 0;
    }

    .journal-post-content :global(.journal-shot),
    .journal-post-content :global(.journal-shot-wide) {
      margin: 0;
      width: 100%;
    }

    .journal-post-content :global(.journal-shot) {
      position: relative;
      min-height: 250px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 14px;
      background:
        radial-gradient(circle at 72% 24%, rgba(255,255,255,0.08), transparent 38%),
        #101010;
      box-sizing: border-box;
    }

    .journal-post-content :global(.journal-shot::before) {
      content: '';
      position: absolute;
      inset: 0;
      border: 1px dashed rgba(255,255,255,0.14);
      border-radius: 13px;
      pointer-events: none;
    }

    .journal-post-content :global(.journal-shot::after) {
      content: attr(data-label);
      position: absolute;
      left: 18px;
      bottom: 16px;
      max-width: calc(100% - 36px);
      color: #f1f1f1;
      font-size: 18px;
      line-height: 1.22;
      font-weight: 900;
      letter-spacing: -0.025em;
    }

    .journal-post-content :global(.journal-shot img) {
      display: block;
      width: 100%;
      height: 100%;
      min-height: 250px;
      object-fit: cover;
    }

    .journal-post-content :global(.journal-shot-wide) {
      min-height: 300px;
      margin: 22px 0 30px;
    }

    .journal-post-content :global(.journal-points) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      margin: 20px 0 30px;
      padding: 0;
      list-style: none;
    }

    .journal-post-content :global(.journal-points li) {
      padding: 18px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.025);
      color: var(--muted);
      font-size: 14px;
      line-height: 1.5;
    }

    .journal-post-content :global(.journal-points strong) {
      display: block;
      margin-bottom: 8px;
      color: #fff;
      font-size: 18px;
      line-height: 1.18;
      font-weight: 900;
      letter-spacing: -0.02em;
    }

    .journal-post-content :global(.journal-note) {
      margin: 30px 0 0;
      padding: 20px 22px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.03);
      color: #e7e7e7;
      font-size: 18px;
      line-height: 1.56;
    }

    @media (max-width: 860px) {
      .journal-post-header,
      .journal-post-content :global(.journal-media-row),
      .journal-post-content :global(.journal-points) {
        grid-template-columns: 1fr;
      }

      .journal-post-meta {
        justify-items: start;
        padding-top: 0;
      }
    }

    @media (max-width: 720px) {
      .journal-post-header h1 {
        font-size: 34px;
      }

      .journal-post-description,
      .journal-post-content,
      .journal-post-content :global(.journal-note) {
        font-size: 18px;
        line-height: 1.58;
      }

      .journal-post-content :global(.journal-shot),
      .journal-post-content :global(.journal-shot img),
      .journal-post-content :global(.journal-shot-wide) {
        min-height: 210px;
      }
    }

    /* Journal article text alignment */
    .journal-post-content :global(p),
    .journal-post-content :global(.journal-lead),
    .journal-post-content :global(.journal-note),
    .journal-post-content :global(.journal-points li) {
      text-align: justify;
      text-justify: inter-word;
    }

    .journal-post-content :global(h2),
    .journal-post-content :global(h3),
    .journal-post-content :global(strong),
    .journal-post-content :global(.journal-shot::after) {
      text-align: left;
    }


    /* Journal article: use full available text width */
    .journal-post-content {
      max-width: none !important;
      width: 100% !important;
    }

    .journal-post-content :global(p),
    .journal-post-content :global(.journal-lead),
    .journal-post-content :global(.journal-block),
    .journal-post-content :global(.journal-note) {
      max-width: none !important;
      width: 100% !important;
    }


    /* Journal half-grid blocks */
    .journal-post-content :global(.journal-grid-half) {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      align-items: center;
      margin-bottom: 32px;
    }

    .journal-post-content :global(.journal-grid-half .journal-grid-text) {
      margin: 0;
    }

    .journal-post-content :global(.journal-grid-half .journal-shot) {
      margin: 0;
      width: 100%;
    }

    .journal-post-content :global(.journal-links) {
      display: flex;
      gap: 16px;
      margin-top: 32px;
      flex-wrap: wrap;
    }

    .journal-post-content :global(.journal-button) {
      display: inline-flex;
      min-height: 38px;
      align-items: center;
      justify-content: center;
      padding: 0 14px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 999px;
      color: #fff;
      font-size: 14px;
      line-height: 1;
      font-weight: 850;
      text-decoration: none;
      background: rgba(255, 255, 255, 0.035);
    }

    .journal-post-content :global(.journal-button:hover) {
      background: #fff;
      border-color: #fff;
      color: #050505;
    }

    @media (max-width: 768px) {
      .journal-post-content :global(.journal-grid-half) {
        grid-template-columns: 1fr;
      }
    }


    /* Journal post: bigger back link and date, closer to author pages */
    .back-link {
      margin-bottom: 28px !important;
      color: #b8c0c8 !important;
      font-size: 14px !important;
      line-height: 1 !important;
      font-weight: 850 !important;
      letter-spacing: -0.01em !important;
    }

    .journal-post-meta time {
      color: #d5dce4 !important;
      font-size: 14px !important;
      line-height: 1 !important;
      font-weight: 900 !important;
      letter-spacing: -0.01em !important;
    }

    @media (max-width: 720px) {
      .back-link,
      .journal-post-meta time {
        font-size: 14px !important;
      }
    }


    /* Journal post: extra bigger back link and date */
    .back-link {
      font-size: 16px !important;
      font-weight: 900 !important;
      color: #d5dce4 !important;
    }

    .journal-post-meta time {
      font-size: 16px !important;
      font-weight: 900 !important;
      color: #d5dce4 !important;
    }

    @media (max-width: 720px) {
      .back-link,
      .journal-post-meta time {
        font-size: 15px !important;
      }
    }


    /* Journal post: compact bottom spacing */
    .journal-post-page {
      padding-bottom: 24px !important;
    }

    .journal-post-content :global(.journal-links) {
      margin-top: 24px !important;
      margin-bottom: 0 !important;
    }

    :global(body > footer.site-footer) {
      margin-top: 28px !important;
    }

  </style>
</BaseLayout>
