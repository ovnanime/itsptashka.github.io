    /* Постер открывает карточку релиза */
    .release-poster-open {
      width: 100%;
      padding: 0;
      border: 0;
      color: inherit;
      font: inherit;
      cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .release-poster-open img {
      transition: filter 0.2s ease;
    }

    .release-poster-go {
      position: absolute;
      right: 7px;
      bottom: 7px;
      z-index: 4;
      display: grid;
      place-items: center;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: rgba(10, 10, 10, 0.78);
      color: #fff;
      font-family: Georgia, serif;
      font-size: 14px;
      font-style: italic;
      font-weight: 700;
      line-height: 1;
      opacity: 0;
      transform: translateY(4px);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .release-poster-open:hover,
    .release-poster-open:focus-visible {
      transform: translateY(-3px);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5);
    }

    .release-poster-open:hover img,
    .release-poster-open:focus-visible img {
      filter: brightness(1.08);
    }

    .release-poster-open:hover .release-poster-go,
    .release-poster-open:focus-visible .release-poster-go {
      opacity: 1;
      transform: none;
    }

    @media (hover: none) {
      .release-poster-go {
        opacity: 1;
        transform: none;
      }
    }

    /* Карточка релиза */
    .release-dialog {
      width: min(640px, calc(100% - 32px));
      max-height: calc(100dvh - 32px);
      padding: 0;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: #101010;
      color: var(--text);
      overflow: auto;
    }

    .release-dialog::backdrop {
      background: rgba(0, 0, 0, 0.78);
      backdrop-filter: blur(6px);
    }

    .release-dialog-body {
      position: relative;
      display: grid;
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 24px;
      padding: 24px;
    }

    .release-dialog-poster {
      width: 100%;
      height: auto;
      aspect-ratio: 2 / 3;
      object-fit: cover;
      border-radius: 12px;
      background: #111;
    }

    .release-dialog-info {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-width: 0;
      padding: 8px 8px 8px 0;
    }

    .release-dialog-studio {
      padding-right: 44px;
    }

    .release-dialog-studio,
    .release-dialog-label {
      margin: 0 0 10px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 800;
      line-height: 1.2;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .release-dialog-info h2 {
      margin: 0 0 24px;
      padding-right: 40px;
      font-size: clamp(24px, 3vw, 30px);
      font-weight: 900;
      line-height: 1.1;
      letter-spacing: -0.03em;
    }

    .release-dialog-roles {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    /* Бейдж «Дубляж» — как на постере */
    .release-dialog-dub {
      align-self: flex-start;
      margin: -12px 0 22px;
      padding: 5px 9px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.92);
      color: #050505;
      font-size: 11px;
      font-weight: 800;
      line-height: 1;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .release-dialog-dub[hidden] {
      display: none;
    }

    .release-dialog-roles :global(li) {
      display: block !important;
      margin: 0 !important;
      padding: 7px 12px !important;
      border: 1px solid rgba(255, 255, 255, 0.22) !important;
      border-radius: 999px;
      color: var(--text) !important;
      font-size: 14px !important;
      font-weight: 700;
      line-height: 1.2 !important;
    }

    .release-dialog-watch {
      display: inline-flex;
      align-self: center;
      align-items: center;
      gap: 10px;
      min-height: 48px;
      margin-top: 28px;
      padding: 0 18px 0 16px;
      border: 1px solid #fff;
      border-radius: 12px;
      background: #fff;
      color: #050505;
      font-size: 15px;
      font-weight: 800;
      line-height: 1;
      transition: background 0.2s ease, color 0.2s ease;
    }

    .release-dialog-watch:hover,
    .release-dialog-watch:focus-visible {
      background: transparent;
      color: #fff;
    }

    .release-dialog-watch[hidden] {
      display: none;
    }

    .release-dialog-watch svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }

    .release-dialog-watch-arrow {
      fill: none !important;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      opacity: 0.6;
    }

    .release-dialog-close {
      position: absolute;
      top: 12px;
      right: 12px;
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      padding: 0;
      border: 1px solid var(--line);
      border-radius: 50%;
      background: transparent;
      color: var(--text);
      font-size: 22px;
      line-height: 1;
      cursor: pointer;
    }

    .release-dialog-close:hover {
      background: #1c1c1c;
    }

    @media (max-width: 560px) {
      /* На телефоне — в одну колонку: постер сверху, кнопка во всю ширину окна. */
      .release-dialog-body {
        grid-template-columns: 1fr;
        gap: 16px;
        padding: 18px;
      }

      .release-dialog-poster {
        width: 132px;
      }

      .release-dialog-info {
