---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactIntro from '../components/ContactIntro.astro';
import { CONTACTS } from '../data/site';
---

<BaseLayout
  title="Контакты — Феофилакт Птахен"
  description="Связаться с Феофилактом Птахеном по вопросам озвучивания, дубляжа, звукорежиссуры и локализации."
>
  <div class="contact-page" data-contact-page>
    <ContactIntro />

    <section class="shell contact-hero">
      <div class="contact-hero-copy">
        <p class="contact-label">Связаться</p>
        <h1>Написать по проекту.</h1>
        <p>
          Озвучивание, дубляж, закадр, звукорежиссура, локализация и рабочие
          вопросы по релизам. Без формы на сайте — просто выбери удобный способ
          связи.
        </p>
      </div>

      <aside class="contact-note">
        <span>Статус</span>
        <b>Открыт к проектам</b>
        <p>Обычно отвечаю в течение дня, если не нахожусь на записи или монтаже.</p>
      </aside>
    </section>

    <section class="shell contact-grid" aria-label="Способы связи">
      {CONTACTS.map((item) => (
        <a class="contact-card" href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
          <div>
            <span>{item.label}</span>
            <h2>{item.value}</h2>
            <p>{item.text}</p>
          </div>

          <i aria-hidden="true">↗</i>
        </a>
      ))}
    </section>
  </div>

  <style>


    :global(html),
    :global(body) {
      min-height: 100%;
    }

    :global(body) {
      display: flex;
      min-height: 100dvh;
      flex-direction: column;
    }

    :global(body > header.site-header) {
      flex-shrink: 0;
    }

    :global(body > main),
    :global(body > .contact-page) {
      flex: 1 0 auto;
    }

    :global(body > footer.site-footer) {
      flex-shrink: 0;
      margin-top: auto !important;
    }

    .contact-page {
      position: relative;
      padding: 34px 0 0;
    }

    .contact-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 360px;
      gap: 18px;
      align-items: stretch;
      min-height: 0 !important;
      margin-top: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 18px;
      border-bottom: 1px solid var(--line);
    }

    .contact-hero-copy {
      display: flex;
      max-width: 760px;
      min-height: 0 !important;
      flex-direction: column;
      justify-content: center;
      margin-top: 0 !important;
      padding-top: 0 !important;
    }


    .contact-hero.shell {
      margin-top: 0 !important;
      padding-top: 0 !important;
    }

    .contact-label,
    .contact-card span,
    .contact-note span {
      display: block;
      margin: 0 0 10px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .contact-hero .contact-label {
      font-size: 14px;
      letter-spacing: 0.18em;
      margin-bottom: 14px;
    }

    .contact-note span {
      font-size: 14px;
      letter-spacing: 0.18em;
      margin-bottom: 8px;
    }

    .contact-hero h1 {
      max-width: 760px;
      margin: 0 0 12px;
      color: var(--text);
      font-size: 36px;
      line-height: 1.08;
      font-weight: 900;
      letter-spacing: -0.045em;
    }

    .contact-hero-copy > p:last-child {
      max-width: 720px;
      margin: 0;
      color: var(--muted);
      font-size: 18px;
      line-height: 1.5;
    }

    .contact-note {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 0;
      padding: 13px 18px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background:
        radial-gradient(circle at 100% 0%, rgba(255,255,255,0.055), transparent 34%),
        #101010;
    }

    .contact-note b {
      display: block;
      color: var(--text);
      font-size: 24px;
      line-height: 1.08;
      font-weight: 900;
      letter-spacing: -0.04em;
    }

    .contact-note p {
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.38;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      padding-top: 22px;
      padding-bottom: 0;
    }

    .contact-card {
      position: relative;
      display: flex;
      min-height: 220px;
      flex-direction: column;
      justify-content: space-between;
      padding: 22px;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: #101010;
      color: inherit;
      text-decoration: none;
      transition:
        border-color 0.18s ease,
        background 0.18s ease,
        transform 0.18s ease;
    }

    .contact-card::before {
      content: '';
      position: absolute;
      inset: -1px;
      z-index: 0;
      background:
        radial-gradient(circle at 100% 0%, rgba(255,255,255,0.07), transparent 32%),
        linear-gradient(135deg, rgba(255,255,255,0.035), transparent 46%);
      opacity: 0;
      transition: opacity 0.18s ease;
    }

    .contact-card > * {
      position: relative;
      z-index: 1;
    }

    .contact-card h2 {
      margin: 0 0 12px;
      color: var(--text);
      font-size: 30px;
      line-height: 1.06;
      font-weight: 900;
      letter-spacing: -0.045em;
      overflow-wrap: anywhere;
    }

    .contact-card p {
      max-width: 320px;
      margin: 0;
      color: var(--muted);
      font-size: 18px;
      line-height: 1.42;
    }

    .contact-card i {
      display: grid;
      width: 42px;
      height: 42px;
      place-items: center;
      align-self: flex-end;
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 12px;
      color: #fff;
      font-size: 20px;
      line-height: 1;
      font-style: normal;
      transition:
        background 0.18s ease,
        border-color 0.18s ease,
        transform 0.18s ease;
    }

    .contact-card:hover {
      border-color: rgba(255,255,255,0.22);
      background: #121212;
      transform: translateY(-2px);
    }

    .contact-card:hover::before {
      opacity: 1;
    }

    .contact-card:hover i {
      border-color: rgba(255,255,255,0.28);
      background: rgba(255,255,255,0.08);
      transform: translate(2px, -2px);
    }

    @media (max-width: 900px) {
      .contact-hero,
      .contact-grid {
        grid-template-columns: 1fr;
      }

      .contact-note {
        min-height: auto;
      }

      .contact-card {
        min-height: 180px;
      }
    }

    @media (max-width: 640px) {
      .contact-page {
        padding: 30px 0 0;
      }

      .contact-hero h1 {
        font-size: 36px;
      }

      .contact-hero-copy > p:last-child {
        font-size: 17px;
      }

      .contact-card {
        min-height: 160px;
        padding: 18px;
      }

      .contact-card h2 {
        font-size: 24px;
      }

      .contact-card p {
        font-size: 16px;
      }
    }

    /* Unified top typography override */
    .contact-page {
      padding-top: 34px !important;
    }

    .contact-hero .contact-label {
      margin: 0 0 14px !important;
      color: var(--muted) !important;
      font-size: 14px !important;
      line-height: 1.2 !important;
      font-weight: 800 !important;
      letter-spacing: 0.18em !important;
      text-transform: uppercase !important;
      font-family: Roboto, Arial, sans-serif !important;
    }

    .contact-hero h1 {
      font-family: Roboto, Arial, sans-serif !important;
      font-size: 36px !important;
      line-height: 1.08 !important;
      font-weight: 900 !important;
      letter-spacing: -0.045em !important;
      margin: 0 0 14px !important;
    }


    /* Compact status card alignment */
    .contact-note {
      padding-top: 13px !important;
      padding-bottom: 13px !important;
    }

    .contact-note span {
      margin-bottom: 8px !important;
    }

    .contact-note p {
      margin-top: 8px !important;
      line-height: 1.38 !important;
    }

  </style>
</BaseLayout>
