  <script is:inline data-astro-rerun>
    (() => {
      const launch = document.querySelector('#sound .sound-launch');
      const preview = launch?.querySelector('img');
      if (!launch) return;

      const buttons = document.querySelectorAll('[data-sound-src]');
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          if (button.classList.contains('active')) return;
          launch.dataset.demoVideo = button.dataset.soundSrc || '';
          launch.dataset.demoTitle = button.dataset.soundTitle || '';
          launch.setAttribute('aria-label', `Открыть демо: ${button.dataset.soundTitle || ''}`);
          if (preview) preview.src = button.dataset.soundPoster || '';
          buttons.forEach((item) => {
            const on = item === button;
            item.classList.toggle('active', on);
            item.setAttribute('aria-pressed', String(on));
          });
        });
      });

      // Открытие видео ставит голосовое демо на паузу.
      document.querySelectorAll('[data-demo-video]').forEach((button) => {
        button.addEventListener('click', () => document.querySelector('#play.is-playing')?.click());
      });
    })();
  </script>

  <script is:inline data-astro-rerun>
    (() => {
    document.querySelector('[data-scroll-to="voice"]')?.addEventListener('click', () => {
      const target = document.getElementById('voice');
      if (!target) return;

      target.scrollIntoView({
        block: 'start',
        inline: 'nearest',
        behavior: 'auto'
      });
    });
    })();
  </script>

