---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Ошибка — Что-то пошло не так"
  description="Техническая страница ошибки."
  robots="noindex, nofollow"
>
  <div class="error-page">
    <section class="shell error-shell" aria-labelledby="error-title">
      <div class="error-visual" aria-hidden="true">
        <div class="error-mark">
          <span>!</span>
        </div>
      </div>

      <div class="error-content">
        <p class="eyebrow">Ошибка</p>
        <h1 id="error-title">Что-то пошло не так.</h1>

        <p class="error-text">
          Попробуйте обновить страницу или вернуться немного позже.
          Если ошибка повторяется, воспользуйтесь навигацией сайта.
        </p>

        <div class="error-actions">
          <button class="button light" type="button" data-error-reload>
            Обновить страницу
          </button>

          <button class="button ghost" type="button" data-error-back>
            Вернуться назад
          </button>

          <a class="button ghost" href="/">
            На главную
          </a>
        </div>
      </div>
    </section>
  </div>

  <script is:inline data-astro-rerun>
    (() => {
    document.querySelector('[data-error-reload]')?.addEventListener('click', () => {
      window.location.reload();
    });

    document.querySelector('[data-error-back]')?.addEventListener('click', () => {
      if (window.history.length > 1) {
        window.history.back();
        return;
      }

      window.location.href = '/';
    });
    })();
  </script>

  <style>
    .error-page {
      min-height: calc(100vh - 160px);
      display: grid;
      align-items: center;
      padding: 56px 0 72px;
      overflow: hidden;
    }

    .error-shell {
      display: grid;
      grid-template-columns: minmax(260px, 0.78fr) minmax(0, 1.22fr);
      gap: clamp(48px, 6vw, 96px);
      align-items: center;
      min-width: 0;
    }

    .error-visual {
      min-width: 0;
      display: grid;
      place-items: center;
      justify-self: stretch;
    }

    .error-code {
      width: 100%;
      overflow: hidden;
      font-family: Roboto, Arial, sans-serif;
      font-size: clamp(128px, 17vw, 250px);
      line-height: 0.82;
      font-weight: 900;
      letter-spacing: -0.08em;
      color: rgba(255, 255, 255, 0.055);
      user-select: none;
      white-space: nowrap;
      text-align: center;
    }

    .error-mark {
      display: grid;
      place-items: center;
      width: min(250px, 88%);
      aspect-ratio: 1;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 50%;
      background:
        radial-gradient(circle at center, rgba(255,255,255,0.045), transparent 64%);
      box-sizing: border-box;
    }

    .error-mark span {
      font-family: Roboto, Arial, sans-serif;
      font-size: clamp(104px, 11vw, 184px);
      line-height: 1;
      font-weight: 900;
      color: rgba(255,255,255,0.12);
      transform: translateY(-2px);
    }

    .error-content {
      min-width: 0;
      width: 100%;
      max-width: 720px;
      text-align: left;
    }

    .error-content h1,
    .error-content p {
      text-align: left !important;
      hyphens: manual !important;
    }

    .error-content h1 {
      margin: 8px 0 18px;
      max-width: 720px;
      font-size: clamp(38px, 4.8vw, 68px);
      line-height: 0.98;
      letter-spacing: -0.045em;
      overflow-wrap: anywhere;
    }

    .error-text {
      max-width: 660px;
      margin: 0;
      color: var(--muted);
      font-size: clamp(16px, 1.5vw, 19px);
      line-height: 1.6;
    }

    .error-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 30px;
    }

    .error-actions .button {
      min-width: 170px;
      justify-content: center;
    }

    @media (max-width: 900px) {
      .error-shell {
        grid-template-columns: minmax(210px, 0.7fr) minmax(0, 1.3fr);
        gap: 38px;
      }

      .error-mark {
        width: min(220px, 90%);
      }

      .error-content h1 {
        font-size: clamp(36px, 5.6vw, 56px);
      }
    }

    @media (max-width: 760px) {
      .error-page {
        min-height: calc(100vh - 130px);
        padding: 42px 0 58px;
      }

      .error-shell {
        grid-template-columns: 1fr;
        gap: 22px;
      }

      .error-visual {
        justify-items: start;
      }

      .error-code {
        width: auto;
        font-size: clamp(96px, 34vw, 176px);
        text-align: left;
      }

      .error-mark {
        width: min(180px, 50vw);
      }

      .error-content h1 {
        font-size: clamp(34px, 10vw, 54px);
      }

      .error-actions {
        display: grid;
        grid-template-columns: 1fr;
      }

      .error-actions .button {
        width: 100%;
      }
    }
  </style>

</BaseLayout>
