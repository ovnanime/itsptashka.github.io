---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { BOOK, chapterName as nameOf } from '../../../data/book';
import { PERSON_ID, absoluteUrl } from '../../../data/seo';
import pagesManifest from '../../../data/book/pages.json';

/**
 * Чтение главы на сайте: страницы PDF, заранее отрисованные в WebP
 * (npm run book:pages). Страница создаётся для каждой готовой главы.
 */
type PageInfo = { pages: number; width: number; height: number };
const manifest = pagesManifest as Record<string, PageInfo>;

export async function getStaticPaths() {
  const all = (await getCollection('bookChapters')).sort((a, b) => a.data.number - b.data.number);
  const ready = all.filter((ch) => ch.data.status === 'ready');

  return ready.map((chapter) => {
    const index = all.findIndex((ch) => ch.id === chapter.id);
    const next = all[index + 1];
    const prevReady = [...all.slice(0, index)].reverse().find((ch) => ch.data.status === 'ready');
    return { params: { id: chapter.id }, props: { chapter, prev: prevReady, next } };
  });
}

const { chapter, prev, next } = Astro.props;
const ch = chapter.data;
const info = manifest[chapter.id];

if (!info) {
  throw new Error(
    `Нет страниц для главы ${chapter.id}: запустите «npm run book:pages», чтобы отрисовать PDF в public/book/pages/${chapter.id}/`,
  );
}

const pages = Array.from({ length: info.pages }, (_, i) => `/book/pages/${chapter.id}/${String(i + 1).padStart(3, '0')}.webp`);
const chapterName = nameOf(ch);
const pdfName = `${BOOK.title} — ${chapterName}.pdf`;
const updated = ch.updated!;

const chapterSchema = {
  '@type': 'Chapter',
  '@id': `${absoluteUrl(`/book/read/${chapter.id}/`)}#chapter`,
  name: chapterName,
  position: ch.number,
  description: ch.description,
  version: ch.version,
  dateModified: updated.toISOString().slice(0, 10),
  inLanguage: 'ru-RU',
  author: { '@id': PERSON_ID },
  isPartOf: { '@id': `${absoluteUrl('/book/')}#book`, '@type': 'Book', name: BOOK.title },
  license: BOOK.license.url,
  isAccessibleForFree: true,
};
---

<BaseLayout
  title={`${chapterName} — ${BOOK.title}`}
  description={`${ch.description} Из книги «${BOOK.title}» — читать онлайн или скачать PDF.`}
  ogType="article"
  image={BOOK.ogImage.url}
  imageWidth={BOOK.ogImage.width}
  imageHeight={BOOK.ogImage.height}
  imageAlt={`Обложка книги «${BOOK.title}»`}
  modifiedTime={updated.toISOString()}
  schema={[chapterSchema]}
>
  <div class="reader-page">
    <div class="shell">
      <div class="reader-bar">
        <a class="reader-back" href="/book/">
          <span aria-hidden="true">←</span>
          <span class="reader-back-text">{BOOK.title}</span>
        </a>
        <a class="reader-pdf" href={ch.pdf} download={pdfName} aria-label={`Скачать PDF: ${chapterName}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11" /><path d="m7 10 5 5 5-5" /><path d="M5 20h14" /></svg>
          Скачать PDF
        </a>
      </div>

      <!-- Название и часть уже есть на первой странице главы — здесь только для поиска и экранных читалок -->
      <h1 class="visually-hidden">{chapterName}</h1>

      <div class="reader-pages">
        {
          pages.map((src, i) => (
            <img
              class="reader-sheet"
              src={src}
              width={info.width}
              height={info.height}
              alt={`${chapterName}, страница ${i + 1} из ${info.pages}`}
              loading={i < 2 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              decoding="async"
              data-no-image-viewer
            />
          ))
        }
      </div>

      <div class="reader-end">
        <nav class="reader-nav" aria-label="Главы книги">
          {
            prev ? (
              <a class="reader-nav-link" href={`/book/read/${prev.id}/`}>
                <small>← Назад</small>
                <b>{nameOf(prev.data)}</b>
              </a>
            ) : (
              <a class="reader-nav-link" href="/book/">
                <small>← К книге</small>
                <b>Оглавление</b>
              </a>
            )
          }
          {
            next &&
              (next.data.status === 'ready' ? (
                <a class="reader-nav-link reader-nav-link--next" href={`/book/read/${next.id}/`}>
                  <small>Дальше →</small>
                  <b>{nameOf(next.data)}</b>
                </a>
              ) : (
                <span class="reader-nav-link reader-nav-link--next reader-nav-link--soon">
                  <small>Дальше · скоро</small>
                  <b>{nameOf(next.data)}</b>
                </span>
              ))
          }
        </nav>

        <p class="reader-note">
          Нашли ошибку? Напишите в <a href={BOOK.feedback.telegram.href} target="_blank" rel="noopener noreferrer">Telegram</a>
          {' '}или на <a href={BOOK.feedback.email.href}>почту</a> — с номером главы и страницы.
          Лицензия <a href={BOOK.license.url} target="_blank" rel="license noopener noreferrer">{BOOK.license.name}</a>.
        </p>
      </div>
    </div>
  </div>

  <style>
    .reader-page {
      padding: 22px 0 24px;
    }

    /* Подвал ближе к содержимому: у сайта по умолчанию 64 px сверху */
    :global(body > footer.site-footer) {
      margin-top: 24px !important;
    }

    .reader-page,
    .reader-page * {
      font-family: Roboto, Arial, sans-serif;
    }

    .reader-page svg {
      fill: none;
      stroke: currentColor;
      stroke-width: 2.2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    /* Всё по ширине листа, чтобы кнопки стояли ровно над краями страницы */
    .reader-bar,
    .reader-pages,
    .reader-end {
      max-width: 900px;
      margin-inline: auto;
    }

    .reader-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 22px;
    }

    .reader-back {
      display: inline-flex;
      min-width: 0;
      align-items: center;
      gap: 10px;
      color: #b8b8b4;
      font-size: 15px;
      font-weight: 700;
      transition: color 0.16s ease;
    }

    .reader-back-text {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .reader-back:hover {
      color: #fff;
    }

    /* Белая кнопка — как «Читать с главы 1» на странице книги */
    .reader-pdf {
      display: inline-flex;
      flex: none;
      align-items: center;
      gap: 8px;
      height: 44px;
      padding: 0 18px;
      border: 1px solid #fff;
      border-radius: 12px;
      background: #fff;
      color: #050505;
      font-size: 15px;
      font-weight: 800;
      transition: background 0.18s ease, color 0.18s ease;
    }

    .reader-pdf svg {
      width: 18px;
      height: 18px;
    }

    .reader-pdf:hover,
    .reader-pdf:focus-visible {
      background: transparent;
      color: #fff;
    }

    .reader-pages {
      display: grid;
      gap: 22px;
    }

    .reader-sheet {
      width: 100%;
      height: auto;
      border-radius: 4px;
      background: #fff;
    }

    /* Низ: серая линия, затем переходы — просто текстом, без рамок */
    .reader-end {
      margin-top: 36px;
      padding-top: 22px;
      border-top: 1px solid var(--line);
    }

    .reader-nav {
      display: flex;
      justify-content: space-between;
      gap: 24px;
    }

    .reader-nav-link {
      display: grid;
      gap: 6px;
      min-width: 0;
    }

    .reader-nav-link small {
      color: var(--muted);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .reader-nav-link b {
      color: #fff;
      font-size: 18px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    a.reader-nav-link:hover b {
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .reader-nav-link--next {
      margin-left: auto;
      text-align: right;
    }

    .reader-nav-link--soon b {
      color: #6f6f6b;
    }

    /* Строка про ошибки — отдельно, заметно ниже переходов и тише их */
    .reader-page .reader-note {
      max-width: 560px;
      margin: 64px auto 0;
      color: #77776f;
      font-size: 13px;
      line-height: 1.6;
      text-align: center !important;
      hyphens: none !important;
    }

    .reader-note a {
      color: #b8b8b4;
      font-weight: 700;
      text-decoration: underline;
      text-decoration-color: rgba(255, 255, 255, 0.3);
      text-underline-offset: 3px;
    }

    @media (max-width: 760px) {
      .reader-page {
        padding-top: 16px;
      }

      .reader-bar {
        margin-bottom: 16px;
      }

      .reader-pdf {
        height: 40px;
        padding: 0 14px;
        font-size: 14px;
      }

      .reader-pages {
        gap: 14px;
      }

      /* «Назад» и «Дальше» — ровно в один ряд, длинные названия переносятся */
      .reader-nav {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 16px;
        align-items: start;
      }

      .reader-nav-link--next {
        grid-column: 2;
      }

      .reader-nav-link b {
        font-size: 16px;
      }

      .reader-page .reader-note {
        margin-top: 44px;
      }
    }
  </style>
</BaseLayout>
