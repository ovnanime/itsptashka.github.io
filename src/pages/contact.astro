---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactIntro from '../components/ContactIntro.astro';
import { CONTACTS } from '../data/site';
---

<BaseLayout
  title="Контакты — Феофилакт Птахен"
  description="Связаться с Феофилактом Птахеном по вопросам озвучивания, дубляжа, звукорежиссуры и локализации."
>
  <div class="contact-page" data-contact-page>
    <ContactIntro />

    <section class="shell contact-hero">
      <div class="contact-hero-copy">
        <p class="contact-label">Связаться</p>
        <h1>Написать по проекту.</h1>
        <p>
          Озвучивание, дубляж, закадр, звукорежиссура, локализация и рабочие
          вопросы по релизам. Без формы на сайте — просто выбери удобный способ
          связи.
        </p>
      </div>

      <a class="contact-resume" href="/resume-ilya-pushkin.pdf" download="Резюме — Илья Пушкин.pdf">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11" /><path d="m7 10 5 5 5-5" /><path d="M5 20h14" /></svg>
        Скачать резюме
        <small>PDF</small>
      </a>
    </section>

    <section class="shell contact-grid" aria-label="Способы связи">
      {CONTACTS.map((item) => {
        const external = item.href.startsWith('http');
        const kind = item.footerLabel === 'Telegram' ? 'tg' : item.footerLabel === 'VK' ? 'vk' : 'mail';
        return (
          <article class={`contact-card contact-card--${kind}`}>
            <span class="contact-card-mark" aria-hidden="true">
              {kind === 'tg' && (
                <svg viewBox="0 0 24 24"><path d="M21 4 3 11l6 2 2 6 3-4 4 3 3-14Z" /><path d="m9 13 8-6" /></svg>
              )}
              {kind === 'vk' && <b>VK</b>}
              {kind === 'mail' && (
                <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
              )}
            </span>

            <div class="contact-card-body">
              <span>{item.label}</span>
              <h2>{item.value}</h2>
              <p>{item.text}</p>
            </div>

            <div class="contact-card-actions">
              <a
                class="contact-card-open"
                href={item.href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                {kind === 'mail' ? 'Написать письмо' : 'Открыть чат'}
                <span aria-hidden="true">↗</span>
              </a>
              <button class="contact-card-copy" type="button" data-copy={item.value} aria-label={`Скопировать ${item.value}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></svg>
                <span data-copy-label>Копировать</span>
              </button>
            </div>
          </article>
        );
      })}
    </section>
  </div>

  <script is:inline data-astro-rerun>
    (() => {
      const copyText = async (text) => {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          // Запасной путь для браузеров, где Clipboard API недоступен.
          const area = document.createElement('textarea');
          area.value = text;
          area.setAttribute('readonly', '');
          area.style.cssText = 'position:fixed;opacity:0';
          document.body.appendChild(area);
          area.select();
          const ok = document.execCommand('copy');
          area.remove();
          return ok;
        }
      };

      document.querySelectorAll('.contact-card [data-copy]').forEach((button) => {
        const label = button.querySelector('[data-copy-label]');
        let timer = null;
        button.addEventListener('click', async () => {
          const ok = await copyText(button.dataset.copy || '');
          if (!label) return;
          label.textContent = ok ? 'Скопировано' : 'Не вышло';
          button.classList.toggle('is-done', ok);
          clearTimeout(timer);
          timer = setTimeout(() => {
            label.textContent = 'Копировать';
            button.classList.remove('is-done');
          }, 1600);
        });
      });
    })();
  </script>

  <style>

    :global(html),
    :global(body) {
      min-height: 100%;
    }

    :global(body) {
      display: flex;
      min-height: 100dvh;
      flex-direction: column;
    }

    :global(body > header.site-header) {
      flex-shrink: 0;
    }

    :global(body > main),
    :global(body > .contact-page) {
      flex: 1 0 auto;
    }

    :global(body > footer.site-footer) {
      flex-shrink: 0;
      margin-top: auto !important;
    }

    .contact-page {
      position: relative;
      padding: 34px 0 0;
    }

    .contact-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
      align-items: stretch;
      min-height: 0 !important;
      margin-top: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 18px;
      border-bottom: 1px solid var(--line);
    }

    .contact-hero-copy {
      display: flex;
      max-width: 760px;
      min-height: 0 !important;
      flex-direction: column;
      justify-content: center;
      margin-top: 0 !important;
      padding-top: 0 !important;
    }

    .contact-hero.shell {
      margin-top: 0 !important;
      padding-top: 0 !important;
    }

    .contact-label,
    .contact-card span {
      display: block;
      margin: 0 0 10px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .contact-hero .contact-label {
      font-size: 14px;
      letter-spacing: 0.18em;
      margin-bottom: 14px;
    }

    .contact-hero h1 {
      max-width: 760px;
      margin: 0 0 12px;
      color: var(--text);
      font-size: 36px;
      line-height: 1.08;
      font-weight: 900;
      letter-spacing: -0.045em;
    }

    .contact-hero-copy > p:last-child {
      max-width: 720px;
      margin: 0;
      color: var(--muted);
      font-size: 18px;
      line-height: 1.5;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      padding-top: 22px;
      padding-bottom: 0;
    }

    .contact-card {
      position: relative;
      display: flex;
      min-height: 220px;
      flex-direction: column;
      justify-content: space-between;
      padding: 22px;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: #101010;
      color: inherit;
      text-decoration: none;
      transition:
        border-color 0.18s ease,
        background 0.18s ease,
        transform 0.18s ease;
    }

    .contact-card::before {
      content: '';
      position: absolute;
      inset: -1px;
      z-index: 0;
      background:
        radial-gradient(circle at 100% 0%, rgba(255,255,255,0.07), transparent 32%),
        linear-gradient(135deg, rgba(255,255,255,0.035), transparent 46%);
      opacity: 0;
      transition: opacity 0.18s ease;
    }

    .contact-card > * {
      position: relative;
      z-index: 1;
    }

    .contact-card h2 {
      margin: 0 0 12px;
      color: var(--text);
      font-size: 30px;
      line-height: 1.06;
      font-weight: 900;
      letter-spacing: -0.045em;
      overflow-wrap: anywhere;
    }

    .contact-card p {
      max-width: 320px;
      margin: 0;
      color: var(--muted);
      font-size: 18px;
      line-height: 1.42;
    }

    .contact-card:hover {
      border-color: rgba(255,255,255,0.22);
      background: #121212;
      transform: translateY(-2px);
    }

    .contact-card:hover::before {
      opacity: 1;
    }

    @media (max-width: 900px) {
      .contact-hero,
      .contact-grid {
        grid-template-columns: 1fr;
      }

      .contact-card {
        min-height: 180px;
      }
    }

    @media (max-width: 640px) {
      .contact-page {
        padding: 30px 0 0;
      }

      .contact-hero h1 {
        font-size: 36px;
      }

      .contact-hero-copy > p:last-child {
        font-size: 17px;
      }

      .contact-card {
        min-height: 160px;
        padding: 18px;
      }

      .contact-card h2 {
        font-size: 24px;
      }

      .contact-card p {
        font-size: 16px;
      }
    }

    /* Unified top typography override */
    .contact-page {
      padding-top: 34px !important;
    }

    .contact-hero .contact-label {
      margin: 0 0 14px !important;
      color: var(--muted) !important;
      font-size: 14px !important;
      line-height: 1.2 !important;
      font-weight: 800 !important;
      letter-spacing: 0.18em !important;
      text-transform: uppercase !important;
      font-family: Roboto, Arial, sans-serif !important;
    }

    .contact-hero h1 {
      font-family: Roboto, Arial, sans-serif !important;
      font-size: 36px !important;
      line-height: 1.08 !important;
      font-weight: 900 !important;
      letter-spacing: -0.045em !important;
      margin: 0 0 14px !important;
    }

    /* ---------- Карточки: у каждой свой оттенок и крупный знак на фоне ---------- */
    .contact-card {
      --accent: 255, 255, 255;
      cursor: default;
    }

    /* Кнопка резюме справа, в пустом месте шапки */
    @media (min-width: 901px) {
      .contact-hero {
        grid-template-columns: minmax(0, 1fr) auto !important;
        align-items: center !important;
        column-gap: 40px;
      }

      .contact-hero .contact-resume {
        justify-self: end;
      }
    }

    /* Ссылка на резюме */    /* Ссылка на резюме рядом с заголовком */
    .contact-resume {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      justify-self: start;
      padding: 14px 22px;
      border: 1px solid rgba(255, 255, 255, 0.32);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.07);
      color: var(--text);
      font-size: 17px;
      font-weight: 800;
      text-decoration: none;
      transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
    }

    .contact-resume:hover,
    .contact-resume:focus-visible {
      border-color: rgba(255, 255, 255, 0.6);
      background: rgba(255, 255, 255, 0.12);
      transform: translateY(-1px);
    }

    .contact-resume svg {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2.2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .contact-resume small {
      padding: 3px 7px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.1);
      color: var(--muted);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.1em;
    }

    /* Карточки повыше: текст сверху, кнопки внизу */
    @media (min-width: 901px) {
      .contact-grid .contact-card {
        min-height: 300px !important;
        padding: 28px !important;
      }
    }

    .contact-card--tg {
      --accent: 42, 171, 238;
    }

    .contact-card--vk {
      --accent: 0, 119, 255;
    }

    .contact-card--mail {
      --accent: 235, 235, 235;
    }

    .contact-card::before {
      background:
        radial-gradient(circle at 100% 0%, rgba(var(--accent), 0.22), transparent 45%),
        linear-gradient(135deg, rgba(var(--accent), 0.06), transparent 55%) !important;
    }

    .contact-card .contact-card-mark {
      position: absolute !important;
      top: -18px;
      right: -14px;
      z-index: 0 !important;
      display: grid !important;
      place-items: center;
      width: 170px;
      height: 170px;
      margin: 0 !important;
      color: rgba(var(--accent), 0.07) !important;
      letter-spacing: 0 !important;
      text-transform: none !important;
      transition: color 0.3s ease, transform 0.3s ease;
      pointer-events: none;
    }

    .contact-card-mark svg {
      width: 150px;
      height: 150px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.4;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .contact-card-mark b {
      font-size: 96px;
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.06em;
    }

    .contact-card:hover .contact-card-mark {
      color: rgba(var(--accent), 0.16) !important;
      transform: rotate(-6deg) scale(1.04);
    }

    .contact-card:hover {
      border-color: rgba(var(--accent), 0.45) !important;
    }

    .contact-card-body {
      position: relative;
      z-index: 1;
    }

    .contact-card-actions {
      position: relative;
      z-index: 1;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 22px;
    }

    .contact-card-open,
    .contact-card-copy {
      display: inline-flex !important;
      align-items: center;
      gap: 8px;
      height: 42px;
      margin: 0 !important;
      padding: 0 14px;
      border-radius: 11px;
      font: inherit;
      font-size: 14px !important;
      font-weight: 800 !important;
      letter-spacing: 0 !important;
      text-transform: none !important;
      cursor: pointer;
      transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
    }

    .contact-card-open {
      border: 1px solid #fff;
      background: #fff;
      color: #050505 !important;
      text-decoration: none;
    }

    .contact-card-open:hover,
    .contact-card-open:focus-visible {
      border-color: rgb(var(--accent));
      background: rgb(var(--accent));
      color: #fff !important;
    }

    .contact-card--mail .contact-card-open:hover,
    .contact-card--mail .contact-card-open:focus-visible {
      color: #050505 !important;
    }

    .contact-card-copy {
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: transparent;
      color: var(--text) !important;
    }

    .contact-card-copy svg {
      width: 17px;
      height: 17px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .contact-card-copy span {
      margin: 0 !important;
      color: inherit !important;
      font-size: inherit !important;
      letter-spacing: 0 !important;
      text-transform: none !important;
    }

    .contact-card-copy:hover {
      border-color: rgba(255, 255, 255, 0.4);
    }

    .contact-card-copy.is-done {
      border-color: rgba(61, 220, 132, 0.6);
      background: rgba(61, 220, 132, 0.12);
      color: #7ee2a8 !important;
    }

    @media (prefers-reduced-motion: reduce) {

      .contact-card-mark {
        transition: none;
      }
    }
  </style>
</BaseLayout>
